<script>
import storage from '@system.storage'
import vibrator from '@system.vibrator'
import device from '@system.device'
import router from '@system.router'
import calc from '../../common/calc'
import calc2 from '../../common/calc2'
import { keyMatches, normalizeDeviceId, shortCodeForDevice } from '../../common/paykey'

function coeffSrc(s) {
  let t = String(s).replace(/−/g, '-')
  t = t.replace(/√(?!\()/g, '√(')
  t = t.replace(/([0-9.)πe])(?=[√πe(])/g, '$1*')
  t = t.replace(/([πe)])(?=[0-9])/g, '$1*')
  let open = 0
  for (const ch of t) { if (ch === '(') open++; else if (ch === ')') open-- }
  while (open > 0) { t += ')'; open-- }
  return t
}
function parseCoeff(s) {
  if (s === '' || s === '-') return NaN
  // 2026-11-15 第十六轮复审：快路径（parseFloat）会把超安全整数静默舍
  // 入——9007199254740993 → 9007199254740992，一次方程因此误判无解；而
  // evaluate 对这类字面量抛 precision。守卫只拦「有效数字超过 15 位、
  // 量级又在 1e21 以内」的数字段（全应用整数精确口径的范围）：纯数字/
  // 分数落到 evaluate 统一判定；科学计数法把尾数展开成整数串与读数
  // 逐字比对，对不上即 NaN。≥1e21 是既定的浮点近似区（1.5.20 钉死：
  // 系数 1 后跟 200 个 0 照常出根），不拦。
  const digitsOf = function (t) { return t.replace(/[-.]/g, '').replace(/^0+/, '') }
  const needsCheck = function (t) { return digitsOf(t).length > 15 && Math.abs(parseFloat(t)) < 1e21 }
  // 2026-11-15 自查 F11：整串就是科学计数法时按科学计数法读（1e21 → 10²¹），
  // 与主键盘 evaluate 的分词口径一致。'2e'（2×e）、'e2'（e×2）仍走欧拉
  // 读法（regression-1.6.0 §1d 钉死）；带运算符的长式子也不动。
  if (/^-?(\d+(\.\d*)?|\.\d+)e[+-]?\d+$/i.test(s)) {
    // 2026-11-15 第十八轮复审：旧门只看尾数有效数字——1.23456789012345e17
    // 尾数恰 15 位就放行，展开成 18 位整数后精度全灭（evaluate 对同一
    // 字面量抛 precision、页面却照常出根）。改与 evaluate 的 intDigitsOf
    // 完全同口径：按指数展开取整数位串，≥16 位必须与双精度读数逐字相
    // 等；移位后仍带小数的（真分数）不设门；展开超 21 位属 ≥1e21 的既
    // 定近似区、不设门。
    const v = parseFloat(s)
    if (Math.abs(v) >= 1e21) return v
    const mant = s.split(/e/i)[0]
    const neg = mant.charAt(0) === '-'
    const md = neg ? mant.slice(1) : mant
    const dot = md.indexOf('.')
    const intPart = dot >= 0 ? md.slice(0, dot) : md
    const fracPart = dot >= 0 ? md.slice(dot + 1) : ''
    const raw = intPart + fracPart
    if (/^0+$/.test(raw)) return v
    const point = intPart.length + parseInt(s.split(/e/i)[1], 10)
    if (point <= 0) return v
    let digs
    if (point >= raw.length) digs = raw + '0'.repeat(point - raw.length)
    else {
      if (!/^0*$/.test(raw.slice(point))) return v
      digs = raw.slice(0, point)
    }
    digs = digs.replace(/^0+/, '') || '0'
    if (digs.length > 21 || digs.length < 16) return v
    if (typeof BigInt === 'function') { try { if (BigInt(digs) !== BigInt(Math.abs(v))) return NaN } catch (e) { return NaN } }
    else if (Math.abs(v).toFixed(0) !== digs) return NaN
    return v
  }
  if (/^-?(\d+(\.\d*)?|\.\d+)(\/\d+(\.\d*)?|\/\.\d+)?$/.test(s) && !s.split('/').some(needsCheck)) {
    if (s.indexOf('/') >= 0) {
      const p = s.split('/')
      if (p.length !== 2) return NaN
      const n = parseFloat(p[0]), d = parseFloat(p[1])
      if (isNaN(n) || isNaN(d) || d === 0) return NaN
      return n / d
    }
    return parseFloat(s)
  }
  try {
    const v = calc.evaluate(coeffSrc(s))
    return isFinite(v) ? v : NaN
  } catch (e) { return NaN }
}
function parseCoeff0(s) { return s === '' ? 0 : parseCoeff(s) }

function parseOpt(s) { return s === '' ? null : parseCoeff(s) }
function editCoeff(cur, v) {
  if (v === 'C') return ''
  if (v === 'back') return cur.slice(0, -1)
  // 2026-11-15 自查 C4：± 只在“加号”时受 20 字上限拦，解负号（变短）不拦。
  if (v === 'neg') {
    if (cur.indexOf('-') === 0) return cur.slice(1)
    if (cur.length >= 20) return cur
    return '-' + cur
  }
  if (v === 'ok' || v === 'ok2') return 'NEXT'
  const last = cur.slice(-1)
  if (v === 'sqrt') return cur.length >= 19 ? cur : cur + '√('
  if (v === 'pi') return cur.length >= 20 ? cur : cur + 'π'
  if (v === 'e') return cur.length >= 20 ? cur : cur + 'e'
  if (v === ')') return cur.length >= 20 ? cur : cur + ')'
  // 2026-11-15 系数键盘扩键（用户拍板按外部复审建议）：+、−、×、( 四键。
  // 运算符顶替规则与方程键盘同口径；'(' 在操作数后自动补 ×(（隐含乘法）；
  // 未闭合括号由 coeffSrc 解析时自动补齐，√( 与 ( 共用这条路。
  if (v === '+') {
    if (cur === '' || cur === '-' || last === '(' || last === '/' || last === '+') return cur
    if (last === '-') {
      const prev = cur.charAt(cur.length - 2)
      if (prev === '(' || prev === '') return cur
      return cur.slice(0, -1) + '+'
    }
    if (cur.length >= 20) return cur
    return cur + '+'
  }
  if (v === '−') {
    if (last === '-') return cur
    if (cur.length >= 20) return cur
    if (last === '+') return cur.slice(0, -1) + '-'
    return cur + '-'
  }
  if (v === '×') {
    if (cur === '' || cur === '-' || last === '(' || last === '/' || last === '×') return cur
    if (last === '-') {
      const prev = cur.charAt(cur.length - 2)
      if (prev === '(' || prev === '') return cur
      return cur.slice(0, -1) + '×'
    }
    if (cur.length >= 20) return cur
    if (last === '+') return cur.slice(0, -1) + '×'
    return cur + '×'
  }
  if (v === '(') {
    if (cur.length >= 20) return cur
    if (last && /[0-9.)πe]/.test(last)) return cur.length + 2 > 20 ? cur : cur + '×('
    return cur + '('
  }
  if (v === '/') {
    if (cur === '' || cur === '-' || last === '/' || last === '(') return cur
    if (cur.indexOf('(') < 0 && cur.indexOf('/') >= 0) return cur
    // 2026-11-15 自查 C4：'/' 也按追加后总长查 20 字上限。
    if (cur.length >= 20) return cur
    return cur + '/'
  }
  if (v === '.') {
    if (last === ')' || last === 'π' || last === 'e') return cur
    // 2026-11-15 自查 C4：'.' 也按追加后总长查 20 字上限。
    if (cur.length >= 20) return cur
    if (cur.indexOf('(') < 0 && (cur.indexOf('.') >= 0 || cur.indexOf('/') >= 0)) return cur
    let seg = ''
    for (let i = cur.length - 1; i >= 0; i--) {
      const ch = cur[i]
      if ((ch >= '0' && ch <= '9') || ch === '.') seg = ch + seg
      else break
    }
    if (seg.indexOf('.') >= 0) return cur
    if (cur === '' || cur === '-' || last === '/' || last === '(') return cur + '0.'
    return cur + '.'
  }
  if (cur === '0') return v === '0' ? cur : v
  if (cur === '-0') return v === '0' ? cur : '-' + v
  let seg = ''
  for (let i = cur.length - 1; i >= 0; i--) {
    const ch = cur[i]
    if ((ch >= '0' && ch <= '9') || ch === '.') seg = ch + seg
    else break
  }
  if (seg === '0' && v !== '0') return cur.slice(0, -1) + v
  // 2026-11-15 自查 C4：按追加后总长查上限（'00' 一次进两位也拦得住）。
  if (cur.length + v.length > 20) return cur
  return cur + v
}

function gcd2(a, b) { a = Math.abs(a); b = Math.abs(b); while (b) { const t = a % b; a = b; b = t } return a }
function FD(x) { return calc.formatDisplay(x) }
// 三角工具专用显示（1.6.0）：角度按学校口径保留两位小数去尾零；边长精确形
// （整数 / 分数 / 根式）优先并带小数兜底，与全应用双显口径一致。
function fmtDeg(v) {
  let s = (Math.round(v * 100) / 100).toFixed(2)
  if (s.indexOf('.') >= 0) s = s.replace(/0+$/, '').replace(/\.$/, '')
  return s
}
function angSeg(v) {
  // 2026-11-15 第十八轮复审：极小非零角被 fmtDeg 的两位小数吞成 0、
  // 又被 1e-9 绝对容差标成「= 0°」（引擎明明算出 5.73e-15°）。小于
  // 0.005° 的非零角改走 formatDisplay 的科学计数法显示并标 ≈。
  if (v !== 0 && Math.abs(v) < 0.005) return '≈ ' + FD(v) + '°'
  const s = fmtDeg(v)
  return (Math.abs(v - parseFloat(s)) < 1e-9 ? '= ' : '≈ ') + s + '°'
}
function fmtSide(v) {
  const f = calc.toFraction(v)
  // 2026-11-15 第十六轮复审：d===1 的「整数」也必须过 fracIsExact——
  // toFraction 的连分容差会把 2.00000000001 收成整数 2 冒充精确。
  if (f && (f.d !== 1 || calc.fracIsExact(v, f))) {
    const s = f.d === 1 ? intTxt(f.n) : intTxt(f.n) + '/' + f.d
    // 整数不再缀小数（FD 的千分位写法会让同一数变成两种样子）
    // 2026-11-15 自查 F5：分数与小数之间的连接号按是否精确选 = / ≈，
    // 不再硬编码 ≈（1/512、1023/512、5/2 这类精确分数应为 =）。
    return { t: f.d === 1 ? s : s + (calc.fracIsExact(v, f) ? ' = ' : ' ≈ ') + FD(f.n / f.d), exact: true }
  }
  const f2 = calc.toFraction(v * v)
  // 2026-11-15 第十六轮复审：根式分支也要验精确——v² 的近似分数（如
  // 边 1.00000000001 的斜边平方 ≈ 2.00000000003）不许化成 √2 冒充精确
  // 根式。判定不用 fracIsExact：它的 d===1 分支只认双精度全等，而真
  // √2 的平方是 2.0000000000000004（1 ulp 计算误差）必然误杀；这里用
  // F3 的 12 位口径（分数值与 v² 在 12 位有效数字下相等才算精确）。
  const vv = v * v
  if (f2 && f2.n > 0 && (f2.n / f2.d === vv || parseFloat((f2.n / f2.d).toPrecision(12)) === calc.cleanNum(vv))) {
    const sq = calc.simplifySqrt(f2.n * f2.d)
    if (!sq.error && sq.rad !== 1) {
      let cn = sq.coef, cd = f2.d
      const g = gcd2(cn, cd) || 1
      cn /= g; cd /= g
      const s = (cn === 1 ? '' : cn) + '√' + sq.rad + (cd === 1 ? '' : '/' + cd)
      if (s.length <= 14) return { t: s + ' ≈ ' + FD(v), exact: true }
    }
  }
  return { t: FD(v), exact: false }
}
// 2026-11-15 第十六轮复审：fmtVal 改回 {t, exact} 结构（与 fmtSide
// 一致）——旧版回裸字符串、sqSolve 无条件拼「=」，把舍入小数（如等比
// 数列 Sn = 4.41421356237）标成精确等号；且 d===1 分支不查精确性，
// 2.00000000001 会被显示成整数 2。exact=false 时调用方必须用 ≈。
function fmtVal(v) {
  const f = calc.toFraction(v)
  if (f && (f.d !== 1 || calc.fracIsExact(v, f))) {
    const s = f.d === 1 ? intTxt(f.n) : intTxt(f.n) + '/' + f.d
    // 2026-11-15 自查 F5：同 fmtSide，精确分数用 =（见上）。
    return { t: f.d === 1 ? s : s + (calc.fracIsExact(v, f) ? ' = ' : ' ≈ ') + FD(f.n / f.d), exact: true }
  }
  return { t: FD(v), exact: false }
}
// 2026-11-15 自查 F6：整数 < 1e21 保持无逗号原样；≥1e21 时 JS 的 String 会
// 漏出原始 e 记法（如 1.7179250691067045e+47），改走 12 位课本式 ×10 上标。
function intTxt(n) { return Math.abs(n) < 1e21 ? String(n) : FD(parseFloat(n.toPrecision(12))) }

// 向量 / 复数分量专用：只给单一形式（精确分数优先、否则小数），不带
// fmtVal 的「分数 = 小数」双显后缀——分量挤在括号里，双显会撑爆行宽。
function fmtPartE(v) {
  const f = calc.toFraction(v)
  if (f && (f.d !== 1 || calc.fracIsExact(v, f))) return { t: f.d === 1 ? intTxt(f.n) : intTxt(f.n) + '/' + f.d, exact: true }
  return { t: FD(v), exact: false }
}
// 短显版（向量 / 复数把两个模长并一行时用）：精确分数优先，否则
// 6 位有效数字——模长并行显示时长小数会撑爆行宽。
function fmtShortE(v) {
  const f = calc.toFraction(v)
  if (f && (f.d !== 1 || calc.fracIsExact(v, f))) return { t: f.d === 1 ? intTxt(f.n) : intTxt(f.n) + '/' + f.d, exact: true }
  return { t: FD(parseFloat(v.toPrecision(6))), exact: false }
}
function fmtVecE(arr) {
  let exact = true
  const parts = arr.map(function (v) { const p = fmtPartE(v); if (!p.exact) exact = false; return p.t })
  return { t: '(' + parts.join(', ') + ')', exact: exact }
}
function fmtCplxE(re, im) {
  if (re === 0 && im === 0) return { t: '0', exact: true }
  const fr = fmtPartE(re), fi = fmtPartE(Math.abs(im))
  let t = ''
  if (re !== 0) t = fr.t
  if (im !== 0) {
    const part = (Math.abs(im) === 1 ? '' : fi.t) + 'i'
    t = t === '' ? (im < 0 ? '-' + part : part) : t + (im < 0 ? ' − ' : ' + ') + part
  }
  if (t === '') t = fr.t
  return { t: t, exact: fr.exact && fi.exact }
}

function fvPxOf(vals, tight) {
  let m = 0
  for (const v of vals) m = Math.max(m, String(v === null || v === undefined ? '' : v).length)
  if (tight) return m <= 5 ? 20 : (m <= 7 ? 16 : 12)
  return m <= 6 ? 20 : (m <= 8 ? 17 : 15)
}

const QUAD_KEYS = [
  { v: '7', label: '7' }, { v: '8', label: '8' }, { v: '9', label: '9' }, { v: 'back', label: '←' }, { v: 'C', label: 'C' },
  { v: '4', label: '4' }, { v: '5', label: '5' }, { v: '6', label: '6' }, { v: '+', label: '+' }, { v: '−', label: '−' },
  { v: '1', label: '1' }, { v: '2', label: '2' }, { v: '3', label: '3' }, { v: '×', label: '×' }, { v: 'sqrt', label: '√' },
  { v: '(', label: '(' }, { v: ')', label: ')' }, { v: 'pi', label: 'π' }, { v: 'e', label: 'e' }, { v: '/', label: '/' },
  { v: '0', label: '0' }, { v: '.', label: '.' }, { v: 'neg', label: '±' }, { v: 'ok', label: '»', kcls: 'key-c5w' }
]

