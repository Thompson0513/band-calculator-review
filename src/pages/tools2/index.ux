      { id: 'data', name: '数据' }
    ],
    stSampLines: ['样本方差 要 2 个以上数据'],
    // —— 2026-11-15 新增四工具：分布列 / 向量 / 复数 / 韦达弦长 ——
    dtTab: 'res',
    dtTabChips: [
      { id: 'res', name: '结果' },
      { id: 'data', name: '数据' }
    ],
    dtX: '', dtP: '', dtField: 'x', dtPairs: [],
    dtLines: ['输取值 x 和概率 p，点 » 加一组', '全部加完，概率之和要正好是 1'],
    dtRows: ['还没有数据'],
    dtFvPx: 25,
    vcDim: 3, vcField: 'a1',
    vcVals: { a1: '1', a2: '2', a3: '3', b1: '4', b2: '5', b3: '6' },
    vcLines: [], vcFvPx: 25,
    cxField: 'a',
    cxVals: { a: '1', b: '2', c: '3', d: '4' },
    cxLines: [], cxFvPx: 25,
    vtField: 'a',
    vtVals: { a: '1', b: '-3', c: '2', k: '1' },
    vtLines: [], vtFvPx: 25,
    vcFieldDefs1: [
      { key: 'a1', label: 'a1', val: '1' }, { key: 'a2', label: 'a2', val: '2' }, { key: 'a3', label: 'a3', val: '3' }
    ],
    vcFieldDefs2: [
      { key: 'b1', label: 'b1', val: '4' }, { key: 'b2', label: 'b2', val: '5' }, { key: 'b3', label: 'b3', val: '6' }
    ],
    cxFieldDefs1: [
      { key: 'a', label: 'a', val: '1' }, { key: 'b', label: 'b', val: '2' }
    ],
    cxFieldDefs2: [
      { key: 'c', label: 'c', val: '3' }, { key: 'd', label: 'd', val: '4' }
    ],
    vtFieldDefs1: [
      { key: 'a', label: 'a', val: '1' }, { key: 'b', label: 'b', val: '-3' }, { key: 'c', label: 'c', val: '2' }
    ],
    rtFieldDefs1: [
      { key: 'a', label: 'a', val: '3' }, { key: 'b', label: 'b', val: '4' }, { key: 'c', label: 'c', val: '' }
    ],
    rtFieldDefs2: [
      { key: 'A', label: 'A', val: '' }, { key: 'B', label: 'B', val: '' }, { key: 'C90', label: 'C', val: '90°' }
    ],
    lwFieldDefs1: [
      { key: 'a', label: 'a', val: '3' }, { key: 'b', label: 'b', val: '4' }, { key: 'c', label: 'c', val: '5' }
    ],
    lwFieldDefs2: [
      { key: 'A', label: 'A', val: '' }, { key: 'B', label: 'B', val: '' }, { key: 'C', label: 'C', val: '' }
    ],
    pmFieldDefs: [
      { key: 'n', label: 'n', val: '5' }, { key: 'r', label: 'r', val: '2' }
    ],
    sqFieldDefs: [
      { key: 'a1', label: 'a1', val: '1' }, { key: 'x', label: 'd', val: '2' }, { key: 'n', label: 'n', val: '10' }
    ]
  },
  onInit() {
    // 目标工具优先走路由参数：参数在页面创建时同步注入，首帧即直达，
    // 不闪本页菜单（2026-11-15 真机反馈修复）。下面的存储读是参数缺失时的兜底。
    // 2026-11-15 第十六轮复审：参数有效时完全跳过存储读——旧写法无条件
    // 读，存储里若残留旧值会把参数指定的页面覆盖掉（异步竞态）。
    const paramTool = this.tool === 'rtri' || this.tool === 'law' || this.tool === 'perm' || this.tool === 'seq' || this.tool === 'stats' || this.tool === 'dist' || this.tool === 'vec' || this.tool === 'cplx' || this.tool === 'vieta'
    if (paramTool) this.view = this.tool
    this.fetchDeviceId()
    const self = this
    if (!paramTool) try {
      storage.get({
        key: 'calc_tool_nav',
        success: function (data) {
          if (data === 'rtri' || data === 'law' || data === 'perm' || data === 'seq' || data === 'stats' || data === 'dist' || data === 'vec' || data === 'cplx' || data === 'vieta') self.view = data
          try { storage.set({ key: 'calc_tool_nav', value: '' }) } catch (e) {}
        },
        fail: function () {}
      })
    } catch (e) {}
    this.rtSolve()
    this.lwSolve()
    this.pmSolve()
    this.sqSolve()
    this.stSolve()
    this.dtSolve()
    this.vcSyncFields()
    this.vcSolve()
    this.cxSyncFields()
    this.cxSolve()
    this.vtSyncFields()
    this.vtSolve()
  },
  onBackPress() {
    if (this.view === 'menu' || this.view === 'locked') return false
    this.goBackTools()
    return true
  },
  buzz() {
    try { vibrator.vibrate({ mode: 'short' }) } catch (e) {}
  },
  goMenu() { this.buzz(); this.view = 'menu' },
  goBackMain() { this.buzz(); router.replace({ uri: '/pages/index' }) },
  goBackTools() {
    this.buzz()
    try { storage.set({ key: 'calc_back_to', value: 'tools' }) } catch (e) {}
    // 回程目标走路由参数同步传（首帧直达工具箱、不闪计算器主页）；存储键保留作兜底。
    router.replace({ uri: '/pages/index', params: { backto: 'tools' } })
  },
  openTool2(id) {
    this.buzz()
    if (!this.unlocked) { this.view = 'locked'; return }
    this.view = id
  },
  fetchDeviceId() {
    const self = this
    const fallback = function () {
      try {
        storage.get({
          key: 'calc_devcode',
          success: function (data) {
            if (data && normalizeDeviceId(data).length === 32) {
              self.deviceId = normalizeDeviceId(data)
              self.checkStoredKey()
            } else {
              let c = ''
              const hex = '0123456789abcdef'
              for (let i = 0; i < 32; i++) c += hex[Math.floor(Math.random() * 16)]
              self.deviceId = c
              try { storage.set({ key: 'calc_devcode', value: c }) } catch (e) {}
              self.checkStoredKey()
            }
          },
          fail: function () {}
        })
      } catch (e) {}
    }
    try {
      device.getDeviceId({
        success: function (res) {
          const id = normalizeDeviceId(res && res.deviceId ? res.deviceId : '')
          if (id.length === 32) {
            self.deviceId = id
            self.checkStoredKey()
          } else fallback()
        },
        fail: function () { fallback() }
      })
    } catch (e) { fallback() }
  },
  checkStoredKey() {
    const self = this
    try {
      storage.get({
        key: 'calc_key',
        success: function (data) {
          if (data && self.deviceId && keyMatches(self.deviceId, data)) self.unlocked = true
        },
        fail: function () {}
      })
    } catch (e) {}
  },
  setRtField(f) { this.buzz(); if (f !== 'C90') this.rtField = f },
  syncRtFields() {
    this.rtFieldDefs1 = [
      { key: 'a', label: 'a', val: this.rta }, { key: 'b', label: 'b', val: this.rtb }, { key: 'c', label: 'c', val: this.rtc }
    ]
    this.rtFieldDefs2 = [
      { key: 'A', label: 'A', val: this.rtA }, { key: 'B', label: 'B', val: this.rtB }, { key: 'C90', label: 'C', val: '90°' }
    ]
  },
  rtSolve() {
    this.syncRtFields()
    this.rtFvPx = fvPxOf([this.rta, this.rtb, this.rtc, this.rtA, this.rtB], true)
    const raw = { a: this.rta, b: this.rtb, c: this.rtc, A: this.rtA, B: this.rtB }
    const k = {}
    for (const key of ['a', 'b', 'c', 'A', 'B']) {
      const v = parseOpt(raw[key])
      if (v !== null && isNaN(v)) { this.rtLines = ['有格子里的数不对']; return }
      k[key] = v
    }
    const r = calc2.solveRightTri(k)
    if (r.error) { this.rtLines = [r.error]; return }
    const lines = []
    for (const s of ['a', 'b', 'c']) {
      if (k[s] === null) { const f = fmtSide(r[s]); lines.push(s + ' ' + (f.exact ? '= ' : '≈ ') + f.t) }
    }
    const ang = []
    if (k.A === null) ang.push('A ' + angSeg(r.A))
    if (k.B === null) ang.push('B ' + angSeg(r.B))
    if (ang.length) lines.push(ang.join(' · '))
    this.rtLines = lines.length ? lines : ['都对得上，没有要解的']
  },
  rtPad(v) {
    this.buzz()
    const props = { a: 'rta', b: 'rtb', c: 'rtc', A: 'rtA', B: 'rtB' }
    const prop = props[this.rtField]
    const r = editCoeff(this[prop], v)
    if (r === 'NEXT') {
      const order = ['a', 'b', 'c', 'A', 'B']
      this.rtField = order[(order.indexOf(this.rtField) + 1) % 5]
      return
    }
    this[prop] = r
    this.rtSolve()
  },

  setLwField(f) { this.buzz(); this.lwField = f },
  syncLwFields() {
    this.lwFieldDefs1 = [
      { key: 'a', label: 'a', val: this.lwa }, { key: 'b', label: 'b', val: this.lwb }, { key: 'c', label: 'c', val: this.lwc }
    ]
    this.lwFieldDefs2 = [
      { key: 'A', label: 'A', val: this.lwA }, { key: 'B', label: 'B', val: this.lwB }, { key: 'C', label: 'C', val: this.lwC }
    ]
  },
  lwSolve() {
    this.syncLwFields()
    this.lwFvPx = fvPxOf([this.lwa, this.lwb, this.lwc, this.lwA, this.lwB, this.lwC], true)
    const raw = { a: this.lwa, b: this.lwb, c: this.lwc, A: this.lwA, B: this.lwB, C: this.lwC }
    const k = {}
    for (const key of ['a', 'b', 'c', 'A', 'B', 'C']) {
      const v = parseOpt(raw[key])
      if (v !== null && isNaN(v)) { this.lwLines = ['有格子里的数不对']; return }
      k[key] = v
    }
    const r = calc2.solveTriangle(k)
    if (r.error) { this.lwLines = [r.error]; return }
    const lines = []
    r.solutions.forEach((sol, idx) => {
      const tag = r.solutions.length > 1 ? ('解' + '一二'[idx] + '：') : ''
      let tagged = false
      for (const s of ['a', 'b', 'c']) {
        if (k[s] === null) { const f = fmtSide(sol[s]); lines.push((tagged ? '' : tag) + s + ' ' + (f.exact ? '= ' : '≈ ') + f.t); tagged = true }
      }
      const ang = []
      for (const s of ['A', 'B', 'C']) if (k[s] === null) ang.push(s + ' ' + angSeg(sol[s]))
      if (ang.length) { lines.push((tagged ? '' : tag) + ang.join(' · ')); tagged = true }
      const fa = fmtSide(sol.area)
      lines.push((tagged ? '' : tag) + '面积 ' + (fa.exact ? '= ' : '≈ ') + fa.t)
    })
    this.lwLines = lines
  },
  lwPad(v) {
    this.buzz()
    const props = { a: 'lwa', b: 'lwb', c: 'lwc', A: 'lwA', B: 'lwB', C: 'lwC' }
    const prop = props[this.lwField]
    const r = editCoeff(this[prop], v)
    if (r === 'NEXT') {
      const order = ['a', 'b', 'c', 'A', 'B', 'C']
      this.lwField = order[(order.indexOf(this.lwField) + 1) % 6]
      return
    }
    this[prop] = r
    this.lwSolve()
  },

  setPmField(f) { this.buzz(); this.pmField = f },
  syncPmFields() {
    this.pmFieldDefs = [
      { key: 'n', label: 'n', val: this.pmn }, { key: 'r', label: 'r', val: this.pmr }
    ]
  },
  pmSolve() {
    this.syncPmFields()
    this.pmFvPx = fvPxOf([this.pmn, this.pmr], true)
    const n = parseOpt(this.pmn), r = parseOpt(this.pmr)
    if (n === null || r === null) { this.pmLines = ['把 n 和 r 填好就能算']; return }
    if (isNaN(n) || isNaN(r)) { this.pmLines = ['有格子里的数不对']; return }
    if (n > 999) { this.pmLines = ['n 太大了（最多 999）']; return }
    const res = calc2.permComb(n, r)
    if (res.error) { this.pmLines = [res.error]; return }
    if (!isFinite(res.C)) { this.pmLines = ['数字太大，超出精确计算范围']; return }
    const fc = res.cExact && Math.abs(res.C) < 1e16 ? String(res.C) : FD(res.C)
    // 2026-11-15 自查 F9：行超 30 字会被 .q-line（312px）省略号截掉末尾数字，
    // 改 10 位课本式 ×10 上标缩短（如 A(30,15) ≈ 2.028432049×10²⁰，28 字放得下）。
    const sci10 = function (x) { return calc.sciStr(x.toPrecision(10)) }
    // 2026-11-15 第十六轮复审（续）：A 溢出（aOf）只标 A 行，C 行照常。
    let la
    if (res.aOf) la = 'A(' + n + ',' + r + ') 太大了，超出精确计算范围'
    else {
      const fa = res.aExact && Math.abs(res.A) < 1e16 ? String(res.A) : FD(res.A)
      la = 'A(' + n + ',' + r + ') ' + (res.aExact ? '= ' : '≈ ') + fa
      if (la.length > 30) la = 'A(' + n + ',' + r + ') ' + (res.aExact ? '= ' : '≈ ') + sci10(res.A)
    }
    const lc0 = 'C(' + n + ',' + r + ') ' + (res.cExact ? '= ' : '≈ ') + fc
    this.pmLines = [
      la,
      lc0.length > 30 ? 'C(' + n + ',' + r + ') ' + (res.cExact ? '= ' : '≈ ') + sci10(res.C) : lc0
    ]
  },
  pmPad(v) {
    this.buzz()
    const props = { n: 'pmn', r: 'pmr' }
    const prop = props[this.pmField]
    const r = editCoeff(this[prop], v)
    if (r === 'NEXT') { this.pmField = this.pmField === 'n' ? 'r' : 'n'; return }
    this[prop] = r
    this.pmSolve()
  },

  setSqField(f) { this.buzz(); this.sqField = f },
  setSqKind(id) { this.buzz(); this.sqKind = id; this.sqSolve() },
  syncSqFields() {
    this.sqFieldDefs = [
      { key: 'a1', label: 'a1', val: this.sqa },
      { key: 'x', label: this.sqKind === 'ap' ? 'd' : 'q', val: this.sqx },
      { key: 'n', label: 'n', val: this.sqn }
    ]
  },
  sqSolve() {
    this.syncSqFields()
    this.sqFvPx = fvPxOf([this.sqa, this.sqx, this.sqn], true)
    const a1 = parseOpt(this.sqa), x = parseOpt(this.sqx), n = parseOpt(this.sqn)
    if (a1 === null || x === null || n === null) { this.sqLines = ['把三格填好就能算']; return }
    if (isNaN(a1) || isNaN(x) || isNaN(n)) { this.sqLines = ['有格子里的数不对']; return }
    if (!Number.isInteger(n) || n < 1) { this.sqLines = ['项数 n 要是正整数']; return }
    if (n > 9999) { this.sqLines = ['项数太大了（最多 9999）']; return }
    const r = calc2.seqSolve(this.sqKind, a1, x, n)
    if (r.error) { this.sqLines = [r.error]; return }
    if (!isFinite(r.an) || !isFinite(r.Sn)) { this.sqLines = ['数字太大，超出精确计算范围']; return }
    const fa = fmtVal(r.an), fs = fmtVal(r.Sn)
    this.sqLines = ['第 ' + n + ' 项 ' + (fa.exact ? '= ' : '≈ ') + fa.t, '前 ' + n + ' 项和 ' + (fs.exact ? '= ' : '≈ ') + fs.t]
  },
  sqPad(v) {
    this.buzz()
    const props = { a1: 'sqa', x: 'sqx', n: 'sqn' }
    const prop = props[this.sqField]
    const r = editCoeff(this[prop], v)
    if (r === 'NEXT') {
      const order = ['a1', 'x', 'n']
      this.sqField = order[(order.indexOf(this.sqField) + 1) % 3]
      return
    }
    this[prop] = r
    this.sqSolve()
  },

  setStTab(id) { this.buzz(); this.stTab = id },
  stSolve() {
    this.stFvPx = fvPxOf([this.stIn], true)
    const n = this.stVals.length
    // 数据页：每行 3 个、最多 5 行，再多只报总数（删上个仍可逐个删）
    if (n === 0) this.stRows = ['还没有数据']
    else {
      const rows = []
      for (let i = 0; i < n && rows.length < 4; i += 3) {
        const parts = []
        for (let j = i; j < Math.min(i + 3, n); j++) parts.push((j + 1) + '.' + FD(this.stVals[j]))
        rows.push(parts.join('  '))
      }
      rows.push(n > 12 ? '…共 ' + n + ' 个（删上个逐个删）' : '共 ' + n + ' 个')
      this.stRows = rows
    }
    if (n === 0) {
      this.stLines = ['输一个数，点 » 加入数据', '有数据后自动出平均数、方差等']
      this.stSampLines = ['有数据后这里出方差与标准差']
      return
    }
    const r = calc2.statsOf(this.stVals)
    if (r.error) { this.stLines = [r.error]; this.stSampLines = [r.error]; return }
    const line = function (label, f) { return label + ' ' + (f.exact ? '= ' : '≈ ') + f.t }
    const lines = [
      line('平均数', fmtVal(r.mean)),
      line('中位数', fmtVal(r.median))
    ]
    if (r.n === 1) lines.push(line('众数', fmtVal(this.stVals[0])))
    else if (r.modes === null) lines.push('众数 没有（都只出现一次）')
    else lines.push('众数 ' + r.modes.map(function (v) { return FD(v) }).join('、'))
    if (isFinite(r.range)) lines.push(line('极差', fmtVal(r.range)))
    else lines.push('极差 太大（数据跨度超范围）')
    this.stLines = lines
    // 方差 / 标准差各自判溢出（2026-11-15 第二十轮）：引擎已改缩放累
    // 加，哪个真超双精度哪个单独标「太大」，不连坐其余统计量（同极差）。
    const vline = function (label, val) {
      return isFinite(val) ? line(label, fmtVal(val)) : label + ' 太大（超出范围）'
    }
    const vl = [
      vline('总体方差', r.popVar),
      vline('总体标准差', r.popSd)
    ]
    if (r.sampVar === null) {
      vl.push('样本方差 要 2 个以上数据')
      vl.push('样本标准差 要 2 个以上数据')
    } else {
      vl.push(vline('样本方差', r.sampVar))
      vl.push(vline('样本标准差', r.sampSd))
    }
    this.stSampLines = vl
  },
  stAdd() {
    const v = parseCoeff(this.stIn)
    if (this.stIn === '' || isNaN(v)) { this.stTab = 'res'; this.stLines = ['先输一个数再点 »']; return }
    if (this.stVals.length >= 50) { this.stTab = 'res'; this.stLines = ['最多 50 个数据']; return }
    this.stVals.push(v)
    this.stIn = ''
    this.stSolve()
  },
  stDel() { this.buzz(); if (this.stVals.length) this.stVals.pop(); this.stSolve() },
  stClear() { this.buzz(); this.stVals = []; this.stIn = ''; this.stSolve() },
  stPad(v) {
    this.buzz()
    const r = editCoeff(this.stIn, v)
    if (r === 'NEXT') { this.stAdd(); return }
    this.stIn = r
    this.stFvPx = fvPxOf([this.stIn], true)
  },
  // —— 分布列（2026-11-15 新增）——
  setDtTab(id) { this.buzz(); this.dtTab = id },
  dtFocus(f) { this.buzz(); this.dtField = f },
  dtSolve() {
    this.dtFvPx = fvPxOf([this.dtX, this.dtP], true)
    const n = this.dtPairs.length
    if (n === 0) {
      this.dtRows = ['还没有数据']
      this.dtLines = ['输取值 x 和概率 p，点 » 加一组', '全部加完，概率之和要正好是 1']
      return
    }
    const rows = []
    for (let i = 0; i < n && rows.length < 4; i += 3) {
      const parts = []
      for (let j = i; j < Math.min(i + 3, n); j++) parts.push(FD(this.dtPairs[j][0]) + '，' + FD(this.dtPairs[j][1]))
      rows.push(parts.join('  '))
    }
    rows.push(n > 12 ? '…共 ' + n + ' 组（删上个逐个删）' : '共 ' + n + ' 组')
    this.dtRows = rows
    const r = calc2.distOf(this.dtPairs)
    if (r.error) {
      if (r.psum !== undefined) this.dtLines = ['已加 ' + n + ' 组，概率和 ≈ ' + FD(r.psum), '全部加完，概率和要正好是 1']
      else this.dtLines = [r.error]
      return
    }
    const line = function (label, f) { return label + ' ' + (f.exact ? '= ' : '≈ ') + f.t }
    // 方差 / 标准差真溢出时单独标「太大」、期望照常显示（2026-11-15
    // 第二十一轮，引擎已改不连坐契约，同统计页口径）。
    this.dtLines = [
      line('期望 E(X)', fmtVal(r.E)),
      isFinite(r.D) ? line('方差 D(X)', fmtVal(r.D)) : '方差 D(X) 太大（超出范围）',
      isFinite(r.sd) ? line('标准差', fmtVal(r.sd)) : '标准差 太大（超出范围）',
      '共 ' + n + ' 组，概率和 = 1 ✓'
    ]
  },
  dtAdd() {
    const x = parseCoeff(this.dtX), p = parseCoeff(this.dtP)
    if (this.dtX === '' || isNaN(x)) { this.dtTab = 'res'; this.dtLines = ['先输取值 x 再加']; return }
    if (this.dtP === '' || isNaN(p)) { this.dtTab = 'res'; this.dtLines = ['先输概率 p 再加']; this.dtField = 'p'; return }
    if (p < 0 || p > 1) { this.dtTab = 'res'; this.dtLines = ['概率要在 0 到 1 之间']; return }
    if (this.dtPairs.length >= 50) { this.dtTab = 'res'; this.dtLines = ['最多 50 组']; return }
    this.dtPairs.push([x, p])
    this.dtX = ''; this.dtP = ''; this.dtField = 'x'
    this.dtSolve()
  },
  dtDel() { this.buzz(); if (this.dtPairs.length) this.dtPairs.pop(); this.dtSolve() },
  dtPad(v) {
    this.buzz()
    if (this.dtField === 'x') {
      const r = editCoeff(this.dtX, v)
      if (r === 'NEXT') { this.dtField = 'p'; this.dtFvPx = fvPxOf([this.dtX, this.dtP], true); return }
      this.dtX = r
    } else {
      const r = editCoeff(this.dtP, v)
      if (r === 'NEXT') { this.dtAdd(); return }
      this.dtP = r
    }
    this.dtFvPx = fvPxOf([this.dtX, this.dtP], true)
  },
  // —— 向量运算（2026-11-15 新增）——
  vcSyncFields() {
    const v = this.vcVals
    const d3 = this.vcDim === 3
    this.vcFieldDefs1 = d3
      ? [{ key: 'a1', label: 'a1', val: v.a1 }, { key: 'a2', label: 'a2', val: v.a2 }, { key: 'a3', label: 'a3', val: v.a3 }]
      : [{ key: 'a1', label: 'a1', val: v.a1 }, { key: 'a2', label: 'a2', val: v.a2 }]
    this.vcFieldDefs2 = d3
      ? [{ key: 'b1', label: 'b1', val: v.b1 }, { key: 'b2', label: 'b2', val: v.b2 }, { key: 'b3', label: 'b3', val: v.b3 }]
      : [{ key: 'b1', label: 'b1', val: v.b1 }, { key: 'b2', label: 'b2', val: v.b2 }]
    this.vcFvPx = fvPxOf([v.a1, v.a2, v.a3, v.b1, v.b2, v.b3], true)
  },
  vcFocus(k) { this.buzz(); this.vcField = k },
  vcDimToggle() {
    this.buzz()
    this.vcDim = this.vcDim === 2 ? 3 : 2
    if (this.vcDim === 2 && (this.vcField === 'a3' || this.vcField === 'b3')) this.vcField = 'a1'
    this.vcSyncFields(); this.vcSolve()
  },
  vcSolve() {
    const v = this.vcVals
    const keys = this.vcDim === 2 ? ['a1', 'a2', 'b1', 'b2'] : ['a1', 'a2', 'a3', 'b1', 'b2', 'b3']
    const nums = {}
    for (const k of keys) {
      const s = v[k]
      const num = parseCoeff(s)
      if (s === '' || isNaN(num)) { this.vcLines = ['有分量没输对']; return }
      nums[k] = num
    }
    const a = this.vcDim === 2 ? [nums.a1, nums.a2] : [nums.a1, nums.a2, nums.a3]
    const b = this.vcDim === 2 ? [nums.b1, nums.b2] : [nums.b1, nums.b2, nums.b3]
    const r = calc2.vecOf(a, b)
    if (r.error) { this.vcLines = [r.error]; return }
    const bad = !isFinite(r.dot) || !isFinite(r.magA) || !isFinite(r.magB) ||
      r.sum.some(function (x) { return !isFinite(x) }) || r.diff.some(function (x) { return !isFinite(x) })
    if (bad) { this.vcLines = ['数字太大，超出精确计算范围']; return }
    const line = function (label, f) { return label + ' ' + (f.exact ? '= ' : '≈ ') + f.t }
    const ma = fmtShortE(r.magA), mb = fmtShortE(r.magB)
    const lines = [
      line('a·b', fmtVal(r.dot)),
      '|a| ' + (ma.exact ? '= ' : '≈ ') + ma.t + '，|b| ' + (mb.exact ? '= ' : '≈ ') + mb.t,
      line('a+b', fmtVecE(r.sum)),
      line('a−b', fmtVecE(r.diff))
    ]
    if (r.angle === null) lines.push(r.magA === 0 ? 'a 是零向量，没有夹角' : 'b 是零向量，没有夹角')
    else lines.push('夹角 ' + angSeg(r.angle))
    this.vcLines = lines
  },
  vcPad(v) {
    this.buzz()
    const order = this.vcDim === 2 ? ['a1', 'a2', 'b1', 'b2'] : ['a1', 'a2', 'a3', 'b1', 'b2', 'b3']
    const r = editCoeff(this.vcVals[this.vcField], v)
    if (r === 'NEXT') {
      const i = order.indexOf(this.vcField)
      this.vcField = order[(i + 1) % order.length]
      return
    }
    this.vcVals[this.vcField] = r
    this.vcSyncFields(); this.vcSolve()
  },
  // —— 复数运算（2026-11-15 新增）——
  cxSyncFields() {
    const v = this.cxVals
    this.cxFieldDefs1 = [{ key: 'a', label: 'a', val: v.a }, { key: 'b', label: 'b', val: v.b }]
    this.cxFieldDefs2 = [{ key: 'c', label: 'c', val: v.c }, { key: 'd', label: 'd', val: v.d }]
    this.cxFvPx = fvPxOf([v.a, v.b, v.c, v.d], true)
  },
  cxFocus(k) { this.buzz(); this.cxField = k },
  cxSolve() {
    const v = this.cxVals
    const nums = {}
    for (const k of ['a', 'b', 'c', 'd']) {
      const s = v[k]
      const num = parseCoeff(s)
      if (s === '' || isNaN(num)) { this.cxLines = ['z1 = a + bi，z2 = c + di', '有格子没输对']; return }
      nums[k] = num
    }
    const r = calc2.cplxOps([nums.a, nums.b], [nums.c, nums.d])
    if (r.error) { this.cxLines = [r.error]; return }
    const line = function (label, f) { return label + ' ' + (f.exact ? '= ' : '≈ ') + f.t }
    const cl = function (label, pair) {
      if (!isFinite(pair[0]) || !isFinite(pair[1])) return label + ' 太大了，超出范围'
      return line(label, fmtCplxE(pair[0], pair[1]))
    }
    const m1 = isFinite(r.mag1) ? fmtShortE(r.mag1) : null
    const m2 = isFinite(r.mag2) ? fmtShortE(r.mag2) : null
    this.cxLines = [
      cl('z1+z2', r.add),
      cl('z1−z2', r.sub),
      cl('z1×z2', r.mul),
      r.div === null ? 'z1÷z2 除数是 0，没法除' : cl('z1÷z2', r.div),
      (m1 ? '|z1| ' + (m1.exact ? '= ' : '≈ ') + m1.t : '|z1| 太大了') + '，' + (m2 ? '|z2| ' + (m2.exact ? '= ' : '≈ ') + m2.t : '|z2| 太大了')
    ]
  },
  cxPad(v) {
    this.buzz()
    const order = ['a', 'b', 'c', 'd']
    const r = editCoeff(this.cxVals[this.cxField], v)
    if (r === 'NEXT') {
      const i = order.indexOf(this.cxField)
      this.cxField = order[(i + 1) % order.length]
      return
    }
    this.cxVals[this.cxField] = r
    this.cxSyncFields(); this.cxSolve()
  },
  // —— 韦达定理 · 弦长（2026-11-15 新增）——
  vtSyncFields() {
    const v = this.vtVals
    this.vtFieldDefs1 = [{ key: 'a', label: 'a', val: v.a }, { key: 'b', label: 'b', val: v.b }, { key: 'c', label: 'c', val: v.c }]
    this.vtFvPx = fvPxOf([v.a, v.b, v.c, v.k], true)
  },
  vtFocus(k) { this.buzz(); this.vtField = k },
  vtSolve() {
    const v = this.vtVals
    const nums = {}
    for (const k of ['a', 'b', 'c', 'k']) {
      const s = v[k]
      const num = parseCoeff(s)
      if (s === '' || isNaN(num)) { this.vtLines = ['有格子没输对']; return }
      nums[k] = num
    }
    const r = calc2.vietaOf(nums.a, nums.b, nums.c, nums.k)
    if (r.error) { this.vtLines = [r.error]; return }
    const line = function (label, f) { return label + ' ' + (f.exact ? '= ' : '≈ ') + f.t }
    const lines = []
    if (isFinite(r.disc)) lines.push(line('Δ', fmtVal(r.disc)))
    else lines.push('Δ 太大（下面的量还能看）')
    lines.push(isFinite(r.sum) ? line('x1+x2', fmtVal(r.sum)) : 'x1+x2 太大了')
    lines.push(isFinite(r.prod) ? line('x1x2', fmtVal(r.prod)) : 'x1x2 太大了')
    if (r.discNeg) lines.push('Δ < 0：不相交，没有弦')
    else {
      lines.push(isFinite(r.diffAbs) ? line('|x1−x2|', fmtVal(r.diffAbs)) : '|x1−x2| 太大了')
      lines.push(isFinite(r.chord) ? line('弦长', fmtVal(r.chord)) : '弦长 太大了')
    }
    this.vtLines = lines
  },
  vtPad(v) {
    this.buzz()
    const order = ['a', 'b', 'c', 'k']
    const r = editCoeff(this.vtVals[this.vtField], v)
    if (r === 'NEXT') {
      const i = order.indexOf(this.vtField)
      this.vtField = order[(i + 1) % order.length]
      return
    }
    this.vtVals[this.vtField] = r
    this.vtSyncFields(); this.vtSolve()
  }
}
</script>

<style>
.page { width: 336px; height: 480px; background-color: #EDF0F4; flex-direction: column; }
.view { width: 336px; height: 480px; flex-direction: column; }

/* 顶栏 */
