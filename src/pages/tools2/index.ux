    lwLines: [],
    lwFvPx: 20,
    pmn: '5', pmr: '2',
    pmField: 'n',
    pmLines: [],
    pmFvPx: 20,
    sqa: '1', sqx: '2', sqn: '10',
    sqKind: 'ap',
    sqField: 'a1',
    sqLines: [],
    sqFvPx: 20,
    seqKindChips: [
