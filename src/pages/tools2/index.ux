      { id: 'perm', ico: '排', name: '排列组合', desc: 'A(n,r) 与 C(n,r)，整数精确算' },
      { id: 'seq', ico: '列', name: '等差 · 等比数列', desc: '填首项与公差 / 公比，求项与和' },
      { id: 'stats', ico: '均', name: '数据统计', desc: '平均数 · 中位数 · 众数 · 方差' },
      { id: 'dist', ico: '期', name: '分布列', desc: '期望 E(X) · 方差 D(X)' },
      { id: 'vec', ico: '向', name: '向量运算', desc: '数量积 · 模 · 夹角' },
