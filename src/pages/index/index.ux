          <image if="{{$item.it}}" src="/common/glyphs/{{$item.v}}-dark.png" style="width: 10px; height: 20px;"></image><image if="{{$item.v === '²'}}" src="/common/glyphs/xsq-dark.png" style="width: 17px; height: 19px;"></image><text if="{{!$item.it && $item.v !== '²'}}" class="key-t {{$item.cls ? 'eqgo-t' : 'key-t-num'}}" style="font-size: {{$item.fs}}px;">{{$item.label}}</text>
        </div>
