      <div class="q-fields">
        <div class="q-field {{tField === 'a' ? 'q-field-on' : ''}}" onclick="setTField('a')">
          <text class="q-fl">a</text><text class="q-fv" style="font-size: {{tFvPx}}px;">{{ta ? ta : '0'}}</text>
        </div>
        <div class="q-field {{tField === 'b' ? 'q-field-on' : ''}}" onclick="setTField('b')">
          <text class="q-fl">b</text><text class="q-fv" style="font-size: {{tFvPx}}px;">{{tb ? tb : '0'}}</text>
        </div>
        <div class="q-field {{tField === 'c' ? 'q-field-on' : ''}}" onclick="setTField('c')">
          <text class="q-fl">c</text><text class="q-fv" style="font-size: {{tFvPx}}px;">{{tc ? tc : '0'}}</text>
        </div>
      </div>
