        <text class="q-line" for="{{tLines}}">{{' ' + $item}}</text>
      </div>
      <div class="pad pad-sm">
        <div class="key key-num key-sm key-c5 {{$item.kcls ? $item.kcls : ''}}" for="{{quadKeys}}" onclick="triPad($item.v)">
