<template>
  <div class="page">

    <!-- ===== 主页：计算器（标准/科学双键盘） ===== -->
    <div class="view" if="{{view === 'calc'}}">
      <div class="topbar">
        <text class="top-title">计算器</text>
        <div class="top-btn" onclick="openTools"><text class="top-btn-t">工具箱</text></div>
        <div class="top-btn" onclick="openHistory"><text class="top-btn-t">历史</text></div>
      </div>
      <div class="disp">
        <text class="expr" style="font-size: {{exprPx}}px;">{{exprDisp}}</text>
        <div class="res-row">
          <text class="res" style="font-size: {{resPx}}px; color: {{previewOk ? '#5F7E99' : '#9AA6B4'}};">{{resDisp}}</text>
          <div class="frac-chip" if="{{canFrac}}" onclick="toggleFrac">
            <text class="frac-chip-t">{{chipText}}</text>
          </div>
        </div>
      </div>
      <div class="pad" if="{{padPage === 'main'}}">
        <div class="key {{'key-' + $item.cls}}" for="{{keys}}" onclick="pressKey($item.v)">
          <text class="key-t {{'key-t-' + $item.cls}}" style="font-size: {{$item.fs}}px;">{{$item.label}}</text>
        </div>
      </div>
      <div class="pad" if="{{padPage === 'sci'}}">
        <div class="key {{'key-' + $item.cls}}" for="{{sciKeys}}" onclick="pressKey($item.v)">
          <text class="key-t {{'key-t-' + $item.cls}}" style="font-size: {{$item.fs}}px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 工具箱 ===== -->
    <div class="view" if="{{view === 'tools'}}">
      <div class="bar">
        <div class="bbtn" onclick="goCalc"><text class="bar-btn">‹ 返回</text></div>
        <text class="bar-title">工具箱</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <list class="tool-list">
        <list-item type="trow" class="tool-row" for="{{tools}}" onclick="openTool($item.id)">
          <text class="tool-ico">{{$item.ico}}</text>
          <div class="tool-main">
            <text class="tool-name">{{$item.name}}</text>
            <text class="tool-desc">{{$item.desc}}</text>
          </div>
          <text class="tool-arrow">›</text>
        </list-item>
      </list>
      <text class="foot-tip">为小初高同学备的工具 · 输入少、结果短</text>
    </div>

    <!-- ===== 单位换算 ===== -->
    <div class="view" if="{{view === 'unit'}}">
      <div class="bar">
        <div class="bbtn" onclick="goTools"><text class="bar-btn">‹ 工具箱</text></div>
        <text class="bar-title">单位换算</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <div class="chip-row">
        <div class="chip {{catName === $item.name ? 'chip-on' : ''}}" for="{{unitCats}}" onclick="setCat($item.name)">
          <text class="chip-t {{catName === $item.name ? 'chip-t-on' : ''}}">{{$item.name}}</text>
        </div>
      </div>
      <div class="u-card">
        <div class="u-pick" onclick="pickUnit('from')"><text class="u-pick-t">{{unitFromName}} ▼</text></div>
        <text class="u-val" style="font-size: {{unitValPx}}px;">{{unitVal ? unitVal : '0'}}</text>
      </div>
      <div class="swap-row">
        <div class="swap-btn" onclick="swapUnits"><text class="swap-t">交换</text></div>
        <div class="swap-btn swap-btn2" if="{{unitRes}}" onclick="unitCarryBack"><text class="swap-t">带回计算</text></div>
      </div>
      <div class="u-card">
        <div class="u-pick" onclick="pickUnit('to')"><text class="u-pick-t">{{unitToName}} ▼</text></div>
        <text class="u-val u-val-res" style="font-size: {{unitResPx}}px;">{{unitRes ? unitRes : '—'}}</text>
      </div>
      <div class="pad pad-sm">
        <div class="key key-num key-sm" for="{{numKeys}}" onclick="unitPad($item.v)">
          <text class="key-t key-t-num" style="font-size: 22px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 选单位 ===== -->
    <div class="view" if="{{view === 'unitpick'}}">
      <div class="bar">
        <div class="bbtn" onclick="backToUnit"><text class="bar-btn">‹ 返回</text></div>
        <text class="bar-title">选择单位</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <list class="pick-list">
        <list-item type="prow" class="pick-row" for="{{pickUnits}}" onclick="applyPick($item.id)">
          <text class="pick-t">{{$item.name}}</text>
          <text class="pick-on" if="{{$item.id === pickCur}}">当前</text>
        </list-item>
      </list>
    </div>

    <!-- ===== 进制转换 ===== -->
    <div class="view" if="{{view === 'base'}}">
      <div class="bar">
        <div class="bbtn" onclick="goTools"><text class="bar-btn">‹ 工具箱</text></div>
        <text class="bar-title">进制转换</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <div class="chip-row">
        <div class="chip {{fromBase === $item.b ? 'chip-on' : ''}}" for="{{baseChips}}" onclick="setBase($item.b)">
          <text class="chip-t {{fromBase === $item.b ? 'chip-t-on' : ''}}">{{$item.name}}</text>
        </div>
      </div>
      <div class="b-inwrap">
        <text class="b-label">输入（{{baseName}}）</text>
        <text class="b-in" style="font-size: {{baseInPx}}px;">{{baseVal ? baseVal : '0'}}</text>
        <text class="b-err" if="{{baseErr}}">{{baseErr}}</text>
      </div>
      <div class="b-rows">
        <div class="b-row" for="{{baseRows}}">
          <text class="b-row-k">{{$item.k}}</text>
          <text class="b-row-v" style="font-size: {{$item.px}}px;">{{$item.v}}</text>
        </div>
      </div>
      <div class="pad pad-base">
        <div class="key key-num key-b" for="{{baseKeys}}" onclick="basePad($item.v)">
          <text class="key-t key-t-num" style="font-size: 19px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 解方程菜单 ===== -->
    <div class="view" if="{{view === 'solvers'}}">
      <div class="bar">
        <div class="bbtn" onclick="goTools"><text class="bar-btn">‹ 工具箱</text></div>
        <text class="bar-title">解方程</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <div class="tool-list2">
        <div class="tool-row" for="{{solverMenu}}" onclick="openSolver($item.id)">
          <text class="tool-ico">{{$item.ico}}</text>
          <div class="tool-main">
            <text class="tool-name">{{$item.name}}</text>
            <text class="tool-desc">{{$item.desc}}</text>
          </div>
          <text class="tool-arrow">›</text>
        </div>
      </div>
      <text class="foot-tip">填系数就能解，还能看函数图象</text>
    </div>

    <!-- ===== 一次方程 ===== -->
    <div class="view" if="{{view === 'lin'}}">
      <div class="bar">
        <div class="bbtn" onclick="goSolvers"><text class="bar-btn">‹ 解方程</text></div>
        <text class="bar-title">一次方程</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <div class="q-formula-r"><image src="/common/glyphs/a-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/plus-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/b-gray.png" style="width: 8px; height: 19px;"></image><image src="/common/glyphs/eq-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/c-gray.png" style="width: 8px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/plus-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/d-gray.png" style="width: 10px; height: 19px;"></image></div>
      <div class="q-fields q-fields-abs">
        <div class="q-field q-field-w qf-w1 {{lField === 'a' ? 'q-field-on' : ''}}" onclick="setLField('a')">
          <image src="/common/glyphs/a-blue.png" style="width: 10px; height: 19px; margin-right: 8px;"></image><text class="q-fv" style="font-size: {{lFvPx}}px;">{{la ? la : '0'}}</text>
        </div>
        <div class="q-field q-field-w qf-w2 {{lField === 'b' ? 'q-field-on' : ''}}" onclick="setLField('b')">
          <image src="/common/glyphs/b-blue.png" style="width: 8px; height: 19px; margin-right: 8px;"></image><text class="q-fv" style="font-size: {{lFvPx}}px;">{{lb ? lb : '0'}}</text>
        </div>
      </div>
      <div class="q-fields q-fields-abs">
        <div class="q-field q-field-w qf-w1 {{lField === 'c' ? 'q-field-on' : ''}}" onclick="setLField('c')">
          <image src="/common/glyphs/c-blue.png" style="width: 8px; height: 19px; margin-right: 8px;"></image><text class="q-fv" style="font-size: {{lFvPx}}px;">{{lc ? lc : '0'}}</text>
        </div>
        <div class="q-field q-field-w qf-w2 {{lField === 'd' ? 'q-field-on' : ''}}" onclick="setLField('d')">
          <image src="/common/glyphs/d-blue.png" style="width: 10px; height: 19px; margin-right: 8px;"></image><text class="q-fv" style="font-size: {{lFvPx}}px;">{{ld ? ld : '0'}}</text>
        </div>
      </div>
      <div class="q-res q-res-s">
        <text class="q-line" for="{{lLines}}">{{' ' + $item}}</text>
      </div>
      <div class="plot-btn-row" if="{{lCanPlot}}">
        <div class="plot-btn" onclick="openPlot('lin')"><text class="plot-btn-t">看图象</text></div>
      </div>
      <div class="pad pad-sm">
        <div class="key key-num key-sm" for="{{quadKeys}}" onclick="linPad($item.v)">
          <text class="key-t key-t-num" style="font-size: 22px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 二次方程 ===== -->
    <div class="view" if="{{view === 'quad'}}">
      <div class="bar">
        <div class="bbtn" onclick="goSolvers"><text class="bar-btn">‹ 解方程</text></div>
        <text class="bar-title">二次方程</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <div class="q-formula-r"><image src="/common/glyphs/a-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/sup2-gray.png" style="width: 6px; height: 19px;"></image><image src="/common/glyphs/plus-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/b-gray.png" style="width: 8px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/plus-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/c-gray.png" style="width: 8px; height: 19px;"></image><image src="/common/glyphs/eq-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/d0-gray.png" style="width: 9px; height: 19px;"></image></div>
      <div class="q-fields q-fields-abs q-fields-sys">
        <div class="q-field qf-1 {{qField === 'a' ? 'q-field-on' : ''}}" onclick="setQField('a')">
          <image src="/common/glyphs/a-blue.png" style="width: 10px; height: 19px; margin-right: 8px;"></image><text class="q-fv" style="font-size: {{qFvPx}}px;">{{qa ? qa : '0'}}</text>
        </div>
        <div class="q-field qf-2 {{qField === 'b' ? 'q-field-on' : ''}}" onclick="setQField('b')">
          <image src="/common/glyphs/b-blue.png" style="width: 8px; height: 19px; margin-right: 8px;"></image><text class="q-fv" style="font-size: {{qFvPx}}px;">{{qb ? qb : '0'}}</text>
        </div>
        <div class="q-field qf-3 {{qField === 'c' ? 'q-field-on' : ''}}" onclick="setQField('c')">
          <image src="/common/glyphs/c-blue.png" style="width: 8px; height: 19px; margin-right: 8px;"></image><text class="q-fv" style="font-size: {{qFvPx}}px;">{{qc ? qc : '0'}}</text>
        </div>
      </div>
      <div class="q-res">
        <text class="q-line" for="{{qLines}}">{{' ' + $item}}</text>
      </div>
      <div class="plot-btn-row" if="{{qCanPlot}}">
        <div class="plot-btn" onclick="openPlot('quad')"><text class="plot-btn-t">看图象（抛物线）</text></div>
      </div>
      <div class="pad pad-sm">
        <div class="key key-num key-sm" for="{{quadKeys}}" onclick="quadPad($item.v)">
          <text class="key-t key-t-num" style="font-size: 22px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 二元一次方程组 ===== -->
    <div class="view" if="{{view === 'sys'}}">
      <div class="bar">
        <div class="bbtn" onclick="goSolvers"><text class="bar-btn">‹ 解方程</text></div>
        <text class="bar-title">方程组</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <div class="q-formula-r"><image src="/common/glyphs/a-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/sub1-gray.png" style="width: 5px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/plus-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/b-gray.png" style="width: 8px; height: 19px;"></image><image src="/common/glyphs/sub1-gray.png" style="width: 5px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/y-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/eq-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/c-gray.png" style="width: 8px; height: 19px;"></image><image src="/common/glyphs/sub1-gray.png" style="width: 5px; height: 19px;"></image></div>
      <div class="q-fields q-fields-abs q-fields-sys">
        <div class="q-field qf-1 {{sField === 'a1' ? 'q-field-on' : ''}}" onclick="setSField('a1')">
          <image src="/common/glyphs/a-blue.png" style="width: 10px; height: 19px;"></image><text class="q-fl-d">1</text><text class="q-fv" style="font-size: {{sFvPx}}px;">{{s1a ? s1a : '0'}}</text>
        </div>
        <div class="q-field qf-2 {{sField === 'b1' ? 'q-field-on' : ''}}" onclick="setSField('b1')">
          <image src="/common/glyphs/b-blue.png" style="width: 8px; height: 19px;"></image><text class="q-fl-d">1</text><text class="q-fv" style="font-size: {{sFvPx}}px;">{{s1b ? s1b : '0'}}</text>
        </div>
        <div class="q-field qf-3 {{sField === 'c1' ? 'q-field-on' : ''}}" onclick="setSField('c1')">
          <image src="/common/glyphs/c-blue.png" style="width: 8px; height: 19px;"></image><text class="q-fl-d">1</text><text class="q-fv" style="font-size: {{sFvPx}}px;">{{s1c ? s1c : '0'}}</text>
        </div>
      </div>
      <div class="q-formula-r"><image src="/common/glyphs/a-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/sub2-gray.png" style="width: 6px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/plus-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/b-gray.png" style="width: 8px; height: 19px;"></image><image src="/common/glyphs/sub2-gray.png" style="width: 6px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/y-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/eq-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/c-gray.png" style="width: 8px; height: 19px;"></image><image src="/common/glyphs/sub2-gray.png" style="width: 6px; height: 19px;"></image></div>
      <div class="q-fields q-fields-abs q-fields-sys">
        <div class="q-field qf-1 {{sField === 'a2' ? 'q-field-on' : ''}}" onclick="setSField('a2')">
          <image src="/common/glyphs/a-blue.png" style="width: 10px; height: 19px;"></image><text class="q-fl-d">2</text><text class="q-fv" style="font-size: {{sFvPx}}px;">{{s2a ? s2a : '0'}}</text>
        </div>
        <div class="q-field qf-2 {{sField === 'b2' ? 'q-field-on' : ''}}" onclick="setSField('b2')">
          <image src="/common/glyphs/b-blue.png" style="width: 8px; height: 19px;"></image><text class="q-fl-d">2</text><text class="q-fv" style="font-size: {{sFvPx}}px;">{{s2b ? s2b : '0'}}</text>
        </div>
        <div class="q-field qf-3 {{sField === 'c2' ? 'q-field-on' : ''}}" onclick="setSField('c2')">
          <image src="/common/glyphs/c-blue.png" style="width: 8px; height: 19px;"></image><text class="q-fl-d">2</text><text class="q-fv" style="font-size: {{sFvPx}}px;">{{s2c ? s2c : '0'}}</text>
        </div>
      </div>
      <div class="q-res">
        <text class="q-line" for="{{sLines}}">{{' ' + $item}}</text>
      </div>
      <div class="pad pad-sm">
        <div class="key key-num key-sm key-sys" for="{{quadKeys}}" onclick="sysPad($item.v)">
          <text class="key-t key-t-num" style="font-size: 22px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 分数计算 ===== -->
    <div class="view" if="{{view === 'frac'}}">
      <div class="bar">
        <div class="bbtn" onclick="goTools"><text class="bar-btn">‹ 工具箱</text></div>
        <text class="bar-title">分数计算</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <div class="f-grid">
        <div class="f-col">
          <div class="q-field f-cell f-cell-t {{fField === 'n1' ? 'q-field-on' : ''}}" onclick="setFField('n1')">
            <text class="q-fv f-fv" style="font-size: {{fFvPx}}px;">{{fn1 ? fn1 : '0'}}</text>
          </div>
          <div class="f-line"></div>
          <div class="q-field f-cell f-cell-b {{fField === 'd1' ? 'q-field-on' : ''}}" onclick="setFField('d1')">
            <text class="q-fv f-fv" style="font-size: {{fFvPx}}px;">{{fd1 ? fd1 : '0'}}</text>
          </div>
        </div>
        <text class="f-op">{{fopSym}}</text>
        <div class="f-col">
          <div class="q-field f-cell f-cell-t {{fField === 'n2' ? 'q-field-on' : ''}}" onclick="setFField('n2')">
            <text class="q-fv f-fv" style="font-size: {{fFvPx}}px;">{{fn2 ? fn2 : '0'}}</text>
          </div>
          <div class="f-line"></div>
          <div class="q-field f-cell f-cell-b {{fField === 'd2' ? 'q-field-on' : ''}}" onclick="setFField('d2')">
            <text class="q-fv f-fv" style="font-size: {{fFvPx}}px;">{{fd2 ? fd2 : '0'}}</text>
          </div>
        </div>
      </div>
      <div class="chip-row f-ops">
        <div class="chip {{fop === $item.v ? 'chip-on' : ''}}" for="{{fopChips}}" onclick="setFop($item.v)">
          <text class="chip-t {{fop === $item.v ? 'chip-t-on' : ''}}">{{$item.label}}</text>
        </div>
      </div>
      <div class="q-res f-res">
        <text class="q-line" for="{{fLines}}">{{' ' + $item}}</text>
      </div>
      <div class="pad pad-sm">
        <div class="key key-num key-sm key-xs" for="{{intKeys}}" onclick="fracPad($item.v)">
          <text class="key-t key-t-num" style="font-size: 22px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 根号化简 ===== -->
    <div class="view" if="{{view === 'sqrt'}}">
      <div class="bar">
        <div class="bbtn" onclick="goTools"><text class="bar-btn">‹ 工具箱</text></div>
        <text class="bar-title">根号化简</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <div class="u-card sqrt-card">
        <text class="sqrt-sym">√</text>
        <text class="u-val">{{sqrtN ? sqrtN : '0'}}</text>
      </div>
      <div class="q-res sqrt-res">
        <text class="q-line" for="{{sqrtLines}}">{{' ' + $item}}</text>
      </div>
      <div class="pad pad-sm">
        <div class="key key-num key-sm" for="{{intKeys}}" onclick="sqrtPad($item.v)">
          <text class="key-t key-t-num" style="font-size: 22px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 公约数公倍数 ===== -->
    <div class="view" if="{{view === 'gcd'}}">
      <div class="bar">
        <div class="bbtn" onclick="goTools"><text class="bar-btn">‹ 工具箱</text></div>
        <text class="bar-title">公约数 · 公倍数</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <text class="q-formula">输入两个整数</text>
      <div class="q-fields">
        <div class="q-field q-field-w {{gField === 'a' ? 'q-field-on' : ''}}" onclick="setGField('a')">
          <text class="q-fl">甲</text><text class="q-fv" style="font-size: {{gFvPx}}px;">{{ga ? ga : '0'}}</text>
        </div>
        <div class="q-field q-field-w {{gField === 'b' ? 'q-field-on' : ''}}" onclick="setGField('b')">
          <text class="q-fl">乙</text><text class="q-fv" style="font-size: {{gFvPx}}px;">{{gb ? gb : '0'}}</text>
        </div>
      </div>
      <div class="q-res q-res-s">
        <text class="q-line" for="{{gLines}}">{{' ' + $item}}</text>
      </div>
      <div class="pad pad-sm">
        <div class="key key-num key-sm" for="{{intKeys}}" onclick="gcdPad($item.v)">
          <text class="key-t key-t-num" style="font-size: 22px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 输入方程（自由输入） ===== -->
    <div class="view" if="{{view === 'eqin'}}">
      <div class="bar">
        <div class="bbtn" onclick="goSolvers"><text class="bar-btn">‹ 解方程</text></div>
        <text class="bar-title">输入方程</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <div class="u-card eq-card {{eqShow2 ? 'eq-card-s' : ''}} {{eqFocus === 1 ? 'eq-on' : ''}}" onclick="setEqFocus(1)">
        <div class="eq-chars" if="{{eqExpr}}">
          <image if="{{$item === 'x'}}" for="{{eqChars1}}" src="/common/glyphs/x-dark.png" style="width: {{eqImgW}}px; height: {{eqPx}}px;"></image><image if="{{$item === 'y'}}" for="{{eqChars1}}" src="/common/glyphs/y-dark.png" style="width: {{eqImgW}}px; height: {{eqPx}}px;"></image><text if="{{$item !== 'x' && $item !== 'y' && $item !== '²'}}" class="eq-ch" style="font-size: {{eqPx}}px;" for="{{eqChars1}}">{{$item}}</text><text if="{{$item === '²'}}" class="eq-ch eq-sup" style="font-size: {{eqSupPx}}px;" for="{{eqChars1}}">{{$item}}</text>
        </div>
        <text class="eq-val" if="{{!eqExpr}}">0</text>
      </div>
      <div class="u-card eq-card2 {{eqFocus === 2 ? 'eq-on' : ''}}" if="{{eqShow2}}" onclick="setEqFocus(2)">
        <div class="eq-chars" if="{{eqExpr2}}">
          <image if="{{$item === 'x'}}" for="{{eqChars2}}" src="/common/glyphs/x-dark.png" style="width: {{eqImgW}}px; height: {{eqPx}}px;"></image><image if="{{$item === 'y'}}" for="{{eqChars2}}" src="/common/glyphs/y-dark.png" style="width: {{eqImgW}}px; height: {{eqPx}}px;"></image><text if="{{$item !== 'x' && $item !== 'y' && $item !== '²'}}" class="eq-ch" style="font-size: {{eqPx}}px;" for="{{eqChars2}}">{{$item}}</text><text if="{{$item === '²'}}" class="eq-ch eq-sup" style="font-size: {{eqSupPx}}px;" for="{{eqChars2}}">{{$item}}</text>
        </div>
        <text class="eq-val eq-ph" if="{{!eqExpr2}}">第二个方程（点这里输入）</text>
      </div>
      <div class="q-res">
        <text class="q-line" for="{{eqLines}}">{{' ' + $item}}</text>
      </div>
      <div class="pad pad-sm">
        <div class="key key-num eqkey {{eqShow2 ? 'eqkey-s' : ''}} {{$item.cls ? $item.cls : ''}} {{$item.kcls ? $item.kcls : ''}}" for="{{eqKeys}}" onclick="eqPad($item.v)">
          <image if="{{$item.it}}" src="/common/glyphs/{{$item.v}}-dark.png" style="width: 10px; height: 20px;"></image><image if="{{$item.v === '²'}}" src="/common/glyphs/xsq-dark.png" style="width: 17px; height: 19px;"></image><text if="{{!$item.it && $item.v !== '²'}}" class="key-t {{$item.cls ? 'eqgo-t' : 'key-t-num'}}" style="font-size: {{$item.fs}}px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 函数图象（设置） ===== -->
    <div class="view" if="{{view === 'plotcfg'}}">
      <div class="bar">
        <div class="bbtn" onclick="goTools"><text class="bar-btn">‹ 工具箱</text></div>
        <text class="bar-title">函数图象</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <div class="chip-row">
        <div class="chip {{plotType === $item.id ? 'chip-on' : ''}}" for="{{plotTypeChips}}" onclick="setPlotType($item.id)">
          <text class="chip-t {{plotType === $item.id ? 'chip-t-on' : ''}}">{{$item.name}}</text>
        </div>
      </div>
      <div class="q-formula-r" if="{{plotType === 'quad2'}}"><image src="/common/glyphs/y-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/eq-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/a-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/sup2-gray.png" style="width: 6px; height: 19px;"></image><image src="/common/glyphs/plus-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/b-gray.png" style="width: 8px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/plus-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/c-gray.png" style="width: 8px; height: 19px;"></image></div><div class="q-formula-r" if="{{plotType === 'lin2'}}"><image src="/common/glyphs/y-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/eq-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/k-gray.png" style="width: 9px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/plus-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/b-gray.png" style="width: 8px; height: 19px;"></image></div><div class="q-formula-r" if="{{plotType === 'inv'}}"><image src="/common/glyphs/y-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/eq-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/k-gray.png" style="width: 9px; height: 19px;"></image><image src="/common/glyphs/slash-gray.png" style="width: 8px; height: 19px;"></image><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image></div><div class="q-formula-r" if="{{plotType === 'sin'}}"><image src="/common/glyphs/y-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/eq-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/A-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/sin-gray.png" style="width: 23px; height: 19px;"></image><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><text class="q-formula-t">（</text><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><text class="q-formula-t"> 用角度）</text></div><div class="q-formula-r" if="{{plotType === 'cos'}}"><image src="/common/glyphs/y-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/eq-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/A-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/cos-gray.png" style="width: 25px; height: 19px;"></image><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><text class="q-formula-t">（</text><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><text class="q-formula-t"> 用角度）</text></div><div class="q-formula-r" if="{{plotType === 'exp'}}"><image src="/common/glyphs/y-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/eq-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/a-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/supx-gray.png" style="width: 6px; height: 19px;"></image><text class="q-formula-t">（</text><image src="/common/glyphs/a-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/gt-gray.png" style="width: 13px; height: 19px;"></image><image src="/common/glyphs/d0-gray.png" style="width: 9px; height: 19px;"></image><text class="q-formula-t"> 且 </text><image src="/common/glyphs/a-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/ne-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/d1-gray.png" style="width: 7px; height: 19px;"></image><text class="q-formula-t">）</text></div><div class="q-formula-r" if="{{plotType === 'log'}}"><image src="/common/glyphs/y-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/eq-gray.png" style="width: 14px; height: 19px;"></image><text class="q-formula-t"> 以 </text><image src="/common/glyphs/a-gray.png" style="width: 10px; height: 19px;"></image><text class="q-formula-t"> 为底 </text><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><text class="q-formula-t"> 的对数</text></div><div class="q-formula-r" if="{{plotType === 'abs'}}"><image src="/common/glyphs/y-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/eq-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/a-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/bar-gray.png" style="width: 3px; height: 19px;"></image><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/bar-gray.png" style="width: 3px; height: 19px;"></image></div>
      <div class="q-fields">
        <div class="q-field {{plotField === $item.key ? 'q-field-on' : ''}}" for="{{plotFieldDefs}}" onclick="setPlotField($item.key)">
          <image src="{{glyLab[$item.label]}}" style="width: {{glyLabW[$item.label]}}px; height: 19px; margin-right: 8px;"></image><text class="q-fv" style="font-size: {{pFvPx}}px;">{{$item.val ? $item.val : '0'}}</text>
        </div>
      </div>
      <div class="q-res q-res-xs">
        <text class="q-line" for="{{plotCfgLines}}">{{' ' + $item}}</text>
      </div>
      <div class="plot-btn-row">
        <div class="plot-btn" onclick="drawPlot"><text class="plot-btn-t">画图象</text></div>
      </div>
      <div class="pad pad-sm">
        <div class="key key-num key-sm key-xs" for="{{quadKeys}}" onclick="plotPad($item.v)">
          <text class="key-t key-t-num" style="font-size: 20px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 函数图象 ===== -->
    <div class="view" if="{{view === 'plot'}}">
      <div class="bar">
        <div class="bbtn" onclick="backFromPlot"><text class="bar-btn">‹ 返回</text></div>
        <text class="bar-title">函数图象</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <text class="plot-title">{{plotTitle}}</text>
      <div class="plot-box">
        <div class="axis-y" style="left: {{plotAxisL}}px;"></div>
        <div class="axis-x" style="top: {{plotAxisT}}px;"></div>
        <div class="tick-x" for="{{plotTickX}}" style="left: {{$item.ml}}px; top: {{$item.mt}}px;"></div>
        <div class="tick-y" for="{{plotTickY}}" style="left: {{$item.ml}}px; top: {{$item.mt}}px;"></div>
        <text class="tick-lab" for="{{plotLabX}}" style="left: {{$item.ll}}px; top: {{$item.lt}}px; width: 24px; text-align: {{$item.ta}};">{{$item.lab}}</text>
        <text class="tick-lab" for="{{plotLabY}}" style="left: {{$item.ll}}px; top: {{$item.lt}}px; width: 26px; text-align: {{$item.ta}};">{{$item.lab}}</text>
        <div class="dot" for="{{plotPts}}" style="left: {{$item.l}}px; top: {{$item.t}}px;"></div>
        <div class="dot dot-key" for="{{plotKeyPts}}" style="left: {{$item.l}}px; top: {{$item.t}}px;"></div>
      </div>
      <div class="q-res plot-res">
        <text class="q-line" for="{{plotLines}}">{{' ' + $item}}</text>
      </div>
    </div>

    <!-- ===== 解锁 ===== -->
    <div class="view" if="{{view === 'unlock'}}">
      <div class="bar">
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
        <text class="bar-title">解锁计算器</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <div class="u-body" if="{{!unlocked}}">
        <text class="u-line">高级版 · ¥2.5 一次解锁永久用</text>
        <text class="u-line2">计算 · 单位换算 · 解方程 · 分数 · 函数图象</text>
        <div class="un-card">
          <text class="u-code-lab">你的设备码（买密钥时发给店主）</text>
          <text class="u-code">{{devCodeDisp}}</text>
          <text class="u-code-hint">字母看不清就截图发店主确认，别猜</text>
        </div>
        <text class="u-line2">基础计算免费可用；科学键盘与工具箱需解锁，买密钥后输入下方</text>
        <div class="u-slots">
          <div class="u-slot" style="margin-left: {{$item.ml}}px;" for="{{keySlots}}">
            <text class="u-slot-t">{{$item.ch}}</text>
          </div>
        </div>
        <text class="u-msg">{{unlockMsg}}</text>
        <div class="pad pad-sm">
          <div class="key key-num key-un" for="{{unKeys}}" onclick="unPad($item.v)">
            <text class="key-t key-t-num" style="font-size: 20px;">{{$item.t}}</text>
          </div>
        </div>
        <div class="plot-btn-row">
          <div class="plot-btn u-btn" onclick="confirmUnlock"><text class="plot-btn-t">解锁</text></div>
        </div>
        <text class="u-line2" onclick="goCalc">先用基础计算 ›</text>
      </div>
      <div class="u-body u-body-ok" if="{{unlocked}}">
        <text class="u-ok">✓ 已解锁</text>
        <text class="u-line">全部功能都能用了</text>
        <div class="plot-btn-row">
          <div class="plot-btn u-btn" onclick="goCalc"><text class="plot-btn-t">开始使用</text></div>
        </div>
      </div>
    </div>

    <div class="view" if="{{view === 'history'}}">
      <div class="bar">
        <div class="bbtn" onclick="goCalc"><text class="bar-btn">‹ 返回</text></div>
        <text class="bar-title">历史记录</text>
        <div class="bar-sp"></div>
        <div class="bbtn" onclick="clearHist"><text class="bar-btn bar-btn-del">清空</text></div>
      </div>
      <text class="h-empty" if="{{!hist.length}}">还没有算过任何东西</text>
      <div class="b-rows">
        <div class="h-row2" for="{{histDisp}}" onclick="useHist($item)">
          <div class="h-top">
            <text class="h-expr2" style="font-size: {{$item.px}}px;">{{$item.expr}}</text>
            <text class="h-time" if="{{$item.time}}">{{$item.time}}</text>
          </div>
          <text class="h-res2">{{$item.sgn ? $item.sgn : "="}} {{$item.res}}</text>
        </div>
      </div>
      <div class="h-pager" if="{{hist.length > 5}}">
        <div class="h-pgbtn" onclick="histNewer"><text class="h-pgt">‹ 更新的</text></div>
        <text class="h-pginfo">{{histPageTxt}}</text>
        <div class="h-pgbtn" onclick="histOlder"><text class="h-pgt">更早的 ›</text></div>
      </div>
      <text class="foot-tip" if="{{histFew}}">点一条，把结果拿回计算器接着算</text>
    </div>

  </div>
</template>

<script>
import storage from '@system.storage'
import vibrator from '@system.vibrator'
import device from '@system.device'
import calc from '../../common/calc'
import { keyMatches, normalizeDeviceId, shortCodeForDevice } from '../../common/paykey'

const UNIT_KEYS = [
  { v: '7', label: '7' }, { v: '8', label: '8' }, { v: '9', label: '9' }, { v: 'back', label: '←' },
  { v: '4', label: '4' }, { v: '5', label: '5' }, { v: '6', label: '6' }, { v: 'C', label: 'C' },
  { v: '1', label: '1' }, { v: '2', label: '2' }, { v: '3', label: '3' }, { v: 'neg', label: '±' },
  { v: '0', label: '0' }, { v: '00', label: '00' }, { v: '.', label: '.' }, { v: 'ok', label: '带回' }
]
const QUAD_KEYS = [
  { v: '7', label: '7' }, { v: '8', label: '8' }, { v: '9', label: '9' }, { v: 'back', label: '←' },
  { v: '4', label: '4' }, { v: '5', label: '5' }, { v: '6', label: '6' }, { v: 'C', label: 'C' },
  { v: '1', label: '1' }, { v: '2', label: '2' }, { v: '3', label: '3' }, { v: 'neg', label: '±' },
  { v: '0', label: '0' }, { v: '/', label: '/' }, { v: '.', label: '.' }, { v: 'ok', label: '»' }
]
const INT_KEYS = [
  { v: '7', label: '7' }, { v: '8', label: '8' }, { v: '9', label: '9' }, { v: 'back', label: '←' },
  { v: '4', label: '4' }, { v: '5', label: '5' }, { v: '6', label: '6' }, { v: 'C', label: 'C' },
  { v: '1', label: '1' }, { v: '2', label: '2' }, { v: '3', label: '3' }, { v: 'neg', label: '±' },
  { v: '0', label: '0' }, { v: '00', label: '00' }, { v: 'ok', label: '»' }, { v: 'ok2', label: '»' }
]
const EQ_KEYS = [
  { v: '7', label: '7', fs: 20 }, { v: '8', label: '8', fs: 20 }, { v: '9', label: '9', fs: 20 }, { v: 'back', label: '←', fs: 20 },
  { v: '4', label: '4', fs: 20 }, { v: '5', label: '5', fs: 20 }, { v: '6', label: '6', fs: 20 }, { v: 'C', label: 'C', fs: 20 },
  { v: '1', label: '1', fs: 20 }, { v: '2', label: '2', fs: 20 }, { v: '3', label: '3', fs: 20 }, { v: 'x', label: 'x', fs: 20, it: true },
  { v: '0', label: '0', fs: 20 }, { v: '.', label: '.', fs: 20 }, { v: '/', label: '/', fs: 20 }, { v: '²', label: '²', fs: 24, kcls: 'eqsup-k' },
  { v: '+', label: '+', fs: 20 }, { v: '−', label: '−', fs: 20 }, { v: '×', label: '×', fs: 22 }, { v: 'y', label: 'y', fs: 20, it: true },
  { v: '(', label: '(', fs: 20 }, { v: ')', label: ')', fs: 20 }, { v: '=', label: '=', fs: 20 }, { v: 'solve', label: '解', fs: 20, cls: 'eqgo' }
]
// 输入方程的一边 → 可求值源码：补隐含乘号、代入 x 的值（t 为 null 时保留 x，不可直接求值）
function eqSideSrc(side, t, u) {
  let s = side.replace(/×/g, '*').replace(/·/g, '*').replace(/÷/g, '/').replace(/−/g, '-')
  s = s.replace(/([0-9.)²xy])(?=[xy(])/g, '$1*')
  s = s.replace(/([)²xy])(?=[0-9])/g, '$1*')
  if (t !== null && t !== undefined) s = s.replace(/x/g, '(' + t + ')')
  if (u !== null && u !== undefined) s = s.replace(/y/g, '(' + u + ')')
  return s
}
// 标准形多项式文本：a、b、c → 如「x² + 2x − 3」（系数 1 省略、0 的项跳过）
function fmtPoly(a, b, c, compact) {
  const terms = []
  const push = function (coef, sym) {
    if (coef === 0) return
    const mag = Math.abs(coef)
    // 非零系数被 DP 显示成 0 时改科学计数（1.5.11）：1e-7 级系数旧版在「整理成」行显示 0x²，与实际按二次求解矛盾；外壳改课本式（1.5.17）
    const magStr = DP(mag) === '0' ? calc.sciStr(mag.toPrecision(2)) : DP(mag)
    const body = sym ? (mag === 1 ? sym : magStr + sym) : magStr
    terms.push({ neg: coef < 0, body: body })
  }
  push(a, 'x²'); push(b, 'x'); push(c, '')
  if (!terms.length) return '0'
  let out = (terms[0].neg ? '−' : '') + terms[0].body
  for (let i = 1; i < terms.length; i++) out += terms[i].neg ? (compact ? '−' : ' − ') + terms[i].body : (compact ? '+' : ' + ') + terms[i].body
  return out
}
const FN_TOKENS = ['sin(', 'cos(', 'tan(', 'log(', 'ln(', '√(', '³√(', 'abs(']
const VAL_END = '0123456789)πe%²!°'
// 历史读回调代次（1.5.16）：loadHist 发起时领号，saveHist（clearHist 的保存也
// 走它）时递增作废全部在途读——旧版迟到的读回调会把已清空的旧记录在内存里
// 复活、或把刚存的新记录冲回旧快照（第十一轮复审以可控延迟的假 storage 时序
// 模拟实证；真机存储回调是否会如此排序未验证，列真机验收项）
let histGen = 0

// 系数格编辑：返回新值，或 'NEXT' 表示切到下一格
function editNum(cur, v, allowDot) {
  if (v === 'C') return ''
  if (v === 'back') return cur.slice(0, -1)
  if (v === 'neg') return cur.indexOf('-') === 0 ? cur.slice(1) : '-' + cur
  if (v === 'ok' || v === 'ok2') return 'NEXT'
  if (v === '/') {
    // 分数输入：最多一个 /，且分子不能为空（'' 或 '-' 时不许）
    if (cur.indexOf('/') >= 0 || cur === '' || cur === '-') return cur
    return cur + '/'
  }
  if (v === '.') {
    if (!allowDot || cur.indexOf('.') >= 0 || cur.indexOf('/') >= 0) return cur
    return (cur === '-' ? '-0' : (cur || '0')) + '.'
  }
  // 前导零：'0' 或 '-0' 后面再输数字直接替换，别留 '05' 这种
  if (cur === '0' || cur === '-0') {
    if (v === '0' || v === '00') return cur
    if (/^[1-9]$/.test(v)) return (cur.charAt(0) === '-' ? '-' : '') + v
  }
  // 分母前导零：'1/0' 后面输非零数字替换掉 0，别留 '1/05'
  if (/\/0$/.test(cur) && /^[1-9]$/.test(v)) return cur.slice(0, -1) + v
  if (cur.replace(/[^0-9]/g, '').length >= 9) return cur
  return cur + v
}
// 系数解析：支持分数写法 '1/2'、'-3/4'，按分数精确算，不先转小数
function parseCoeff(s) {
  if (s === '' || s === '-') return NaN
  if (s.indexOf('/') >= 0) {
    const p = s.split('/')
    if (p.length !== 2) return NaN
    const n = parseFloat(p[0]), d = parseFloat(p[1])
    if (isNaN(n) || isNaN(d) || d === 0) return NaN
    return n / d
  }
  return parseFloat(s)
}
// 系数框留空按 0 算（教材里不写的项就是 0，如 x²+3x 的常数项）；单独一个 '-' 是正在输入、仍算没填
function parseCoeff0(s) { return s === '' ? 0 : parseCoeff(s) }
function FD(x) { return calc.formatDisplay(x) }
// 结果串过长时逐步降精度重排，保证一行显示完、永不省略（主流计算器的做法）
function fitResStr(v, cap) {
  let s = calc.formatDisplay(v)
  if (s.length <= cap) return s
  // 纯整数太长：改科学计数法，别把精确整数四舍五入
  if (/^-?\d+$/.test(calc.formatPlain(v))) {
    let p = 10
    // 课本式外壳（1.5.17）：长度按转换后的 ×10 上标串量——新写法比 e 记法
    // 长 1–2 字，同 cap 下可能比旧版少 1 位有效数字（分级降精度，保住 cap）
    let sci = dm(calc.sciStr(v.toPrecision(p)))
    while (sci.length > cap && p > 5) { p--; sci = dm(calc.sciStr(v.toPrecision(p))) }
    // 负号过 dm 统一（1.5.16）：toPrecision 直出 ASCII '-'，须在 sciStr 之后
    // 再过 dm（指数已是上标 ⁻、dm 不会误伤）
    return sci
  }
  let p = 12
  while (s.length > cap && p > 7) { p--; s = calc.formatDisplay(Number(v.toPrecision(p))) }
  return s
}
// 结果行字号档：按显示串长度（含「= 」）选档；旁边有分数切换钮时再压一档
function fitResPx(disp, withChip) {
  const len = disp.length
  let px = len <= 12 ? 50 : (len <= 15 ? 38 : (len <= 18 ? 30 : 24))
  if (withChip && px > 30) px = 30
  // 旁边有分数切换钮时，长结果串再压一档字号，免得和钮一起挤出显示区
  if (withChip && len > 13 && px > 24) px = 24
  return px
}
// fitResStr 对 0.00x 这类小数收不到很短（前导零占位）：再按有效数字硬收一轮
function hardFit(v, cap) {
  let s = fitResStr(v, cap)
  let p = 6
  while (s.length > cap && p >= 2) { s = calc.formatDisplay(Number(v.toPrecision(p))); p-- }
  return s
}
// 答案行排版：有精确分数（分母≠1）时同行并列「名 = 分数 符号 小数」（精确在前），
// 分数与小数之间的符号走 eqSign 回读口径：显示的小数与原值严格相等用「=」（如 1/2 = 0.5），
// 被收精度截断/四舍五入了才用「≈」（如 4/27 ≈ 0.148148148148）；
// 小数按剩余宽度收精度保整行 ≤ maxLen；没有精确分数时沿用「名 符号 小数」
function ansStr(name, v, maxLen) {
  const fr = calc.toFraction(v)
  if (fr && fr.d !== 1) {
    // 分数只是容差内近似（如 1.0000000002÷3 认作 1/3）时连接号用 ≈，不许冒充精确
    //（1.5.12，ChatGPT 第八份报告实证）；精确分数维持「名 = 分数 = 小数」
    const fs = (name ? name + (calc.fracIsExact(v, fr) ? ' = ' : ' ≈ ') : (calc.fracIsExact(v, fr) ? '= ' : '≈ ')) + dm(fr.n + '/' + fr.d)
    const dec = hardFit(v, Math.max(maxLen - fs.length - 3, 4))
    if (fs.length + 3 + dec.length <= maxLen) return fs + ' ' + calc.eqSign(v, dec) + ' ' + dec
    // 分数串本身太长（极端大分子/分母）：硬塞必然被截断，退回纯小数行
  }
  return (name ? name + ' ' : '') + calc.eqSign(v) + ' ' + fitResStr(v, maxLen - (name ? name.length + 3 : 2))
}
// 复数根行：实部有精确分数时并列给出（虚部是 √Δ 的无理数、没有分数，只给小数）；
// 分数与实部小数之间的符号同样走 eqSign 回读口径（实部小数完整显示用「=」、被收精度了用「≈」）；
// 整行 ≤30 字守住不截断纪律：放不下先收虚部、再收实部小数位数，仍放不下就不加分数
function cplxStr(name, r, sign) {
  const csg = (calc.eqSign(r.re) === '=' && calc.eqSign(r.im) === '=') ? '=' : '≈'
  const fr = calc.toFraction(r.re)
  // 实部分数只认严格精确的（1.5.12）：近似分数不在复数行里冒充精确，退回纯小数行
  if (fr && fr.d !== 1 && calc.fracIsExact(r.re, fr)) {
    const fs = dm(fr.n + '/' + fr.d)
    const build = function (re, im) { return name + ' ' + csg + ' ' + fs + ' ' + calc.eqSign(r.re, re) + ' ' + re + ' ' + sign + ' ' + im + 'i' }
    let line = build(hardFit(r.re, 8), hardFit(r.im, 7))
    if (line.length > 30) line = build(hardFit(r.re, 8), hardFit(r.im, 6))
    if (line.length > 30) line = build(hardFit(r.re, 7), hardFit(r.im, 6))
    if (line.length > 30) line = build(hardFit(r.re, 7), hardFit(r.im, 5))
    if (line.length <= 30) return line
  }
  return name + ' ' + csg + ' ' + fitResStr(r.re, 11) + ' ' + sign + ' ' + fitResStr(r.im, 10) + 'i'
}
// ---------- 1.5.4 根式精确形（对齐卡西欧 fx-991 方程模式：无理根先给根式精确形、小数在后） ----------
// 显示层有理数运算（{n, d}，d > 0 已约分）：任一步超 JS 安全整数就返回 null，调用方整题回退小数显示，绝不硬凑
function gcd2(a, b) { a = Math.abs(a); b = Math.abs(b); while (b) { const t = a % b; a = b; b = t } return a }
function rMul(p, q) {
  if (!p || !q) return null
  const n = p.n * q.n, d = p.d * q.d
  if (!Number.isSafeInteger(n) || !Number.isSafeInteger(d)) return null
  if (n === 0) return { n: 0, d: 1 }
  const g = gcd2(n, d) || 1
  return { n: n / g, d: d / g }
}
function rSub(p, q) {
  if (!p || !q) return null
  const n = p.n * q.d - q.n * p.d, d = p.d * q.d
  if (!Number.isSafeInteger(n) || !Number.isSafeInteger(d)) return null
  if (n === 0) return { n: 0, d: 1 }
  const g = gcd2(n, d) || 1
  return { n: n / g, d: d / g }
}
// 系数恢复有理数（走 calc.toFraction 的精确门）并精确算出 Δ；恢复失败/超限返回 null
// exact（1.5.16）：三个系数是否都被 fracIsExact 判为严格恢复——toFraction 的
// 1e-10 容差会把 0.3333333334 认成 1/3，旧版 quadExact 只查非 null 就按 1/3
// 构造根式并以等号给出（第十一轮复审实证）；恢复不严格时调用方改 ≈ 或回退
function quadExact(a, b, c) {
  const A = calc.toFraction(a), B = calc.toFraction(b), C = calc.toFraction(c)
  if (!A || !B || !C || A.n === 0) return null
  const D = rSub(rMul(B, B), rMul(rMul(A, C), { n: 4, d: 1 }))
  if (!D) return null
  const exact = calc.fracIsExact(a, A) && calc.fracIsExact(b, B) && calc.fracIsExact(c, C)
  return { A: A, B: B, D: D, exact: exact }
}
// √|Δ| 精确化简：Δ = n/d（已约分）→ √|Δ| = s√m / d（m 无平方因子）；
// N = |n|·d 超安全整数或超化简上限（1e12）返回 null；m == 1 表示 |Δ| 是完全平方（根是有理数，不走根式）
function sqrtRat(D) {
  const N = Math.abs(D.n) * D.d
  if (!Number.isSafeInteger(N) || N > 1e12) return null
  const r = calc.simplifySqrt(N)
  if (r.error) return null
  return { s: r.coef, m: r.rad, d: D.d }
}
// 根的最简形态 (P ± Q√m)/R 文本（Q > 0、R > 0）：P == 0 不带括号、R == 1 不写分母、Q == 1 不写系数
function radTerm(P, Q, m, R, sign) {
  const rad = Q === 1 ? '√' + m : Q + '√' + m
  // 负号统一用 −（1.5.15）：旧版根式串内部用 ASCII '-'，与同行小数部分的 − 混排
  if (P === 0) return (sign < 0 ? '−' : '') + rad + (R > 1 ? '/' + R : '')
  const inner = (P < 0 ? '−' + (-P) : '' + P) + (sign > 0 ? '+' : '−') + rad
  return R === 1 ? inner : '(' + inner + ')/' + R
}
// Δ > 0 且非完全平方时，把两根组装成 (P ± Q√m)/R 并约分到最简（分子分母同除 gcd、分母取正）；
// 与 solveQuad 浮点根逐一数值自检，对不上（采样噪声/恢复失真）整组作废返回 null
function quadRadStrs(a, b, c, x1, x2) {
  const E = quadExact(a, b, c)
  if (!E || E.D.n <= 0) return null
  const sq = sqrtRat(E.D)
  if (!sq || sq.m < 2) return null
  const g0 = gcd2(E.B.d, sq.d)
  const L = (E.B.d / g0) * sq.d
  let P = -E.B.n * (L / E.B.d) * E.A.d
  let Q = sq.s * (L / sq.d) * E.A.d
  let R = L * 2 * E.A.n
  if (!Number.isSafeInteger(L) || !Number.isSafeInteger(P) || !Number.isSafeInteger(Q) || !Number.isSafeInteger(R)) return null
  const g = gcd2(gcd2(P, Q), R) || 1
  P /= g; Q /= g; R /= g
  if (R < 0) { P = -P; Q = -Q; R = -R }
  Q = Math.abs(Q)
  if (Q === 0 || R <= 0) return null
  // 根集合 {(P+Q√m)/R, (P−Q√m)/R} 与分母符号翻转无关，但哪根对应 x1 取决于 A 的符号：
  // 逐一数值配对自检（对不上整组作废），不靠符号约定硬猜
  const sqm = Math.sqrt(sq.m)
  const vPlus = (P + Q * sqm) / R, vMinus = (P - Q * sqm) / R
  const tol = function (u, v) { return Math.abs(u - v) <= 1e-9 * Math.abs(v) + 1e-12 }
  const sPlus = radTerm(P, Q, sq.m, R, 1), sMinus = radTerm(P, Q, sq.m, R, -1)
  if (tol(vPlus, x1) && tol(vMinus, x2)) return { x1: sPlus, x2: sMinus, exact: E.exact }
  if (tol(vMinus, x1) && tol(vPlus, x2)) return { x1: sMinus, x2: sPlus, exact: E.exact }
  return null
}
// 根式答案行：精确形在前、同行并列小数（连接号走 eqSign 回读口径）；
// 塞不下退到只剩精确形（精确形本身就是完整答案），再不行回落 ansStr 纯小数行
function radAnsStr(name, v, rad, maxLen, exact) {
  if (!rad) return ansStr(name, v, maxLen)
  // 系数只是容差内恢复（exact === false）时根式不是原方程的严格精确解，
  // 连接号按 eqSign 同口径改 ≈（1.5.16）；严格恢复维持等号
  const fs = (name ? name + (exact === false ? ' ≈ ' : ' = ') : (exact === false ? '≈ ' : '= ')) + rad
  const dec = hardFit(v, Math.max(maxLen - fs.length - 3, 4))
  if (fs.length + 3 + dec.length <= maxLen) return fs + ' ' + calc.eqSign(v, dec) + ' ' + dec
  if (fs.length <= maxLen) return fs
  return ansStr(name, v, maxLen)
}
// 复数根虚部根式：im = √(−Δ)/(2|A|)，化简成 (Q√m)/R 最简形态；虚部有理（m == 1）或恢复失败返回 null；
// 与浮点 im 数值自检，对不上作废
function quadImRad(a, b, c, imVal) {
  const E = quadExact(a, b, c)
  // 系数恢复不严格时虚部根式同样不是严格精确形（1.5.16）：整条回退 cplxStr
  // 小数行（其连接号走 eqSign），不以等号形式给出近似根式
  if (!E || E.D.n >= 0 || E.exact === false) return null
  const sq = sqrtRat(E.D)
  if (!sq || sq.m < 2) return null
  let Q = sq.s * E.A.d
  let R = sq.d * 2 * Math.abs(E.A.n)
  if (!Number.isSafeInteger(Q) || !Number.isSafeInteger(R)) return null
  const g = gcd2(Q, R) || 1
  Q /= g; R /= g
  if (Math.abs(Q * Math.sqrt(sq.m) / R - imVal) > 1e-9 * Math.abs(imVal) + 1e-12) return null
  return radTerm(0, Q, sq.m, R, 1)
}
// 复数根根式行：实部精确形（分数/整数）+ 虚部根式形同行（两部皆精确，连接用「=」），
// 整行 ≤30 字守住不截断纪律；实部恢复不出或放不下返回 null，调用方回落 cplxStr
function cplxRadStr(name, r, imRad, sign) {
  const fr = calc.toFraction(r.re)
  if (!fr) return null
  const reStr = dm(fr.d === 1 ? String(fr.n) : fr.n + '/' + fr.d)
  const line = name + ' = ' + reStr + ' ' + sign + ' ' + imRad + 'i'
  return line.length <= 30 ? line : null
}
// 主界面分数切换钮文案：另一形式足够短时直接显示它本身，让小数与分数同屏（点钮仍是切换）
// 看小数侧：主行分数 ≤12 字且小数串（11 字口径）≤11 字才直显，否则回落文字钮防同行溢出
function fracChipText(fracOn, frac, v, mainIsFrac) {
  if (!frac) return '看分数'
  const fs = dm(frac.n + '/' + frac.d)
  if (fracOn) {
    if (!mainIsFrac || fs.length > 12) return '看小数'
    const ds = fitResStr(v, 11)
    return ds.length <= 11 ? ds : '看小数'
  }
  return fs.length <= 7 ? fs : '看分数'
}
// 图象信息行行宽估算（像素）：汉字/全角按 19、空格按 5、其余按 10，另加模板补的首空格 5；
// 与真机验过的 30 字复数根行（估算 ≈275px）对齐，整行 ≤300 不被省略号截断。
// 上标指数字符（⁰-⁹、⁻，1.5.17）是窄字形，与普通半角同按 10 估算，别按全角 19 虚增
function linePx(s) {
  let w = 5
  for (const ch of s) w += (ch === ' ') ? 5 : ((ch.charCodeAt(0) > 255 && ch !== '−' && '⁰¹²³⁴⁵⁶⁷⁸⁹⁻'.indexOf(ch) < 0) ? 19 : 10)
  return w
}
// 图象信息行里的单个值：有精确分数（分母≠1）时并列「分数 符号 小数」，符号走 eqSign 回读口径
// （完整显示用「=」、收了精度用「≈」）；cap 是这个值允许占的字符数，放不下退回 DP 原样——
// 整数、无理数也走 DP，呈现口径不变
function pvStr(v, cap) {
  const fr = calc.toFraction(v)
  if (fr && fr.d !== 1) {
    // 近似分数带 ≈ 前缀（1.5.12，与 ansStr 同口径），多占 1 字、宽度计算同步算入
    const fs = ((calc.fracIsExact(v, fr) ? '' : '≈') + fr.n + '/' + fr.d).replace(/-/g, '−')
    const room = cap - fs.length - 3
    if (room >= 4) {
      const decA = hardFit(v, room)
      if (fs.length + 3 + decA.length <= cap) return fs + ' ' + calc.eqSign(v, decA) + ' ' + decA.replace(/-/g, '−')
    }
  }
  return DP(v)
}
// 顶点行：两个坐标都可能带分数，按行宽逐级收（两边轮流让位）；
// 接受门：先求估算 ≤300；实在不行才放宽到「不宽于同一值的 DP 原行」（带分数不比现状更宽就算安全）；都不行退回 DP 行
function vertexLine(xv, yv) {
  const dpLine = '顶点 (' + DP(xv) + ', ' + DP(yv) + ')'
  const grades = [[11, 12], [11, 8], [8, 12], [9, 9], [7, 7]]
  for (const relaxed of [false, true]) {
    for (const g of grades) {
      const s = '顶点 (' + pvStr(xv, g[0]) + ', ' + pvStr(yv, g[1]) + ')'
      if (linePx(s) <= 300 || (relaxed && linePx(s) <= linePx(dpLine))) return s
    }
  }
  return dpLine
}
// 抛物线与 x 轴交点行（解方程入口）：两个根同行，逐级收行宽（接受门同顶点行），放不下退回 DP 行；
// rads（1.5.4，可选）是两根的根式精确形：有根式时并列（精确形在前、小数在后），塞不下只给根式形，再不行回落 pvStr
function rootsLine(r1, r2, rads) {
  const fmt = function (v, rad, cap) {
    if (rad) {
      // 系数容差内恢复（rads.exact === false）时根式前加 ≈，不冒充严格精确形（1.5.16）
      const radTxt = (rads && rads.exact === false) ? '≈' + rad : rad
      const room = cap - radTxt.length - 3
      if (room >= 4) {
        const decA = hardFit(v, room)
        if (radTxt.length + 3 + decA.length <= cap) return (radTxt + ' ' + calc.eqSign(v, decA) + ' ' + decA).replace(/-/g, '−')
      }
      if (radTxt.length <= cap) return radTxt.replace(/-/g, '−')
    }
    return pvStr(v, cap)
  }
  const dpLine = '与 x 轴交点 x = ' + DP(r1) + '、' + DP(r2)
  const grades = [[12, 12], [12, 8], [8, 12], [9, 9], [7, 7]]
  for (const relaxed of [false, true]) {
    for (const g of grades) {
      const s = '与 x 轴交点 x = ' + fmt(r1, rads ? rads.x1 : null, g[0]) + '、' + fmt(r2, rads ? rads.x2 : null, g[1])
      if (linePx(s) <= 300 || (relaxed && linePx(s) <= linePx(dpLine))) return s
    }
  }
  return dpLine
}
// 一次方程图象的根行：根有分数时并列给出——此时去掉「（就是方程的解）」后缀，
// 否则整行必被截断；根没有分数时保持原行不变
function linRootLine(root) {
  const s = '与 x 轴交点 x = ' + pvStr(root, 15)
  if (s.indexOf('/') >= 0) return s
  return '与 x 轴交点 x = ' + DP(root) + '（就是方程的解）'
}
// 三角函数信息行：周期行不变；振幅在振幅处给分数、小数在同行的最高/最低处出现（同一值同行双显），
// 整行放不下时逐级收最高/最低的小数精度，再放不下退回原行；|A| ≥ 10000 的 DA 分支行短，振幅处直接并列
function trigInfoLines(A) {
  const aA = Math.abs(A)
  const lines = ['周期 360°（一个完整波形）']
  if (aA >= 10000) {
    let amp = DA(aA)
    const fr = calc.toFraction(aA)
    if (fr && fr.d !== 1) amp = (calc.fracIsExact(aA, fr) ? '' : '≈') + fr.n + '/' + fr.d + ' ' + calc.eqSign(aA, amp) + ' ' + amp
    lines.push('振幅 ' + amp)
    lines.push('最高 ' + DA(aA) + '、最低 ' + DA(-aA))
    return lines
  }
  const mx = DP(aA), mn = DP(-aA)
  const orig = '振幅 ' + mx + '，最高 ' + mx + '、最低 ' + mn
  const fr = calc.toFraction(aA)
  if (fr && fr.d !== 1) {
    const fs = ((calc.fracIsExact(aA, fr) ? '' : '≈') + fr.n + '/' + fr.d).replace(/-/g, '−')
    const grades = [[0, 0], [6, 7], [5, 6], [4, 5]]
