<template>
  <div class="page">

    <!-- ===== 主页：计算器（标准/科学双键盘） ===== -->
    <div class="view" if="{{view === 'calc'}}">
      <div class="topbar">
        <text class="top-title">计算器</text>
        <div class="top-btn" onclick="openTools"><text class="top-btn-t">工具箱</text></div>
        <div class="top-btn" onclick="openHistory"><text class="top-btn-t">历史</text></div>
      </div>
      <div class="disp">
        <text class="expr" style="font-size: {{exprPx}}px;">{{exprDisp}}</text>
        <div class="res-row">
          <text class="res" style="font-size: {{resPx}}px; color: {{previewOk ? '#5F7E99' : '#9AA6B4'}};">{{resDisp}}</text>
          <div class="frac-chip" if="{{canFrac}}" onclick="toggleFrac">
            <text class="frac-chip-t">{{chipText}}</text>
          </div>
        </div>
      </div>
      <div class="pad" if="{{padPage === 'main'}}">
        <div class="key {{'key-' + $item.cls}}" for="{{keys}}" onclick="pressKey($item.v)">
          <text class="key-t {{'key-t-' + $item.cls}}" style="font-size: {{$item.fs}}px;">{{$item.label}}</text>
        </div>
      </div>
      <div class="pad" if="{{padPage === 'sci'}}">
        <div class="key {{'key-' + $item.cls}}" for="{{sciKeys}}" onclick="pressKey($item.v)">
          <text class="key-t {{'key-t-' + $item.cls}}" style="font-size: {{$item.fs}}px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 工具箱 ===== -->
    <div class="view" if="{{view === 'tools'}}">
      <div class="bar">
        <div class="bbtn" onclick="goCalc"><text class="bar-btn">‹ 返回</text></div>
        <text class="bar-title">工具箱</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <list class="tool-list">
        <list-item type="trow" class="tool-row" for="{{tools}}" onclick="openTool($item.id)">
          <text class="tool-ico">{{$item.ico}}</text>
          <div class="tool-main">
            <text class="tool-name">{{$item.name}}</text>
            <text class="tool-desc">{{$item.desc}}</text>
          </div>
          <text class="tool-arrow">›</text>
        </list-item>
      </list>
      <text class="foot-tip">为小初高同学备的工具 · 输入少、结果短</text>
    </div>

    <!-- ===== 单位换算 ===== -->
    <div class="view" if="{{view === 'unit'}}">
      <div class="bar">
        <div class="bbtn" onclick="goTools"><text class="bar-btn">‹ 工具箱</text></div>
        <text class="bar-title">单位换算</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <div class="chip-row">
        <div class="chip {{catName === $item.name ? 'chip-on' : ''}}" for="{{unitCats}}" onclick="setCat($item.name)">
          <text class="chip-t {{catName === $item.name ? 'chip-t-on' : ''}}">{{$item.name}}</text>
        </div>
      </div>
      <div class="u-card">
        <div class="u-pick" onclick="pickUnit('from')"><text class="u-pick-t">{{unitFromName}} ▼</text></div>
        <text class="u-val" style="font-size: {{unitValPx}}px;">{{unitVal ? unitVal : '0'}}</text>
      </div>
      <div class="swap-row">
        <div class="swap-btn" onclick="swapUnits"><text class="swap-t">交换</text></div>
        <div class="swap-btn swap-btn2" if="{{unitRes}}" onclick="unitCarryBack"><text class="swap-t">带回计算</text></div>
      </div>
      <div class="u-card">
        <div class="u-pick" onclick="pickUnit('to')"><text class="u-pick-t">{{unitToName}} ▼</text></div>
        <text class="u-val u-val-res" style="font-size: {{unitResPx}}px;">{{unitRes ? unitRes : '—'}}</text>
      </div>
      <div class="pad pad-sm">
        <div class="key key-num key-sm" for="{{numKeys}}" onclick="unitPad($item.v)">
          <text class="key-t key-t-num" style="font-size: 22px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 选单位 ===== -->
    <div class="view" if="{{view === 'unitpick'}}">
      <div class="bar">
        <div class="bbtn" onclick="backToUnit"><text class="bar-btn">‹ 返回</text></div>
        <text class="bar-title">选择单位</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <list class="pick-list">
        <list-item type="prow" class="pick-row" for="{{pickUnits}}" onclick="applyPick($item.id)">
          <text class="pick-t">{{$item.name}}</text>
          <text class="pick-on" if="{{$item.id === pickCur}}">当前</text>
        </list-item>
      </list>
    </div>

    <!-- ===== 进制转换 ===== -->
    <div class="view" if="{{view === 'base'}}">
      <div class="bar">
        <div class="bbtn" onclick="goTools"><text class="bar-btn">‹ 工具箱</text></div>
        <text class="bar-title">进制转换</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <div class="chip-row">
        <div class="chip {{fromBase === $item.b ? 'chip-on' : ''}}" for="{{baseChips}}" onclick="setBase($item.b)">
          <text class="chip-t {{fromBase === $item.b ? 'chip-t-on' : ''}}">{{$item.name}}</text>
        </div>
      </div>
      <div class="b-inwrap">
        <text class="b-label">输入（{{baseName}}）</text>
        <text class="b-in" style="font-size: {{baseInPx}}px;">{{baseVal ? baseVal : '0'}}</text>
        <text class="b-err" if="{{baseErr}}">{{baseErr}}</text>
      </div>
      <div class="b-rows">
        <div class="b-row" for="{{baseRows}}">
          <text class="b-row-k">{{$item.k}}</text>
          <text class="b-row-v" style="font-size: {{$item.px}}px;">{{$item.v}}</text>
        </div>
      </div>
      <div class="pad pad-base">
        <div class="key key-num key-b" for="{{baseKeys}}" onclick="basePad($item.v)">
          <text class="key-t key-t-num" style="font-size: 19px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 解方程菜单 ===== -->
    <div class="view" if="{{view === 'solvers'}}">
      <div class="bar">
        <div class="bbtn" onclick="goTools"><text class="bar-btn">‹ 工具箱</text></div>
        <text class="bar-title">解方程</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <div class="tool-list2">
        <div class="tool-row" for="{{solverMenu}}" onclick="openSolver($item.id)">
          <text class="tool-ico">{{$item.ico}}</text>
          <div class="tool-main">
            <text class="tool-name">{{$item.name}}</text>
            <text class="tool-desc">{{$item.desc}}</text>
          </div>
          <text class="tool-arrow">›</text>
        </div>
      </div>
      <text class="foot-tip">填系数就能解，还能看函数图象</text>
    </div>

    <!-- ===== 一次方程 ===== -->
    <div class="view" if="{{view === 'lin'}}">
      <div class="bar">
        <div class="bbtn" onclick="goSolvers"><text class="bar-btn">‹ 解方程</text></div>
        <text class="bar-title">一次方程</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <div class="q-formula-r"><image src="/common/glyphs/a-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/plus-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/b-gray.png" style="width: 8px; height: 19px;"></image><image src="/common/glyphs/eq-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/c-gray.png" style="width: 8px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/plus-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/d-gray.png" style="width: 10px; height: 19px;"></image></div>
      <div class="q-fields q-fields-abs">
        <div class="q-field q-field-w qf-w1 {{lField === 'a' ? 'q-field-on' : ''}}" onclick="setLField('a')">
          <image src="/common/glyphs/a-blue.png" style="width: 10px; height: 19px; margin-right: 8px;"></image><text class="q-fv" style="font-size: {{lFvPx}}px;">{{la ? la : '0'}}</text>
        </div>
        <div class="q-field q-field-w qf-w2 {{lField === 'b' ? 'q-field-on' : ''}}" onclick="setLField('b')">
          <image src="/common/glyphs/b-blue.png" style="width: 8px; height: 19px; margin-right: 8px;"></image><text class="q-fv" style="font-size: {{lFvPx}}px;">{{lb ? lb : '0'}}</text>
        </div>
      </div>
      <div class="q-fields q-fields-abs">
        <div class="q-field q-field-w qf-w1 {{lField === 'c' ? 'q-field-on' : ''}}" onclick="setLField('c')">
          <image src="/common/glyphs/c-blue.png" style="width: 8px; height: 19px; margin-right: 8px;"></image><text class="q-fv" style="font-size: {{lFvPx}}px;">{{lc ? lc : '0'}}</text>
        </div>
        <div class="q-field q-field-w qf-w2 {{lField === 'd' ? 'q-field-on' : ''}}" onclick="setLField('d')">
          <image src="/common/glyphs/d-blue.png" style="width: 10px; height: 19px; margin-right: 8px;"></image><text class="q-fv" style="font-size: {{lFvPx}}px;">{{ld ? ld : '0'}}</text>
        </div>
      </div>
      <div class="q-res q-res-s">
        <text class="q-line" for="{{lLines}}">{{' ' + $item}}</text>
      </div>
      <div class="plot-btn-row" if="{{lCanPlot}}">
        <div class="plot-btn" onclick="openPlot('lin')"><text class="plot-btn-t">看图象</text></div>
      </div>
      <div class="pad pad-sm">
        <div class="key key-num key-sm key-c5 {{$item.kcls ? $item.kcls : ''}}" for="{{quadKeys}}" onclick="linPad($item.v)">
          <text class="key-t key-t-num" style="font-size: 22px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 二次方程 ===== -->
    <div class="view" if="{{view === 'quad'}}">
      <div class="bar">
        <div class="bbtn" onclick="goSolvers"><text class="bar-btn">‹ 解方程</text></div>
        <text class="bar-title">二次方程</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <div class="q-formula-r"><image src="/common/glyphs/a-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/sup2-gray.png" style="width: 6px; height: 19px;"></image><image src="/common/glyphs/plus-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/b-gray.png" style="width: 8px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/plus-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/c-gray.png" style="width: 8px; height: 19px;"></image><image src="/common/glyphs/eq-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/d0-gray.png" style="width: 9px; height: 19px;"></image></div>
      <div class="q-fields q-fields-abs q-fields-sys">
        <div class="q-field qf-1 {{qField === 'a' ? 'q-field-on' : ''}}" onclick="setQField('a')">
          <image src="/common/glyphs/a-blue.png" style="width: 10px; height: 19px; margin-right: 8px;"></image><text class="q-fv" style="font-size: {{qFvPx}}px;">{{qa ? qa : '0'}}</text>
        </div>
        <div class="q-field qf-2 {{qField === 'b' ? 'q-field-on' : ''}}" onclick="setQField('b')">
          <image src="/common/glyphs/b-blue.png" style="width: 8px; height: 19px; margin-right: 8px;"></image><text class="q-fv" style="font-size: {{qFvPx}}px;">{{qb ? qb : '0'}}</text>
        </div>
        <div class="q-field qf-3 {{qField === 'c' ? 'q-field-on' : ''}}" onclick="setQField('c')">
          <image src="/common/glyphs/c-blue.png" style="width: 8px; height: 19px; margin-right: 8px;"></image><text class="q-fv" style="font-size: {{qFvPx}}px;">{{qc ? qc : '0'}}</text>
        </div>
      </div>
      <div class="q-res">
        <text class="q-line" for="{{qLines}}">{{' ' + $item}}</text>
      </div>
      <div class="plot-btn-row" if="{{qCanPlot}}">
        <div class="plot-btn" onclick="openPlot('quad')"><text class="plot-btn-t">看图象（抛物线）</text></div>
      </div>
      <div class="pad pad-sm">
        <div class="key key-num key-sm key-c5 {{$item.kcls ? $item.kcls : ''}}" for="{{quadKeys}}" onclick="quadPad($item.v)">
          <text class="key-t key-t-num" style="font-size: 22px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 二元一次方程组 ===== -->
    <div class="view" if="{{view === 'sys'}}">
      <div class="bar">
        <div class="bbtn" onclick="goSolvers"><text class="bar-btn">‹ 解方程</text></div>
        <text class="bar-title">方程组</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <div class="q-formula-r"><image src="/common/glyphs/a-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/sub1-gray.png" style="width: 5px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/plus-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/b-gray.png" style="width: 8px; height: 19px;"></image><image src="/common/glyphs/sub1-gray.png" style="width: 5px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/y-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/eq-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/c-gray.png" style="width: 8px; height: 19px;"></image><image src="/common/glyphs/sub1-gray.png" style="width: 5px; height: 19px;"></image></div>
      <div class="q-fields q-fields-abs q-fields-sys">
        <div class="q-field qf-1 {{sField === 'a1' ? 'q-field-on' : ''}}" onclick="setSField('a1')">
          <image src="/common/glyphs/a-blue.png" style="width: 10px; height: 19px;"></image><text class="q-fl-d">1</text><text class="q-fv" style="font-size: {{sFvPx}}px;">{{s1a ? s1a : '0'}}</text>
        </div>
        <div class="q-field qf-2 {{sField === 'b1' ? 'q-field-on' : ''}}" onclick="setSField('b1')">
          <image src="/common/glyphs/b-blue.png" style="width: 8px; height: 19px;"></image><text class="q-fl-d">1</text><text class="q-fv" style="font-size: {{sFvPx}}px;">{{s1b ? s1b : '0'}}</text>
        </div>
        <div class="q-field qf-3 {{sField === 'c1' ? 'q-field-on' : ''}}" onclick="setSField('c1')">
          <image src="/common/glyphs/c-blue.png" style="width: 8px; height: 19px;"></image><text class="q-fl-d">1</text><text class="q-fv" style="font-size: {{sFvPx}}px;">{{s1c ? s1c : '0'}}</text>
        </div>
      </div>
      <div class="q-formula-r"><image src="/common/glyphs/a-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/sub2-gray.png" style="width: 6px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/x-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/plus-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/b-gray.png" style="width: 8px; height: 19px;"></image><image src="/common/glyphs/sub2-gray.png" style="width: 6px; height: 19px;"></image><image src="/common/glyphs/dot-gray.png" style="width: 4px; height: 19px;"></image><image src="/common/glyphs/y-gray.png" style="width: 10px; height: 19px;"></image><image src="/common/glyphs/eq-gray.png" style="width: 14px; height: 19px;"></image><image src="/common/glyphs/c-gray.png" style="width: 8px; height: 19px;"></image><image src="/common/glyphs/sub2-gray.png" style="width: 6px; height: 19px;"></image></div>
      <div class="q-fields q-fields-abs q-fields-sys">
        <div class="q-field qf-1 {{sField === 'a2' ? 'q-field-on' : ''}}" onclick="setSField('a2')">
          <image src="/common/glyphs/a-blue.png" style="width: 10px; height: 19px;"></image><text class="q-fl-d">2</text><text class="q-fv" style="font-size: {{sFvPx}}px;">{{s2a ? s2a : '0'}}</text>
        </div>
        <div class="q-field qf-2 {{sField === 'b2' ? 'q-field-on' : ''}}" onclick="setSField('b2')">
          <image src="/common/glyphs/b-blue.png" style="width: 8px; height: 19px;"></image><text class="q-fl-d">2</text><text class="q-fv" style="font-size: {{sFvPx}}px;">{{s2b ? s2b : '0'}}</text>
        </div>
        <div class="q-field qf-3 {{sField === 'c2' ? 'q-field-on' : ''}}" onclick="setSField('c2')">
          <image src="/common/glyphs/c-blue.png" style="width: 8px; height: 19px;"></image><text class="q-fl-d">2</text><text class="q-fv" style="font-size: {{sFvPx}}px;">{{s2c ? s2c : '0'}}</text>
        </div>
      </div>
      <div class="q-res">
        <text class="q-line" for="{{sLines}}">{{' ' + $item}}</text>
      </div>
      <div class="pad pad-sm">
        <div class="key key-num key-sm key-sys key-c5 {{$item.kcls ? $item.kcls : ''}}" for="{{quadKeys}}" onclick="sysPad($item.v)">
          <text class="key-t key-t-num" style="font-size: 22px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 分数计算 ===== -->
    <div class="view" if="{{view === 'frac'}}">
      <div class="bar">
        <div class="bbtn" onclick="goTools"><text class="bar-btn">‹ 工具箱</text></div>
        <text class="bar-title">分数计算</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <div class="f-grid">
        <div class="f-col">
          <div class="q-field f-cell f-cell-t {{fField === 'n1' ? 'q-field-on' : ''}}" onclick="setFField('n1')">
            <text class="q-fv f-fv" style="font-size: {{fFvPx}}px;">{{fn1 ? fn1 : '0'}}</text>
          </div>
          <div class="f-line"></div>
          <div class="q-field f-cell f-cell-b {{fField === 'd1' ? 'q-field-on' : ''}}" onclick="setFField('d1')">
            <text class="q-fv f-fv" style="font-size: {{fFvPx}}px;">{{fd1 ? fd1 : '0'}}</text>
          </div>
        </div>
        <text class="f-op">{{fopSym}}</text>
        <div class="f-col">
          <div class="q-field f-cell f-cell-t {{fField === 'n2' ? 'q-field-on' : ''}}" onclick="setFField('n2')">
            <text class="q-fv f-fv" style="font-size: {{fFvPx}}px;">{{fn2 ? fn2 : '0'}}</text>
          </div>
          <div class="f-line"></div>
          <div class="q-field f-cell f-cell-b {{fField === 'd2' ? 'q-field-on' : ''}}" onclick="setFField('d2')">
            <text class="q-fv f-fv" style="font-size: {{fFvPx}}px;">{{fd2 ? fd2 : '0'}}</text>
          </div>
        </div>
      </div>
      <div class="chip-row f-ops">
        <div class="chip {{fop === $item.v ? 'chip-on' : ''}}" for="{{fopChips}}" onclick="setFop($item.v)">
          <text class="chip-t {{fop === $item.v ? 'chip-t-on' : ''}}">{{$item.label}}</text>
        </div>
      </div>
      <div class="q-res f-res">
        <text class="q-line" for="{{fLines}}">{{' ' + $item}}</text>
      </div>
      <div class="pad pad-sm">
        <div class="key key-num key-sm key-xs" for="{{intKeys}}" onclick="fracPad($item.v)">
          <text class="key-t key-t-num" style="font-size: 22px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 根号化简 ===== -->
    <div class="view" if="{{view === 'sqrt'}}">
      <div class="bar">
        <div class="bbtn" onclick="goTools"><text class="bar-btn">‹ 工具箱</text></div>
        <text class="bar-title">根号化简</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <div class="u-card sqrt-card">
        <text class="sqrt-sym">√</text>
        <text class="u-val">{{sqrtN ? sqrtN : '0'}}</text>
      </div>
      <div class="q-res sqrt-res">
        <text class="q-line" for="{{sqrtLines}}">{{' ' + $item}}</text>
      </div>
      <div class="pad pad-sm">
        <div class="key key-num key-sm" for="{{intKeys}}" onclick="sqrtPad($item.v)">
          <text class="key-t key-t-num" style="font-size: 22px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 公约数公倍数 ===== -->
    <div class="view" if="{{view === 'gcd'}}">
      <div class="bar">
        <div class="bbtn" onclick="goTools"><text class="bar-btn">‹ 工具箱</text></div>
        <text class="bar-title">公约数 · 公倍数</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <text class="q-formula">输入两个整数</text>
      <div class="q-fields">
        <div class="q-field q-field-w {{gField === 'a' ? 'q-field-on' : ''}}" onclick="setGField('a')">
          <text class="q-fl">甲</text><text class="q-fv" style="font-size: {{gFvPx}}px;">{{ga ? ga : '0'}}</text>
        </div>
        <div class="q-field q-field-w {{gField === 'b' ? 'q-field-on' : ''}}" onclick="setGField('b')">
          <text class="q-fl">乙</text><text class="q-fv" style="font-size: {{gFvPx}}px;">{{gb ? gb : '0'}}</text>
        </div>
      </div>
      <div class="q-res q-res-s">
        <text class="q-line" for="{{gLines}}">{{' ' + $item}}</text>
      </div>
      <div class="pad pad-sm">
        <div class="key key-num key-sm" for="{{intKeys}}" onclick="gcdPad($item.v)">
          <text class="key-t key-t-num" style="font-size: 22px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 三角形面积 ===== -->
    <div class="view" if="{{view === 'tri'}}">
      <div class="bar">
        <div class="bbtn" onclick="goTools"><text class="bar-btn">‹ 工具箱</text></div>
        <text class="bar-title">三角形面积</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
