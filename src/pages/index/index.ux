          <text class="key-t key-t-num" style="font-size: 22px;">{{$item.label}}</text>
        </div>
      </div>
    </div>

    <!-- ===== 输入方程（自由输入） ===== -->
    <div class="view" if="{{view === 'eqin'}}">
      <div class="bar">
        <div class="bbtn" onclick="goSolvers"><text class="bar-btn">‹ 解方程</text></div>
        <text class="bar-title">输入方程</text>
        <div class="bbtn-ghost"><text class="bar-btn">　</text></div>
      </div>
      <div class="u-card eq-card {{eqShow2 ? 'eq-card-s' : ''}} {{eqFocus === 1 ? 'eq-on' : ''}}" onclick="setEqFocus(1)">
        <div class="eq-chars" if="{{eqExpr}}">
          <image if="{{$item === 'x'}}" for="{{eqChars1}}" src="/common/glyphs/x-dark.png" style="width: {{eqImgW}}px; height: {{eqPx}}px;"></image><image if="{{$item === 'y'}}" for="{{eqChars1}}" src="/common/glyphs/y-dark.png" style="width: {{eqImgW}}px; height: {{eqPx}}px;"></image><text if="{{$item !== 'x' && $item !== 'y' && $item !== '²'}}" class="eq-ch" style="font-size: {{eqPx}}px;" for="{{eqChars1}}">{{$item}}</text><text if="{{$item === '²'}}" class="eq-ch eq-sup" style="font-size: {{eqSupPx}}px;" for="{{eqChars1}}">{{$item}}</text>
        </div>
