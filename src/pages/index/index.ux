      { v: '4', label: '4', cls: 'num', fs: 25 }, { v: '5', label: '5', cls: 'num', fs: 25 }, { v: '6', label: '6', cls: 'num', fs: 25 }, { v: 'neg', label: '±', cls: 'fn', fs: 25 }, { v: '−', label: '−', cls: 'op', fs: 27 },
      { v: '1', label: '1', cls: 'num', fs: 25 }, { v: '2', label: '2', cls: 'num', fs: 25 }, { v: '3', label: '3', cls: 'num', fs: 25 }, { v: 'π', label: 'π', cls: 'fn', fs: 23 }, { v: '+', label: '+', cls: 'op', fs: 27 },
      { v: 'fx', label: 'fx', cls: 'fn', fs: 21 }, { v: '0', label: '0', cls: 'num', fs: 25 }, { v: '.', label: '.', cls: 'num', fs: 25 }, { v: 'ans', label: 'Ans', cls: 'fn', fs: 19 }, { v: 'eq', label: '=', cls: 'eq', fs: 27 }
    ],
    sciKeys: [],
    tools: [
      { id: 'unit', ico: '⇄', name: '单位换算', desc: '长度 重量 面积 温度 时间 数据' },
      { id: 'base', ico: '01', name: '进制转换', desc: '二 / 八 / 十 / 十六进制互转' },
      { id: 'solvers', ico: 'x=', name: '解方程', desc: '一次 · 二次 · 二元一次方程组' },
      { id: 'plot', ico: 'f(x)', name: '函数图象', desc: '一次 二次 反比例 三角 指数 对数' },
      { id: 'frac', ico: '½', name: '分数计算', desc: '填分子分母做四则，约分带分数' },
      { id: 'sqrt', ico: '√', name: '根号化简', desc: '√12 = 2√3，一眼看懂' },
      { id: 'gcd', ico: '公', name: '公约数 · 公倍数', desc: '最大公约数与最小公倍数' },
      { id: 'tri', ico: '△', name: '三角形面积', desc: '输入三条边，算面积' },
      { id: 'circ', ico: '○', name: '圆', desc: '半径算周长和面积 · 结果带 π' },
      { id: 'rtri', ico: '90°', name: '解直角三角形', desc: '角 C 是直角，填任意两个量' },
      { id: 'law', ico: '弦', name: '正弦 · 余弦定理', desc: '任意三角形，填任意三个量' },
      { id: 'perm', ico: '排', name: '排列组合', desc: 'A(n,r) 与 C(n,r)，整数精确算' },
      { id: 'seq', ico: '列', name: '等差 · 等比数列', desc: '填首项与公差 / 公比，求项与和' },
      { id: 'history', ico: '≡', name: '历史记录', desc: '最近 5 条，带时间，点一条接着算' }
    ],
    solverMenu: [
      { id: 'lin', ico: 'x', name: '一次方程', desc: 'a·x + b = c·x + d' },
      { id: 'quad', ico: 'x²', name: '二次方程', desc: '判别式与两根，还能看抛物线' },
      { id: 'sys', ico: 'xy', name: '二元一次方程组', desc: '两行系数一起解 x 和 y' },
      { id: 'eqin', ico: 'x=', name: '输入方程', desc: '敲方程或算式，如 2x+3=7' }
    ],
    unitCats: calc.UNIT_CATS,
    catIdx: 0,
    catName: '长度',
    unitFromId: 'm',
    unitToId: 'km',
    unitFromName: '米',
    unitToName: '千米',
    unitVal: '1',
    unitRes: '',
    numKeys: UNIT_KEYS,
    pickTarget: 'from',
    pickUnits: [],
    pickCur: '',
    baseChips: [
      { b: 10, name: '十进制' }, { b: 2, name: '二进制' }, { b: 8, name: '八进制' }, { b: 16, name: '十六进制' }
    ],
    fromBase: 10,
    baseName: '十进制',
    baseVal: '255',
    baseErr: '',
    baseRows: [],
    baseKeys: [],
    la: '2', lb: '3', lc: '0', ld: '7',
    lField: 'a',
    lLines: [],
    lCanPlot: false,
    qa: '1', qb: '-3', qc: '2',
    qField: 'a',
    qLines: [],
    qCanPlot: false,
    quadKeys: QUAD_KEYS,
    eqKeys: EQ_KEYS,
    eqExpr: '',
    eqExpr2: '',
    glyLab: { a: '/common/glyphs/a-blue.png', b: '/common/glyphs/b-blue.png', c: '/common/glyphs/c-blue.png', k: '/common/glyphs/k-blue.png', A: '/common/glyphs/A-blue.png' },
    glyLabW: { a: 10, b: 8, c: 8, k: 9, A: 14 },
    eqPx: 25, eqSupPx: 16, eqImgW: 13,
    lFvPx: 20, qFvPx: 20, sFvPx: 20, gFvPx: 20, fFvPx: 20, pFvPx: 20,
    unitValPx: 27, unitResPx: 27, baseInPx: 23,
    eqChars1: [],
    eqChars2: [],
    eqFocus: 1,
    eqShow2: false,
    eqLines: ['敲方程或算式，点「解」', '例：2x+3=7、(1+2)²'],
    s1a: '1', s1b: '1', s1c: '3', s2a: '1', s2b: '-1', s2c: '1',
    sField: 'a1',
    sLines: [],
    fn1: '1', fd1: '2', fn2: '1', fd2: '3',
    fop: '+',
    fopSym: '+',
    fopChips: [
      { v: '+', label: '+' }, { v: '-', label: '−' }, { v: '*', label: '×' }, { v: '/', label: '÷' }
    ],
    fField: 'n1',
    fLines: [],
    intKeys: INT_KEYS,
    sqrtN: '12',
    sqrtLines: [],
    ga: '12', gb: '18',
    gField: 'a',
    gLines: [],
    ta: '3', tb: '4', tc: '5',
    tField: 'a',
    tLines: [],
    tFvPx: 20,
    cr: '1',
    cLines: [],
    cFvPx: 20,
    plotTitle: '',
    plotPts: [],
    plotKeyPts: [],
    plotTickX: [],
    plotTickY: [],
    plotLabX: [],
    plotLabY: [],
    unlocked: false,
    deviceId: '',
    devCodeDisp: '读取中…',
    keyInput: '',
    keyDisp: '_____ _____',
    keySlots: [{ ch: '', ml: 0 }, { ch: '', ml: 3 }, { ch: '', ml: 3 }, { ch: '', ml: 3 }, { ch: '', ml: 3 }, { ch: '', ml: 12 }, { ch: '', ml: 3 }, { ch: '', ml: 3 }, { ch: '', ml: 3 }, { ch: '', ml: 3 }],
    unlockMsg: '',
    // 2026-11-15 自查 C7：被拦下时记下的待去目标（'tool:<id>' / 'solver:<id>' /
    // 'plot:<kind>' / 'tools' / 'solvers' / 'history' / 'sci' / 'plotcfg'），
    // 解锁成功后直达；无目标时维持原状（停在解锁页成功态）。
    unlockTarget: null,
    unKeys: [
      { v: '1', t: '1' }, { v: '2', t: '2' }, { v: '3', t: '3' }, { v: '4', t: '4' },
      { v: '5', t: '5' }, { v: '6', t: '6' }, { v: '7', t: '7' }, { v: '8', t: '8' },
      { v: '9', t: '9' }, { v: 'del', t: '删' }, { v: '0', t: '0' }, { v: 'clr', t: '清空' }
    ],
    plotAxisL: -10,
    plotAxisT: -10,
    plotLines: [],
    plotBack: 'quad',
    plotTypeChips: PLOT_TYPES,
    plotType: 'quad2',
    plotFormula: '',
    plotFieldDefs: [],
    plotField: 'a',
    plotVals: { k: '1', b: '0', a: '1', c: '0', A: '1' },
    plotCfgLines: ['填好系数，点「画图象」']
  },

  buildSciKeys() {
    // 科学键盘 24 键（1.6.0）：e 键恢复——课本式 ×10 显示已消除与 e 记法的混淆源头，高中考题离不开 e；另补 π、%、Ans
    this.sciKeys = [
      { v: 'sin(', label: 'sin', cls: 'fn', fs: 18 }, { v: 'cos(', label: 'cos', cls: 'fn', fs: 18 }, { v: 'tan(', label: 'tan', cls: 'fn', fs: 18 }, { v: 'log(', label: 'log', cls: 'fn', fs: 18 }, { v: 'ln(', label: 'ln', cls: 'fn', fs: 19 },
      { v: '√(', label: '√', cls: 'fn', fs: 23 }, { v: '³√(', label: '³√', cls: 'fn', fs: 20 }, { v: '²', label: 'x²', cls: 'fn', fs: 19 }, { v: '^', label: 'xʸ', cls: 'fn', fs: 19 }, { v: '!', label: 'n!', cls: 'fn', fs: 19 },
      { v: 'abs(', label: 'abs', cls: 'fn', fs: 18 }, { v: '°', label: '°', cls: 'fn', fs: 23 }, { v: '(', label: '(', cls: 'fn', fs: 25 }, { v: ')', label: ')', cls: 'fn', fs: 25 }, { v: 'back', label: '←', cls: 'fn', fs: 23 },
      { v: 'π', label: 'π', cls: 'fn', fs: 23 }, { v: 'e', label: 'e', cls: 'fn', fs: 23 }, { v: '%', label: '%', cls: 'fn', fs: 23 }, { v: 'ans', label: 'Ans', cls: 'fn', fs: 19 }, { v: 'C', label: 'C', cls: 'fnr', fs: 23 },
      { v: '123', label: '123', cls: 'op', fs: 19 }, { v: 'deg', label: this.degMode ? '角度制' : '弧度制', cls: 'op', fs: 15 }, { v: 'x10', label: '×10ˣ', cls: 'fn', fs: 16 }, { v: 'eq', label: '=', cls: 'eq', fs: 27 }
    ]
  },
  onInit() {
    // 跨页回程优先走路由参数：参数在页面创建时同步注入，首帧即直达工具箱，
    // 不闪计算器主页（2026-11-15 真机反馈修复）。下面的存储读是参数缺失时的兜底。
    if (this.backto === 'tools') this.view = 'tools'
    this.buildSciKeys()
    this.loadHist()
    // 从第二页（pages/tools2）返回时直达工具箱（跨页 replace 导航的回程约定）
    // 2026-11-15 第十六轮复审：参数已指定回工具箱时跳过存储读，防旧值竞态。
    const selfBt = this
    if (this.backto !== 'tools') try {
      storage.get({
        key: 'calc_back_to',
        success: function (data) {
          if (data === 'tools') selfBt.view = 'tools'
          try { storage.set({ key: 'calc_back_to', value: '' }) } catch (e) {}
        },
        fail: function () {}
      })
    } catch (e) {}
    this.fetchDeviceId()
    this.buildBaseKeys()
    this.unitCompute()
    this.baseCompute()
    this.linSolve()
    this.quadSolve()
    this.sysSolve()
    this.fracSolve()
    this.sqrtSolve()
    this.gcdSolve()
    this.triSolve()
    this.circSolve()
    this.syncPlotFields()
    this.refreshCalc()
  },
  onShow() { this.loadHist() },

  buzz() {
    try { vibrator.vibrate({ mode: 'short' }) } catch (e) {}
  },
  onBackPress() {
    if (this.view === 'unlock') { this.view = 'calc'; return true }
    if (this.view === 'calc') {
      if (this.padPage === 'sci') { this.padPage = 'main'; return true }
      return false
    }
    this.buzz()
    if (this.view === 'tools' || this.view === 'history') this.view = 'calc'
    else if (this.view === 'unitpick') this.view = 'unit'
    else if (this.view === 'solvers') this.view = 'tools'
    else if (this.view === 'lin' || this.view === 'quad' || this.view === 'sys' || this.view === 'eqin') this.view = 'solvers'
    else if (this.view === 'plot') this.view = this.plotBack
    else this.view = 'tools'
    return true
  },

  loadHist() {
    const self = this
    const gen = ++histGen
    try {
      storage.get({
        key: 'calc_hist',
        success: function (data) {
          if (gen !== histGen) return // 代次已作废（期间发生过保存/清空）：丢弃这份旧快照
          try {
            const arr = JSON.parse(data || '[]')
            if (Array.isArray(arr)) {
              self.hist = arr.filter(function (h) {
                return h && typeof h.expr === 'string' && typeof h.res === 'string' &&
                  h.expr.length <= 200 && h.res.length <= 100 && isRealCalc(h.expr)
              }).map(function (h) {
                const o = { expr: h.expr, res: calc.sciStr(h.res), sgn: h.sgn, ts: (Number.isFinite(h.ts) && Math.abs(h.ts) <= 8640000000000000) ? h.ts : 0 }
                if (typeof h.rf === 'string' && h.rf.length > 0 && h.rf.length <= 30 && isFinite(Number(h.rf))) o.rf = h.rf
                return o
              }).slice(0, 10)
              self.refreshHistDisp()
            }
          } catch (e) {}
        },
        fail: function () {}
      })
    } catch (e) {}
  },
  saveHist() {
    histGen++ // 作废全部在途读回调，防旧快照覆盖刚保存的新历史（见 histGen 注）
    try { storage.set({ key: 'calc_hist', value: JSON.stringify(this.hist) }) } catch (e) {}
  },

  gatePaid(target) {
    if (this.unlocked) return false
    this.unlockTarget = target || null
    this.view = 'unlock'
    return true
  },
  goUnlock() { this.buzz(); this.view = 'unlock' },
  setDeviceDisp(id) {
    const sc = shortCodeForDevice(id)
    this.devCodeDisp = sc.slice(0, 3) + ' ' + sc.slice(3)
  },
  checkStoredKey() {
    const self = this
    try {
      storage.get({
        key: 'calc_key',
        success: function (data) {
          if (data && self.deviceId && keyMatches(self.deviceId, data)) {
            self.unlocked = true
            if (self.view === 'unlock' && !self.keyInput) self.view = 'calc'
          }
        },
        fail: function () {}
      })
    } catch (e) {}
  },
  fetchDeviceId() {
    const self = this
    const fallback = function () {
      try {
        storage.get({
          key: 'calc_devcode',
          success: function (data) {
            if (data && normalizeDeviceId(data).length === 32) {
              self.deviceId = normalizeDeviceId(data)
              self.setDeviceDisp(self.deviceId)
              self.checkStoredKey()
            } else {
              let c = ''
              const hex = '0123456789abcdef'
              for (let i = 0; i < 32; i++) c += hex[Math.floor(Math.random() * 16)]
              self.deviceId = c
              self.setDeviceDisp(c)
              try { storage.set({ key: 'calc_devcode', value: c }) } catch (e) {}
              self.checkStoredKey()
            }
          },
          fail: function () {}
        })
      } catch (e) {}
    }
    try {
      device.getDeviceId({
        success: function (res) {
          const id = normalizeDeviceId(res && res.deviceId ? res.deviceId : '')
          if (id.length === 32) {
            self.deviceId = id
            self.setDeviceDisp(id)
            self.checkStoredKey()
          } else fallback()
        },
        fail: function () { fallback() }
      })
    } catch (e) { fallback() }
  },
  refreshKeyDisp() {
    const padded = (this.keyInput + '__________').slice(0, 10)
    this.keyDisp = padded.slice(0, 5) + ' ' + padded.slice(5)
    const slots = []
    for (let i = 0; i < 10; i++) {
      slots.push({ ch: this.keyInput.charAt(i), ml: i === 0 ? 0 : (i === 5 ? 12 : 3) })
    }
    this.keySlots = slots
  },
  unPad(v) {
    this.buzz()
    if (v === 'del') this.keyInput = this.keyInput.slice(0, -1)
    else if (v === 'clr') this.keyInput = ''
    else {
      if (this.keyInput.length >= 10) return
      this.keyInput += v
    }
    this.unlockMsg = ''
    this.refreshKeyDisp()
  },
  confirmUnlock() {
    this.buzz()
    if (this.keyInput.length < 10) {
      this.unlockMsg = '密钥是 10 位数字，还差 ' + (10 - this.keyInput.length) + ' 位'
      return
    }
    if (!this.deviceId) {
      this.unlockMsg = '设备码还没读出来，等一下再试'
      return
    }
    if (keyMatches(this.deviceId, this.keyInput)) {
      this.unlocked = true
      try { storage.set({ key: 'calc_key', value: this.keyInput }) } catch (e) {}
      const target = this.unlockTarget
      this.unlockTarget = null
      this.keyInput = ''
      this.refreshKeyDisp()
      this.unlockMsg = ''
      try { vibrator.vibrate({ mode: 'long' }) } catch (e) {}
      // 2026-11-15 自查 C7：解锁成功直达被拦的目标，不用再点一次。
      // gatePaid 已放行（unlocked=true），以下调用不会再被拦。
      if (target) {
        if (target.indexOf('tool:') === 0) { this.openTool(target.slice(5)); return }
        if (target.indexOf('solver:') === 0) { this.openSolver(target.slice(7)); return }
        if (target.indexOf('plot:') === 0) { this.openPlot(target.slice(5)); return }
        if (target === 'tools') { this.view = 'tools'; return }
        if (target === 'solvers') { this.view = 'solvers'; return }
        if (target === 'history') { this.openHistory(); return }
        if (target === 'sci') { this.padPage = 'sci'; this.view = 'calc'; return }
        if (target === 'plotcfg') { this.view = 'plotcfg'; return }
      }
    } else {
      this.unlockMsg = '密钥不对，请核对后重新输入'
      this.keyInput = ''
      this.refreshKeyDisp()
    }
  },

  goCalc() { this.buzz(); this.view = 'calc' },
  goTools() { this.buzz(); if (this.gatePaid('tools')) return; this.view = 'tools' },
  goSolvers() { this.buzz(); if (this.gatePaid('solvers')) return; this.view = 'solvers' },
  openTools() { this.buzz(); if (this.gatePaid('tools')) return; this.view = 'tools' },
  openHistory() { this.buzz(); if (this.gatePaid('history')) return; this.refreshHistDisp(); this.view = 'history' },
  openTool(id) {
    this.buzz()
    if (this.gatePaid('tool:' + id)) return
    if (id === 'unit') { this.view = 'unit'; this.unitCompute() }
    else if (id === 'base') { this.view = 'base'; this.baseCompute() }
    else if (id === 'solvers') { this.view = 'solvers' }
    else if (id === 'plot') { this.view = 'plotcfg'; this.syncPlotFields() }
    else if (id === 'frac') { this.view = 'frac'; this.fracSolve() }
    else if (id === 'sqrt') { this.view = 'sqrt'; this.sqrtSolve() }
    else if (id === 'gcd') { this.view = 'gcd'; this.gcdSolve() }
    else if (id === 'tri') { this.view = 'tri'; this.triSolve() }
    else if (id === 'circ') { this.view = 'circ'; this.circSolve() }
    else if (id === 'rtri' || id === 'law' || id === 'perm' || id === 'seq') { this.navTool(id) }
    else if (id === 'history') { this.view = 'history' }
  },
  navTool(id) {
    this.buzz()
    try { storage.set({ key: 'calc_tool_nav', value: id }) } catch (e) {}
    // 必须 replace 不能 push：手环 QuickJS 堆上限紧，push 会让主页与第二页的
    // 编译代码同时驻留、加载第二页时 OOM（2026-11-15 模拟器实测，见 BUGLOG）。
    // 目标工具走路由参数同步传（首帧直达、不闪第二页菜单）；存储键保留作兜底。
    router.replace({ uri: '/pages/tools2', params: { tool: id } })
  },
  openSolver(id) {
    this.buzz()
    if (this.gatePaid('solver:' + id)) return
    if (id === 'lin') { this.view = 'lin'; this.linSolve() }
    else if (id === 'quad') { this.view = 'quad'; this.quadSolve() }
    else if (id === 'sys') { this.view = 'sys'; this.sysSolve() }
    else if (id === 'eqin') { this.view = 'eqin' }
  },

  refreshCalc() {
    const ex = this.expr
    this.exprPx = ex.length <= 14 ? 32 : (ex.length <= 20 ? 26 : (ex.length <= 26 ? 21 : (ex.length <= 29 ? 17 : 15)))
    const echo = sciEcho(ex)
    this.exprDisp = this.justEq ? '' : (echo.length <= 32 ? echo : echo.slice(-32))
    this.canFrac = false
    if (!ex) { this.resDisp = '0'; this.resPx = 50; this.previewOk = false; return }
    let src = ex
    while (src.length && '+-−×÷^('.indexOf(src.slice(-1)) >= 0) src = src.slice(0, -1)
    if (!src) { this.previewOk = false; this.resDisp = '···'; this.resPx = 36; return }
    let open = 0
    for (const ch of src) { if (ch === '(') open++; else if (ch === ')') open-- }
    while (open > 0) { src += ')'; open-- }
    this.evalSrc = src
    try {
      const v = calc.evaluate(src, { deg: this.degMode })
      if (!isFinite(v)) {
        this.previewOk = false
        this.previewVal = v
        this.resDisp = '溢出'
        this.resPx = 36
        this.canFrac = false
        return
      }
      this.previewOk = true
      this.previewVal = v
      const frac = calc.toFraction(v)
      this.canFrac = !!frac && frac.d !== 1
      let s
      let mainIsFrac = false
      let fracExact = false
      if (this.fracOn && frac) {
        s = dm(frac.d === 1 ? String(frac.n) : frac.n + '/' + frac.d)
        mainIsFrac = true
        fracExact = calc.fracIsExact(v, frac)
        if (s.length > 16) { s = fitResStr(v, 11); mainIsFrac = false }
      } else s = fitResStr(v, this.canFrac ? 11 : 18)
      this.resDisp = (mainIsFrac ? (fracExact ? '=' : '≈') : calc.eqSign(v, s)) + ' ' + s
      this.resPx = fitResPx(this.resDisp, this.canFrac)
      this.chipText = fracChipText(this.fracOn, frac, v, mainIsFrac)
    } catch (e) {
      this.previewOk = false
      const hints = { div0: '不能 ÷ 0', overflow: '数太大了', domain: '没有意义', undefined: '没有意义', 'fact domain': '阶乘要用整数', precision: '整数超出精确范围' }
      const h = hints[e.message]
      this.resDisp = h || '···'
      this.resPx = h ? 28 : 36
    }
  },
  appendTok(v) {
    const ex = this.expr
    const last = ex.slice(-1)
    // 2026-11-15 自查 C1：'.' 也是值结尾（2.π 应成 2.×π），否则式子卡死局。
    // 不把 '.' 加进 VAL_END——那会连带改后缀键、')'、'^'、数字键多处行为。
    const needMul = last && (VAL_END.indexOf(last) >= 0 || last === '.')
    if ((v === '(' || v === 'π' || v === 'e') && needMul) this.expr = ex + '×' + v
    else this.expr = ex + v
  },
  pressKey(v) {
    this.buzz()
    if (v === 'fx') { if (this.gatePaid('sci')) return; this.padPage = 'sci'; return }
    if (v === '123') { this.padPage = 'main'; return }
    if (v === 'deg') { this.toggleDeg(); return }
    if (v === 'C') { this.expr = ''; this.fracOn = false; this.justEq = false; this.refreshCalc(); return }
    if (v === 'back') { this.expr = this.expr.slice(0, -1); this.justEq = false; this.refreshCalc(); return }
    if (v === 'eq') {
      if (!this.previewOk) return
      const val = this.previewVal
      const plain = calc.formatPlain(val)
      if (plain === '错误' || plain === '溢出') return
      const exprStr = this.evalSrc || this.expr
      const resStr = calc.formatDisplay(val)
      const hasOp = isRealCalc(exprStr)
      const dup = this.hist.length > 0 && this.hist[0].expr === exprStr && this.hist[0].res === resStr
      if (hasOp && !dup) {
        this.hist.unshift({ expr: exprStr, res: resStr, rf: String(val), sgn: calc.eqSign(val, resStr), ts: Date.now(), time: fmtHistTime(Date.now()) })
        this.hist = this.hist.slice(0, 10)
        this.saveHist()
        this.histPage = 0
        this.refreshHistDisp()
      }
      this.lastAns = plain
      this.ansFull = String(val)
      this.expr = dispNum(String(val))
      this.fracOn = false
      this.justEq = true
      this.refreshCalc()
      return
    }
    if (v === 'ans') {
      if (!this.lastAns) return
      // 2026-11-15 自查 C5：60 字上限，Ans 追加也不能顶出去。
      if (this.expr.length >= 60) return
      const a = dispNum(this.ansFull || this.lastAns)
      const last = this.expr.slice(-1)
      if (last && VAL_END.indexOf(last) >= 0) this.expr += '×' + a
      else this.expr += a
      this.justEq = false
      this.refreshCalc()
      return
    }
    if (v === 'neg') {
      this.justEq = false
      if (!this.expr) { this.expr = '−'; this.refreshCalc(); return }
      let unwrapped = false
      if (this.expr.indexOf('−(') === 0 && this.expr.slice(-1) === ')') {
        let depth = 0, matchEnd = -1
        for (let i = 1; i < this.expr.length; i++) {
          const ch = this.expr[i]
          if (ch === '(') depth++
          else if (ch === ')') { depth--; if (depth === 0) { matchEnd = i; break } }
        }
        if (matchEnd === this.expr.length - 1) { this.expr = this.expr.slice(2, -1); unwrapped = true }
      }
      if (!unwrapped) {
        // 2026-11-15 自查 C5：60 字上限，± 包裹也不能顶出去；解包（变短）不拦。
        if (this.expr.length >= 60) return
        this.expr = '−(' + this.expr + ')'
      }
      this.refreshCalc()
      return
    }
    if (this.justEq) {
      this.justEq = false
      if ('0123456789'.indexOf(v) >= 0 || v === '.' || v === '(' || v === 'π' || v === 'e' || FN_TOKENS.indexOf(v) >= 0) {
        this.expr = ''
      }
    }
    if (this.expr.length >= 60) return
    if (v === 'x10') {
      const ex0 = this.expr
      const l0 = ex0.slice(-1)
      if (!ex0) this.expr = '10^'
      else if ('+−×÷(^'.indexOf(l0) >= 0) this.expr = ex0 + '10^'
      else this.expr = ex0 + '×10^'
      this.refreshCalc()
      return
    }
    const last = this.expr.slice(-1)
    if (FN_TOKENS.indexOf(v) >= 0) {
      // 2026-11-15 自查 C1：'.' 后按函数键同样补 ×（2.×sin(）。
      if (last && (VAL_END.indexOf(last) >= 0 || last === '.')) this.expr += '×' + v
      else this.expr += v
    } else if (v === '²' || v === '!' || v === '°' || v === '%') {
      // 2026-11-15 自查 C6：° 连按不追加（90°° 会被当两次角度换算默默算错值）。
      if (v === '°' && last === '°') { /* 忽略 */ }
      else if (last && VAL_END.indexOf(last) >= 0) this.expr += v
    } else if (v === '^') {
      if (!last) return
      if ('+−×÷^'.indexOf(last) >= 0) this.expr = this.expr.slice(0, -1) + '^'
      else if (last === '(') return
      else this.expr += '^'
    } else if ('0123456789'.indexOf(v) >= 0) {
      if (last && VAL_END.indexOf(last) >= 0 && '0123456789.'.indexOf(last) < 0) this.expr += '×' + v
      else this.expr += v
    } else if (v === '.') {
      let seg = this.expr.split(/[+\-−×÷()^]/).pop()
      if (seg.indexOf('.') >= 0) return
      if (!last || '+-−×÷(^'.indexOf(last) >= 0) this.expr += '0.'
      else if (VAL_END.indexOf(last) >= 0 && '0123456789'.indexOf(last) < 0) this.expr += '×0.'
      else this.expr += '.'
    } else if (v === '(' || v === 'π' || v === 'e') {
      this.appendTok(v)
    } else if (v === ')') {
      let open = 0
      for (const ch of this.expr) { if (ch === '(') open++; else if (ch === ')') open-- }
      if (open > 0 && last && VAL_END.indexOf(last) >= 0) this.expr += ')'
    } else if ('+−×÷'.indexOf(v) >= 0) {
      if (!last) { if (v === '−') this.expr = '−' }
      else if (v === '−' && '×÷^'.indexOf(last) >= 0) this.expr += '−'
      else if ('+−×÷^'.indexOf(last) >= 0) this.expr = this.expr.slice(0, -1) + v
      else if (last === '(') { if (v === '−') this.expr += '−' }
      else this.expr += v
    }
    this.refreshCalc()
  },
  toggleFrac() { this.buzz(); this.fracOn = !this.fracOn; this.refreshCalc() },
  toggleDeg() { this.degMode = !this.degMode; this.buildSciKeys(); this.refreshCalc() },

  useHist(item) {
    this.buzz()
    if (!item || typeof item.res !== 'string') return
    if (this.gatePaid()) return
    this.expr = dispNum(item.rf || calc.sciToPlain(item.res.replace(/,/g, '')))
    this.fracOn = false
    this.justEq = true
    this.view = 'calc'
    this.refreshCalc()
  },
  clearHist() { this.buzz(); this.hist = []; this.histPage = 0; this.refreshHistDisp(); this.saveHist() },
  refreshHistDisp() {
    const total = this.hist.length
    const pages = Math.max(1, Math.ceil(total / 5))
    if (this.histPage > pages - 1) this.histPage = pages - 1
    if (this.histPage < 0) this.histPage = 0
    this.histDisp = this.hist.slice(this.histPage * 5, this.histPage * 5 + 5).map(function (h) {
      const e2 = sciEcho(h.expr)
      return { expr: e2, res: h.res, sgn: h.sgn, ts: h.ts, px: e2.length > 26 ? 12 : 15, time: h.ts ? fmtHistTime(h.ts) : (h.time || '') }
    })
    this.histPageTxt = (this.histPage + 1) + ' / ' + pages
    this.histHasOlder = this.histPage < pages - 1
    this.histFew = total > 0 && total <= 5
  },
  histOlder() {
    this.buzz()
    this.histPage += 1
    this.refreshHistDisp()
  },
  histNewer() {
    this.buzz()
    this.histPage -= 1
    this.refreshHistDisp()
  },

  setCat(name) {
    this.buzz()
    const cats = calc.UNIT_CATS
    for (let i = 0; i < cats.length; i++) {
      if (cats[i].name === name) {
        this.catIdx = i
        this.catName = name
        const us = cats[i].units
        this.unitFromId = us[Math.min(2, us.length - 1)].id
        this.unitFromName = us[Math.min(2, us.length - 1)].name
        this.unitToId = us[0].id
        this.unitToName = us[0].name
        break
      }
    }
    if (name === '温度') {
      this.unitFromId = 'c'; this.unitFromName = '摄氏度 °C'
      this.unitToId = 'f'; this.unitToName = '华氏度 °F'
    }
    this.unitCompute()
  },
  unitCompute() {
    this.unitValPx = unitPxOf(this.unitVal === '' ? '0' : this.unitVal)
    const v = parseFloat(this.unitVal)
    if (this.unitVal === '' || this.unitVal === '-' || isNaN(v)) { this.unitRes = ''; this.unitResPx = 27; return }
    const r = calc.convertUnit(this.catIdx, this.unitFromId, this.unitToId, v)
    if (isNaN(r)) { this.unitRes = '' }
    else if (r !== 0 && calc.formatDisplay(r) === '0') {
      this.unitRes = '≈ ' + dispNum(calc.sciStr(r.toExponential(2)))
    }
    else this.unitRes = calc.formatDisplay(r)
    this.unitResPx = unitPxOf(this.unitRes === '' ? '—' : this.unitRes)
  },
  pickUnit(target) {
    this.buzz()
    this.pickTarget = target
    this.pickUnits = calc.UNIT_CATS[this.catIdx].units
    this.pickCur = target === 'from' ? this.unitFromId : this.unitToId
    this.view = 'unitpick'
  },
  backToUnit() { this.buzz(); this.view = 'unit' },
  applyPick(id) {
    this.buzz()
    const us = calc.UNIT_CATS[this.catIdx].units
    let nm = ''
    for (const u of us) if (u.id === id) nm = u.name
    if (this.pickTarget === 'from') { this.unitFromId = id; this.unitFromName = nm }
    else { this.unitToId = id; this.unitToName = nm }
    this.view = 'unit'
    this.unitCompute()
  },
  swapUnits() {
    this.buzz()
    const id = this.unitFromId, nm = this.unitFromName
    this.unitFromId = this.unitToId; this.unitFromName = this.unitToName
    this.unitToId = id; this.unitToName = nm
    this.unitCompute()
  },
  carryUnitProc() {
    if (!this.unitRes) return
    const v = parseFloat(this.unitVal)
    if (this.unitVal === '' || this.unitVal === '-' || isNaN(v)) return
    const proc = buildUnitProc(this.catIdx, this.unitFromId, this.unitToId, v)
    if (!proc) return
    this.expr = unitCarryExpr(this.expr, proc)
    this.justEq = false
    this.view = 'calc'
    this.refreshCalc()
  },
  unitCarryBack() {
    this.buzz()
    this.carryUnitProc()
  },
  unitPad(v) {
    this.buzz()
    if (v === 'C') this.unitVal = ''
    else if (v === 'back') this.unitVal = this.unitVal.slice(0, -1)
    else if (v === 'neg') {
      this.unitVal = this.unitVal.indexOf('-') === 0 ? this.unitVal.slice(1) : '-' + this.unitVal
    } else if (v === '.') {
      // 2026-11-15 自查 C4：'.' 分支也查 12 位上限（12 字 + '.' 不再顶到 13 字）。
      if (this.unitVal.replace('-', '').replace('.', '').length >= 12) return
      if (this.unitVal.indexOf('.') < 0) this.unitVal = (this.unitVal === '-' ? '-0' : (this.unitVal || '0')) + '.'
    } else if (v === 'ok') {
      this.carryUnitProc()
      return
    }
    else {
      if (this.unitVal === '0' || this.unitVal === '-0') {
        if (v === '0' || v === '00') { this.unitCompute(); return }
        if (/^[1-9]$/.test(v)) { this.unitVal = (this.unitVal.charAt(0) === '-' ? '-' : '') + v; this.unitCompute(); return }
      }
      // 2026-11-15 自查 C4：'00' 按 +2 位算 12 位上限（11 字 + '00' 不再顶到 13 字）。
      if (this.unitVal.replace('-', '').replace('.', '').length + (v === '00' ? 2 : 1) > 12) return
      this.unitVal += v
    }
    this.unitCompute()
  },

  buildBaseKeys() {
    const names = { 2: '二进制', 8: '八进制', 10: '十进制', 16: '十六进制' }
    this.baseName = names[this.fromBase]
    const digs = '0123456789ABCDEF'.slice(0, this.fromBase).split('')
    const keys = digs.map(function (d) { return { v: d, label: d } })
    keys.push({ v: 'back', label: '←' }, { v: 'C', label: 'C' })
    this.baseKeys = keys
  },
  setBase(b) {
    this.buzz()
    let newVal = ''
    if (this.baseVal) {
      const r = calc.baseConvert(this.baseVal, this.fromBase)
      if (r && !r.error) newVal = b === 2 ? r.bin : b === 8 ? r.oct : b === 10 ? r.dec : r.hex
    }
    this.fromBase = b
    this.buildBaseKeys()
    this.baseVal = newVal
    this.baseCompute()
  },
  baseCompute() {
    const bl = (this.baseVal || '').length
    this.baseInPx = bl <= 12 ? 23 : (bl <= 18 ? 19 : (bl <= 24 ? 16 : (bl <= 30 ? 13 : 11)))
    const r = calc.baseConvert(this.baseVal || '0', this.fromBase)
    if (!r) { this.baseRows = []; this.baseErr = ''; return }
    if (r.error) {
      this.baseErr = r.error
      this.baseRows = []
      return
    }
    this.baseErr = ''
    const bpx = function (v) { return v.length > 30 ? 10 : (v.length > 24 ? 12 : (v.length > 18 ? 14 : 17)) }
    this.baseRows = [
      { k: '二进制', v: r.bin, px: bpx(r.bin) }, { k: '八进制', v: r.oct, px: bpx(r.oct) },
      { k: '十进制', v: r.dec, px: bpx(r.dec) }, { k: '十六进制', v: r.hex, px: bpx(r.hex) }
    ]
  },
  basePad(v) {
    this.buzz()
    if (v === 'C') this.baseVal = ''
    else if (v === 'back') this.baseVal = this.baseVal.slice(0, -1)
    else {
      const caps = { 2: 36, 8: 12, 10: 11, 16: 9 }
      if (this.baseVal.length >= caps[this.fromBase]) return
      if (this.baseVal === '0') this.baseVal = v === '0' ? '0' : v
      else this.baseVal += v
    }
    this.baseCompute()
  },

  setLField(f) { this.buzz(); this.lField = f },
  linSolve() {
    this.lFvPx = fvPxOf([this.la, this.lb, this.lc, this.ld], false)
    const a = parseCoeff0(this.la), b = parseCoeff0(this.lb), c = parseCoeff0(this.lc), d = parseCoeff0(this.ld)
    this.lCanPlot = false
    if (isNaN(a) || isNaN(b) || isNaN(c) || isNaN(d)) { this.lLines = ['把 a、b、c、d 填完整就能解']; return }
    const r = calc.solveLinear(a, b, c, d)
    if (r.error) { this.lLines = [r.error]; return }
    const F = function (x) { return calc.formatDisplay(x) }
    if (r.type === 'one') {
      let sym = null
      const mA = monoSub(monoOf(this.la), monoOf(this.lc))
      const mB = monoSub(monoOf(this.ld), monoOf(this.lb))
      if (mA && mB && mA.qn !== 0) {
        const xm = monoDiv(mB, mA)
        if (xm && (xm.pi !== 0 || xm.rad !== 1)) {
          const sv = (xm.qn / xm.qd) * Math.pow(Math.PI, xm.pi) * Math.sqrt(xm.rad)
          if (Math.abs(sv - r.x) <= 1e-9 * Math.abs(r.x) + 1e-12) sym = monoStr(xm)
        }
      }
      this.lLines = [sym ? symAnsStr('x', r.x, sym, 27) : ansStr('x', r.x, 27)]
      this.lCanPlot = (a - c) !== 0
    } else if (r.type === 'none') this.lLines = ['方程无解（两边 x 系数一样）']
    else this.lLines = ['恒等式：无数个解']
  },
  linPad(v) {
    this.buzz()
    const props = { a: 'la', b: 'lb', c: 'lc', d: 'ld' }
    const order = ['a', 'b', 'c', 'd']
    const prop = props[this.lField]
    const r = editCoeff(this[prop], v)
    if (r === 'NEXT') { this.lField = order[(order.indexOf(this.lField) + 1) % 4]; return }
    this[prop] = r
    this.linSolve()
  },

  setQField(f) { this.buzz(); this.qField = f },
  quadSolve() {
    this.qFvPx = fvPxOf([this.qa, this.qb, this.qc], true)
    const a = parseCoeff0(this.qa), b = parseCoeff0(this.qb), c = parseCoeff0(this.qc)
    this.qCanPlot = false
    if (isNaN(a) || isNaN(b) || isNaN(c)) { this.qLines = ['把 a、b、c 填完整就能解']; return }
    const r = calc.solveQuad(a, b, c)
    if (r.error) { this.qLines = [r.error]; return }
    const F = function (x) { return calc.formatDisplay(x) }
    if (r.type === 'two') {
      const rads = quadRadStrs(a, b, c, r.x1, r.x2)
      this.qLines = [discLine(r, ' > 0'),
        rads ? radAnsStr('x1', r.x1, rads.x1, 28, rads.exact) : ansStr('x1', r.x1, 28),
        rads ? radAnsStr('x2', r.x2, rads.x2, 28, rads.exact) : ansStr('x2', r.x2, 28)]
    }
    else if (r.type === 'one') this.qLines = ['判别式 Δ = 0（两根相等）', ansStr('x', r.x, 28)]
    else if (r.type === 'complex') {
      const imRad = quadImRad(a, b, c, r.im)
      const cr1 = imRad ? cplxRadStr('x1', r, imRad, '+') : null
      const cr2 = imRad ? cplxRadStr('x2', r, imRad, '−') : null
      this.qLines = [discLine(r, ' < 0'), '无实数根，复数根：', (cr1 && cr2) ? cr1 : cplxStr('x1', r, '+'), (cr1 && cr2) ? cr2 : cplxStr('x2', r, '−')]
    } else if (r.type === 'linear') this.qLines = ['a = 0，退化为一次方程', ansStr('x', r.x, 28)]
    else if (r.type === 'none') this.qLines = ['方程无解']
    else this.qLines = ['恒等式：无数个解']
    this.qCanPlot = a !== 0
  },
  quadPad(v) {
    this.buzz()
    const props = { a: 'qa', b: 'qb', c: 'qc' }
    const order = ['a', 'b', 'c']
    const prop = props[this.qField]
    const r = editCoeff(this[prop], v)
    if (r === 'NEXT') { this.qField = order[(order.indexOf(this.qField) + 1) % 3]; return }
    this[prop] = r
    this.quadSolve()
  },

  setSField(f) { this.buzz(); this.sField = f },
  sysSolve() {
    this.sFvPx = fvPxOf([this.s1a, this.s1b, this.s1c, this.s2a, this.s2b, this.s2c], true)
    const a1 = parseCoeff0(this.s1a), b1 = parseCoeff0(this.s1b), c1 = parseCoeff0(this.s1c)
    const a2 = parseCoeff0(this.s2a), b2 = parseCoeff0(this.s2b), c2 = parseCoeff0(this.s2c)
    if ([a1, b1, c1, a2, b2, c2].some(isNaN)) { this.sLines = ['把六个系数都填完整就能解']; return }
    const r = calc.solveSystem(a1, b1, c1, a2, b2, c2)
    if (r.error) { this.sLines = [r.error]; return }
    const F = function (x) { return calc.formatDisplay(x) }
    if (r.type === 'one') {
      this.sLines = [ansStr('x', r.x, 27), ansStr('y', r.y, 27)]
    } else if (r.type === 'none') this.sLines = ['方程组无解（两线平行）']
    else this.sLines = ['方程组有无穷多组解']
  },
  sysPad(v) {
    this.buzz()
    const props = { a1: 's1a', b1: 's1b', c1: 's1c', a2: 's2a', b2: 's2b', c2: 's2c' }
    const order = ['a1', 'b1', 'c1', 'a2', 'b2', 'c2']
    const prop = props[this.sField]
    const r = editCoeff(this[prop], v)
    if (r === 'NEXT') { this.sField = order[(order.indexOf(this.sField) + 1) % 6]; return }
    this[prop] = r
    this.sysSolve()
  },

  eqPad(v) {
    this.buzz()
    if (v === 'solve') { this.eqSolve(); return }
    const prop = this.eqFocus === 2 ? 'eqExpr2' : 'eqExpr'
    let cur = this[prop]
    if (v === 'C') { this[prop] = ''; this.eqSync(); return }
    if (v === 'back') { this[prop] = cur.slice(0, -1); this.eqSync(); return }
    let s = cur
    const last = s.slice(-1)
    const isOp = '+-−×÷/='.indexOf(last) >= 0
    if (v === '=') {
      if (!s || s.indexOf('=') >= 0 || isOp || last === '(') return
      s += '='
    } else if (v === '²') {
      if (!s || !/[0-9)xyπe.]$/.test(last)) return
      s += '²'
    } else if (v === '+' || v === '×' || v === '÷') {
      if (!s || last === '(' || last === '=') return
      s = isOp ? s.slice(0, -1) + v : s + v
    } else if (v === '−') {
      if (last === '+' || last === '−') s = s.slice(0, -1) + '−'
      else s += '−'
    } else if (v === '/') {
      if (!s || isOp || last === '(' || last === '.') return
      s += '/'
    } else if (v === '.') {
      if (last === '²' || last === ')' || last === 'π' || last === 'e') return
      const seg = s.split(/[+\-−×÷/()=xy]/).pop()
      if (seg.indexOf('.') >= 0) return
      // 2026-11-15 自查 C2：% / ° 后按 .，与主键盘一致补 ×0.（50%→50%×0.），
      // 不再敲出 50%.5 这种点解才报错的非法式子。
      if (last === '%' || last === '°') s += '×0.'
      else s += (!s || isOp || last === '(' || last === 'x' || last === 'y') ? '0.' : '.'
    } else if (v === '√(' || v === 'π' || v === 'e' || v === '(') {
      // 2026-11-15 自查 C1：'.' 后按 √(/π/e/( 同样补 ×（2.×π）。
      if (last && /[0-9)xy²πe%°.]/.test(last)) s += '×'
      s += v
    } else if (v === '^' || v === '%' || v === '°') {
      // 2026-11-15 自查 C3：允许 % 连按（50%%，与主键盘口径一致）。
      if (!s || !/[0-9)xy²πe%]/.test(last)) return
      s += v
    } else if (v === ')') {
      let open = 0
      for (const ch of s) { if (ch === '(') open++; else if (ch === ')') open-- }
      if (open <= 0 || isOp || last === '(') return
      s += ')'
    } else {
      s += v
    }
    if (s.length > 38) return
    this[prop] = s
    this.eqSync()
  },
  eqSync() {
    this.eqChars1 = this.eqExpr.split('')
    this.eqChars2 = this.eqExpr2.split('')
    const el = Math.max(this.eqExpr.length, this.eqExpr2.length)
    this.eqPx = el <= 16 ? 25 : (el <= 22 ? 20 : (el <= 30 ? 16 : 13))
    this.eqSupPx = Math.round(this.eqPx * 0.64)
    this.eqImgW = Math.round(13 * this.eqPx / 25)
    this.eqShow2 = (this.eqExpr + this.eqExpr2).indexOf('y') >= 0
  },
  setEqFocus(n) { this.buzz(); this.eqFocus = n },
  eqSolve() {
    const F = function (x) { return calc.formatDisplay(x) }
    const evalSide = (side, t, u) => {
      let src = eqSideSrc(side, t, u)
      while (src.length && '+-*/^('.indexOf(src.slice(-1)) >= 0) src = src.slice(0, -1)
      let open = 0
      for (const ch of src) { if (ch === '(') open++; else if (ch === ')') open-- }
      while (open > 0) { src += ')'; open-- }
      return calc.evaluate(src, { deg: this.degMode })
    }
    const raw1 = this.eqExpr, raw2 = this.eqExpr2
    const sideDangling = (raw) => raw.split('=').some((sg) => /[+\-−×÷\/^(]$/.test(sg.trim()))
    if (((raw1 + raw2).indexOf('=') >= 0 || /[xy]/.test(raw1 + raw2)) && (sideDangling(raw1) || sideDangling(raw2))) {
      this.eqLines = ['算式有问题，检查括号和符号']
      return
    }
    if ((raw1 + raw2).indexOf('y') >= 0) {
      if (!raw1 || !raw2) { this.eqLines = ['含 y 的是方程组，要两个方程', '点下面的框，把第二个方程输完']; return }
      if ((raw1.match(/=/g) || []).length > 1 || (raw2.match(/=/g) || []).length > 1) { this.eqLines = ['每个方程只能有一个 = 号']; return }
      try {
        const coef = (raw) => {
          const parts = raw.indexOf('=') >= 0 ? raw.split('=') : [raw, '0']
          let Sside = 0
          const g = (tx, ty) => {
            const L = evalSide(parts[0], tx, ty), R = evalSide(parts[1], tx, ty)
            if (Math.abs(L) > Sside) Sside = Math.abs(L)
            if (Math.abs(R) > Sside) Sside = Math.abs(R)
            return L - R
          }
          const c00 = g(0, 0)
          const g10 = g(1, 0), g01 = g(0, 1)
          const A = g10 - c00, B = g01 - c00
          const probes = [[1, 1], [2, 0], [0, 2], [2, 2], [2, 1], [1, 2], [-2, 1], [3, 0], [0, 3], [3, 3], [0.5, 0.5], [0.5, 2], [2, 0.5], [-1, -1], [1, -2]]
          const vals = []
          for (const t of probes) { vals.push(g(t[0], t[1])) }
          const bigProbes = [[64, 0], [0, 64], [64, 64], [512, 512], [512, 0], [0, 512], [65536, 0], [0, 65536]]
          let v512x = null, v512y = null, vB16x = null, vB16y = null
          for (const t of bigProbes) {
            try {
              const v = g(t[0], t[1])
              if (isFinite(v)) {
                probes.push(t); vals.push(v)
                if (t[0] === 512 && t[1] === 0) v512x = v
                else if (t[0] === 0 && t[1] === 512) v512y = v
                else if (t[0] === 65536 && t[1] === 0) vB16x = v
                else if (t[0] === 0 && t[1] === 65536) vB16y = v
              }
            } catch (e5) {}
          }
          let Ax = A, Bx = B, Dx = 1, Dy = 1
          if (vB16x !== null) { Ax = (vB16x - c00) / 65536; Dx = 65536 } else if (v512x !== null) { Ax = (v512x - c00) / 512; Dx = 512 }
          if (vB16y !== null) { Bx = (vB16y - c00) / 65536; Dy = 65536 } else if (v512y !== null) { Bx = (v512y - c00) / 512; Dy = 512 }
          const fits = (Aa, Bb, Dd) => {
            for (let pi = 0; pi < probes.length; pi++) {
              const px = probes[pi][0], py = probes[pi][1]
              const tol = 32 * Number.EPSILON * (Math.abs(vals[pi]) + Math.abs(c00) + Math.abs(Aa * px) + Math.abs(Bb * py)) + 16 * Number.EPSILON * Sside * (Math.abs(px) + Math.abs(py)) / Dd + 1e-13 * Math.abs(vals[pi])
              if (Math.abs(vals[pi] - (Aa * px + Bb * py + c00)) > tol) return false
            }
            return true
          }
          if (fits(Ax, Bx, Math.min(Dx, Dy))) return { A: Ax, B: Bx, C: c00 }
          if ((Ax !== A || Bx !== B) && fits(A, B, 1)) return { A: A, B: B, C: c00 }
          return null
        }
        const c1 = coef(raw1), c2 = coef(raw2)
        if (!c1 || !c2) { this.eqLines = ['方程组只支持二元一次', '带平方、xy、根号的解不了']; return }
        const r = calc.solveSystem(c1.A, c1.B, -c1.C, c2.A, c2.B, -c2.C)
        if (r.error) { this.eqLines = [r.error] }
        else if (r.type === 'one') {
          this.eqLines = [ansStr('x', r.x, 27), ansStr('y', r.y, 27)]
        } else if (r.type === 'none') this.eqLines = ['方程组无解（两式矛盾）']
        else this.eqLines = ['无数个解（两式等价）']
      } catch (e) {
        this.eqLines = ['只支持二元一次方程组', 'x、y 不能在根号、分母里']
      }
      return
    }
    const raw = raw1 || raw2
    if (!raw) { this.eqLines = ['先敲一个方程或算式']; return }
    if ((raw.match(/=/g) || []).length > 1) { this.eqLines = ['只能有一个 = 号']; return }
    try {
      if (raw.indexOf('x') < 0) {
        if (raw.indexOf('=') >= 0) {
          const parts = raw.split('=')
          const lv = evalSide(parts[0], null), rv = evalSide(parts[1], null)
          const scMax = Math.max(Math.abs(lv), Math.abs(rv))
          const litRe = /^[+\-−]?(\d+\.?\d*|\.\d+)([eE][+\-−]?\d+)?$/
          const bothLit = litRe.test(parts[0].trim()) && litRe.test(parts[1].trim())
          const sideHasSub = (s) => /[0-9)π%²!°][-−]/.test(String(s).replace(/\d[eE][+\-−]?\d+/g, '#').replace(/×10[⁻]?[⁰¹²³⁴⁵⁶⁷⁸⁹]+/g, '#'))
          const tailOk = sideHasSub(parts[0]) || sideHasSub(parts[1])
          const isEq = bothLit ? lv === rv : ((lv !== 0 && rv !== 0)
            ? Math.abs(lv - rv) <= 3 * Number.EPSILON * scMax
            : (tailOk ? scMax <= 6e-17 : lv === rv))
          if (isEq) this.eqLines = ['两边相等：恒等式']
          else {
            let ll = ansStr('左边', lv, 26), rl = ansStr('右边', rv, 26)
            if (ll.slice(3) === rl.slice(3)) { ll = '左边 = ' + dm(calc.sciStr(calc.formatPlain(lv))); rl = '右边 = ' + dm(calc.sciStr(calc.formatPlain(rv))) }
            this.eqLines = ['两边不相等', ll, rl]
          }
        } else {
          const v = evalSide(raw, null)
          this.eqLines = [ansStr('', v, 27)]
        }
        return
      }
      const parts = raw.indexOf('=') >= 0 ? raw.split('=') : [raw, '0']
      let Sside = 0, SsideS = 0
      const g = (t) => {
        const L = evalSide(parts[0], t, null), R = evalSide(parts[1], t, null)
        if (Math.abs(L) > Sside) Sside = Math.abs(L)
        if (Math.abs(R) > Sside) Sside = Math.abs(R)
        if (Math.abs(t) <= 4) {
          if (Math.abs(L) > SsideS) SsideS = Math.abs(L)
          if (Math.abs(R) > SsideS) SsideS = Math.abs(R)
        }
        return L - R
      }
      let g0, g1, gm, g3, gm3
      try { g0 = g(0); g1 = g(1); gm = g(-1); g3 = g(3); gm3 = g(-3) } catch (e2) {
        this.eqLines = ['只支持一元一次 / 二次方程', 'x 不能在根号、分母里，也别用 x³']
        return
      }
      const c = g0
      const b1 = (g1 - gm) / 2
      const a3 = (g3 + gm3 - 2 * g0) / 18
      const chkT = [2, -2, 4, -4, 0.5, -0.5, 1.5, -1.5, 2.5, -2.5, 3.5, -3.5, 0.3, -0.3, 0.7, -0.7], chkV = []
      try {
        for (const t of chkT) { chkV.push(g(t)) }
      } catch (e3) {
        this.eqLines = ['只支持一元一次 / 二次方程', 'x 不能在根号、分母里，也别用 x³']
        return
      }
      const ladT = [16, -16, 128, -128, 1024, -1024, 8192, -8192, 65536, -65536, 16777216, -16777216], ladV = []
      for (const t of ladT) {
        try { const v = g(t); ladV.push(isFinite(v) ? v : null) } catch (e4) { ladV.push(null) }
      }
      const noiseS = 8 * Number.EPSILON * SsideS, noiseA = 8 * Number.EPSILON * Sside
      let H = 0, aH = null, bH = null
      for (let li = ladT.length - 2; li >= 0; li -= 2) {
        if (ladV[li] !== null && ladV[li + 1] !== null) {
          H = ladT[li]
          aH = (ladV[li] + ladV[li + 1] - 2 * c) / (2 * H * H)
          bH = (ladV[li] - ladV[li + 1]) / (2 * H)
          break
        }
      }
      const errA3 = noiseS / 18, errAH = aH === null ? 0 : noiseA / (2 * H * H)
      const errB1 = noiseS / 2, errBH = bH === null ? 0 : noiseA / (2 * H)
      const sigA3 = Math.abs(a3) > errA3
      const sigAH = aH !== null && Math.abs(aH) > errAH
      const notPoly = () => { this.eqLines = ['只支持一元一次 / 二次方程', 'x 不能在根号、分母里，也别用 x³'] }
      if (bH !== null && Math.abs(b1 - bH) > errB1 + errBH) { notPoly(); return }
      if (sigA3 && aH !== null && Math.abs(a3 - aH) > errA3 + errAH) { notPoly(); return }
      let a, b, aErr, bErr
      if (sigA3) { a = a3; b = b1; aErr = errA3; bErr = errB1 }
      else if (sigAH) { a = aH; b = bH; aErr = errAH; bErr = errBH }
      else if (bH !== null) { a = 0; b = bH; aErr = 0; bErr = errBH }
      else { a = 0; b = b1; aErr = 0; bErr = errB1 }
      const fitBad = (t, v) => Math.abs(v - (a * t * t + b * t + c)) > 1e-12 * (Sside + Math.abs(v - c)) + aErr * t * t + bErr * Math.abs(t)
      for (let ci = 0; ci < chkT.length; ci++) if (fitBad(chkT[ci], chkV[ci])) { notPoly(); return }
      for (let li = 0; li < ladT.length; li++) if (ladV[li] !== null && fitBad(ladT[li], ladV[li])) { notPoly(); return }
      if (a === 0 && b === 0 && c !== 0) {
        try {
          const v1 = g(1e30), v2 = g(1e100)
          const d1 = v1 - c, d2 = v2 - c
          const sig = 1e-9 * Math.max(Math.abs(c), Math.abs(v1))
          if (isFinite(d1) && isFinite(d2) && Math.abs(d1) > sig && Math.abs(d2) > 100 * Math.abs(d1)) {
            const ratio = Math.abs(d2 / d1)
            if (ratio > 1e67 && ratio < 1e73) b = d1 / 1e30
            else { notPoly(); return }
          }
        } catch (e6) {}
      }
      const r = calc.solveQuad(a, b, c)
      if (r.error) { this.eqLines = [r.error]; return }
      const head = fmtPolyFit(a, b, c)
      if (r.type === 'two') {
        const rads = quadRadStrs(a, b, c, r.x1, r.x2)
        this.eqLines = [head, discLine(r, ' > 0'),
          rads ? radAnsStr('x1', r.x1, rads.x1, 28, rads.exact) : ansStr('x1', r.x1, 28),
          rads ? radAnsStr('x2', r.x2, rads.x2, 28, rads.exact) : ansStr('x2', r.x2, 28)]
      }
      else if (r.type === 'one') this.eqLines = [head, '判别式 Δ = 0（两根相等）', ansStr('x', r.x, 28)]
      else if (r.type === 'complex') this.eqLines = [head, discLine(r, ' < 0'), '无实数根']
      else if (r.type === 'linear') this.eqLines = [head, ansStr('x', r.x, 28)]
      else if (r.type === 'none') this.eqLines = [head, '方程无解']
      else this.eqLines = [head, '恒等式：无数个解']
    } catch (e) {
      const hints = { div0: '不能 ÷ 0', overflow: '数太大了', domain: '没有意义（比如根号里是负数）', undefined: '没有意义', precision: '整数超出精确范围' }
      this.eqLines = [hints[e.message] || '算式有问题，检查括号和符号']
    }
  },
  setFField(f) { this.buzz(); this.fField = f },
  setFop(v) {
    this.buzz()
    this.fop = v
    const syms = { '+': '+', '-': '−', '*': '×', '/': '÷' }
    this.fopSym = syms[v]
    this.fracSolve()
  },
  fracSolve() {
    this.fFvPx = fvPxOf([this.fn1, this.fd1, this.fn2, this.fd2], true)
    const pi = function (s) { return (s === '' || s === '-') ? NaN : parseInt(s, 10) }
    const n1 = pi(this.fn1), d1 = pi(this.fd1), n2 = pi(this.fn2), d2 = pi(this.fd2)
    if ([n1, d1, n2, d2].some(isNaN)) { this.fLines = ['把分子分母都填完整']; return }
    const r = calc.fracCalc(n1, d1, this.fop, n2, d2)
    if (r.error) { this.fLines = [r.error]; return }
    const lines = ['= ' + dm(r.d === 1 ? String(r.n) : r.n + '/' + r.d)]
    if (r.mixed) lines.push('带分数：' + dm(r.mixed.w + ' 又 ' + r.mixed.n + '/' + r.mixed.d))
    let dd = r.d
    while (dd % 2 === 0) dd /= 2
    while (dd % 5 === 0) dd /= 5
    const decShown = parseFloat(r.dec.toPrecision(6))
    lines.push('小数 ' + (dd === 1 && decShown === r.dec ? '= ' : '≈ ') + calc.formatDisplay(decShown))
    this.fLines = lines
  },
  fracPad(v) {
    this.buzz()
    const props = { n1: 'fn1', d1: 'fd1', n2: 'fn2', d2: 'fd2' }
    const order = ['n1', 'd1', 'n2', 'd2']
    const prop = props[this.fField]
    const r = editNum(this[prop], v, false)
    if (r === 'NEXT') { this.fField = order[(order.indexOf(this.fField) + 1) % 4]; return }
    this[prop] = r
    this.fracSolve()
  },

  sqrtSolve() {
    const s = this.sqrtN
    if (s === '' || s === '-') { this.sqrtLines = ['输入一个整数试试']; return }
    const n = parseInt(s, 10)
    const r = calc.simplifySqrt(n)
    if (r.error) { this.sqrtLines = [r.error]; return }
    if (r.rad === 1) this.sqrtLines = ['√' + n + ' = ' + r.coef + '（正好是整数）']
    else if (r.coef === 1) this.sqrtLines = ['√' + n + ' 已是最简', '≈ ' + calc.formatDisplay(parseFloat(r.dec.toPrecision(12)))]
    else this.sqrtLines = ['√' + n + ' = ' + r.coef + '√' + r.rad, '≈ ' + calc.formatDisplay(parseFloat(r.dec.toPrecision(12)))]
  },
  sqrtPad(v) {
    this.buzz()
    const r = editNum(this.sqrtN, v, false)
    if (r === 'NEXT') return
    this.sqrtN = r
    this.sqrtSolve()
  },

  setGField(f) { this.buzz(); this.gField = f },
  gcdSolve() {
    this.gFvPx = fvPxOf([this.ga, this.gb], false)
    const pi = function (s) { return (s === '' || s === '-') ? NaN : parseInt(s, 10) }
    const a = pi(this.ga), b = pi(this.gb)
    if (isNaN(a) || isNaN(b)) { this.gLines = ['两个整数都填好就能算']; return }
    const r = calc.gcdLcm(a, b)
    if (r.error) { this.gLines = [r.error]; return }
    // 2026-11-15 自查 F8：最小公倍数被 fitResStr 截断时连接号用 ≈（与主页同口径），
    // 不再硬编码 '='（gcd 本身 ≤999999999 从不截断，仍用 '='）。
    this.gLines = ['最大公约数 = ' + fitResStr(r.gcd, 15), '最小公倍数 ' + calc.eqSign(r.lcm, fitResStr(r.lcm, 15)) + ' ' + fitResStr(r.lcm, 15)]
  },
  gcdPad(v) {
    this.buzz()
    const props = { a: 'ga', b: 'gb' }
    const prop = props[this.gField]
    const r = editNum(this[prop], v, false)
    if (r === 'NEXT') { this.gField = this.gField === 'a' ? 'b' : 'a'; return }
    this[prop] = r
    this.gcdSolve()
  },

  setTField(f) { this.buzz(); this.tField = f },
  triSolve() {
    this.tFvPx = fvPxOf([this.ta, this.tb, this.tc], true)
    const a = parseCoeff(this.ta), b = parseCoeff(this.tb), c = parseCoeff(this.tc)
    if (isNaN(a) || isNaN(b) || isNaN(c)) { this.tLines = ['三条边都填好就能算']; return }
    const ma = parseMono(this.ta), mb = parseMono(this.tb), mc = parseMono(this.tc)
    const common = !!(ma && mb && mc && ma.qn > 0 && mb.qn > 0 && mc.qn > 0 &&
      ma.pi === mb.pi && mb.pi === mc.pi && ma.rad === mb.rad && mb.rad === mc.rad)
    const r0 = common ? calc.triArea(ma.qn / ma.qd, mb.qn / mb.qd, mc.qn / mc.qd) : null
    if (r0 && r0.error) { this.tLines = [r0.error]; return }
    if (r0 && r0.type === 'degenerate') { this.tLines = ['退化成一条直线，面积 = 0']; return }
    const r = calc.triArea(a, b, c)
    if (r.error && !(r0 && r0.type === 'ok')) { this.tLines = [r.error]; return }
    if (r.type === 'degenerate') { this.tLines = ['退化成一条直线，面积 = 0']; return }
    const areaVal = r.error ? r0.area * ma.rad * Math.pow(Math.PI, 2 * ma.pi) : r.area
    const dec = FD(areaVal)
    if (common && r0 && r0.type === 'ok' && r0.exact && (ma.pi !== 0 || ma.rad !== 1)) {
      let cn = r0.exact.cn * ma.rad, cd = r0.exact.cd
      const g = gcd2(cn, cd) || 1
      cn /= g; cd /= g
      const sym = monoStr({ qn: cn, qd: cd, pi: 2 * ma.pi, rad: r0.exact.rad })
      if (sym && sym.length <= 20) { this.tLines = ['面积 = ' + sym, '≈ ' + dec]; return }
    }
    if (!r.exact) { this.tLines = ['面积 ≈ ' + dec]; return }
    const e = r.exact
    if (e.rad === 1) {
      if (e.cd === 1) this.tLines = ['面积 = ' + e.cn]
      else this.tLines = ['面积 = ' + e.cn + '/' + e.cd, '≈ ' + dec]
      return
    }
    const rs = (e.cn === 1 ? '' : e.cn) + '√' + e.rad + (e.cd === 1 ? '' : '/' + e.cd)
    if (rs.length > 20) { this.tLines = ['面积 ≈ ' + dec]; return }
    this.tLines = ['面积 = ' + rs, '≈ ' + dec]
  },
  triPad(v) {
    this.buzz()
    const props = { a: 'ta', b: 'tb', c: 'tc' }
    const prop = props[this.tField]
    const r = editCoeff(this[prop], v)
    if (r === 'NEXT') {
      const order = ['a', 'b', 'c']
      this.tField = order[(order.indexOf(this.tField) + 1) % 3]
      return
    }
    this[prop] = r
    this.triSolve()
  },

  circSolve() {
    this.cFvPx = fvPxOf([this.cr], true)
    const v = parseCoeff(this.cr)
    if (isNaN(v)) { this.cLines = ['把半径填好就能算']; return }
    if (v <= 0) { this.cLines = ['半径要大于 0']; return }
    const C = 2 * Math.PI * v, Av = Math.PI * v * v
    // 2026-11-15 第十六轮复审：周长、面积分别判——r = 1e200 时周长有限、
    // 面积溢出，旧版一损俱损把周长也藏了；面积下溢成 0（r < 约 1e-162，
    // 真值小于双精度最小数）时按对数拼课本式 ×10 串，不冒充 0。
    if (!isFinite(C)) { this.cLines = ['数字太大，超出精确计算范围']; return }
    if (!isFinite(Av)) { this.cLines = ['周长 ≈ ' + FD(C), '面积太大了，超出精确计算范围']; return }
    if (Av === 0) {
      const la = Math.log(Math.PI) / Math.LN10 + 2 * (Math.log(v) / Math.LN10)
      const ex = Math.floor(la)
      const mt = parseFloat(Math.pow(10, la - ex).toPrecision(12))
      const sup = (ex < 0 ? '⁻' : '') + String(Math.abs(ex)).split('').map(function (ch) { return '⁰¹²³⁴⁵⁶⁷⁸⁹'[Number(ch)] }).join('')
      this.cLines = ['周长 ≈ ' + FD(C), '面积 ≈ ' + mt + '×10' + sup]
      return
    }
    const m = parseMono(this.cr)
    if (m && m.qn > 0) {
      const cm = monoMul(m, { qn: 2, qd: 1, pi: 1, rad: 1 })
      const am = monoMul(monoMul(m, m), { qn: 1, qd: 1, pi: 1, rad: 1 })
      const cs = cm ? monoStr(cm) : null, as = am ? monoStr(am) : null
      if (cs && as && cs.length <= 20 && as.length <= 20) {
        this.cLines = ['周长 = ' + cs, '≈ ' + FD(C), '面积 = ' + as, '≈ ' + FD(Av)]
        return
      }
    }
    this.cLines = ['周长 ≈ ' + FD(C), '面积 ≈ ' + FD(Av)]
  },
  circPad(v) {
    this.buzz()
    const r = editCoeff(this.cr, v)
    if (r === 'NEXT') return
    this.cr = r
    this.circSolve()
  },

  backFromPlot() { this.buzz(); this.view = this.plotBack },
  openPlot(kind) {
    this.buzz()
    if (this.gatePaid('plot:' + kind)) return
    if (kind === 'quad') {
      const a = parseCoeff0(this.qa), b = parseCoeff0(this.qb), c = parseCoeff0(this.qc)
      if (isNaN(a) || isNaN(b) || isNaN(c) || a === 0) return
      // 2026-11-15 第十六轮复审：交点改走 solveQuad 的归一化稳定路径——
      // 旧版在这里直算 disc = b²−4ac，a = 1e200 时溢出成 Infinity、交点
      // 显示「溢出、溢出」（方程页本身是对的）。顶点 y 用归一化系数算
      // 后乘回（与缩放无关地还原），防 a·xv² 中间溢出。
      const r = calc.solveQuad(a, b, c)
      if (r.error) return
      const xv = -b / (2 * a)
      const mm = Math.max(Math.abs(a), Math.abs(b), Math.abs(c))
      const yv = mm * ((a / mm) * xv * xv + (b / mm) * xv + (c / mm))
      const keyPts = [{ x: xv, y: yv }]
      if (r.type === 'two') { keyPts.push({ x: r.x1, y: 0 }); keyPts.push({ x: r.x2, y: 0 }) }
      else if (r.type === 'one') keyPts.push({ x: r.x, y: 0 })
      const lines = [vertexLine(xv, yv), a > 0 ? '开口向上' : '开口向下']
      if (r.type === 'two') {
        // 2026-11-15 自查 F1：交点行按 x1<x2 升序传根，与二次方程页一致
        //（quadRadStrs 按值配对根式，传升序后配对自动正确）。
        lines.push(rootsLine(r.x1, r.x2, quadRadStrs(a, b, c, r.x1, r.x2)))
      }
      else if (r.type === 'one') lines.push('与 x 轴相切（一个交点）')
      else lines.push('与 x 轴没有交点')
      this.buildPlot({
        f: function (x) { return a * x * x + b * x + c },
        x0: xv - 6, x1: xv + 6,
        title: 'y = ' + TERM(a, 'x²', true) + TERM(b, 'x', false) + TERM(c, '', false),
        keyPts: keyPts, lines: lines, back: 'quad'
      })
    } else {
      const A = parseCoeff0(this.la) - parseCoeff0(this.lc)
      const B = parseCoeff0(this.lb) - parseCoeff0(this.ld)
      if (isNaN(A) || isNaN(B) || A === 0) return
      const root = -B / A
      this.buildPlot({
        f: function (x) { return A * x + B },
        x0: -8, x1: 8,
        title: 'y = ' + TERM(A, 'x', true) + TERM(B, '', false),
        keyPts: [{ x: root, y: 0 }, { x: 0, y: B }],
        lines: [linRootLine(root), '与 y 轴交点 (0, ' + pvStr(B, 13) + ')'],
        back: 'lin'
      })
    }
  },
  buildPlot(cfg) {
    const probeFlat = (x0, x1) => {
      let mn = Infinity, mx = -Infinity, n = 0
      for (let i = 0; i <= 30; i++) {
        let y
        try { y = cfg.f(x0 + (x1 - x0) * i / 30) } catch (e) { continue }
        if (typeof y !== 'number' || !isFinite(y)) continue
        if (y < mn) mn = y
        if (y > mx) mx = y
        n++
      }
      if (n < 2) return false
      return (mx - mn) <= 8 * Number.EPSILON * Math.max(Math.abs(mn), Math.abs(mx), 1)
    }
    if (probeFlat(cfg.x0, cfg.x1)) {
      const cMid = (cfg.x0 + cfg.x1) / 2
      let half = (cfg.x1 - cfg.x0) / 2
      for (let k = 0; k < 6; k++) {
        half *= 8
        if (!probeFlat(cMid - half, cMid + half)) { cfg = Object.assign({}, cfg, { x0: cMid - half, x1: cMid + half }); break }
      }
    }
    const N = 90
    let ymin = Infinity, ymax = -Infinity
    const raw = []
    for (let i = 0; i <= N; i++) {
      const x = cfg.x0 + (cfg.x1 - cfg.x0) * i / N
      let y
      try { y = cfg.f(x) } catch (e) { y = NaN }
      if (typeof y !== 'number' || isNaN(y) || !isFinite(y)) continue
      raw.push({ x: x, y: y })
    }
    const mags = raw.map(function (pt) { return Math.abs(pt.y) }).sort(function (p, q) { return p - q })
    const med = mags.length ? mags[Math.floor(mags.length / 2)] : 0
    const cap = Math.max(1e6, 200 * med)
    const overCap = raw.map(function (pt) { return Math.abs(pt.y) > cap })
    const exempt = []
    for (let i = 0; i < raw.length; i++) exempt.push(false)
    {
      let i = 0
      while (i < raw.length) {
        if (!overCap[i]) { i++; continue }
        let j = i
        while (j + 1 < raw.length && overCap[j + 1]) j++
        if (i === 0 || j === raw.length - 1) {
          let inc = true, dec = true
          for (let k = i + 1; k <= j; k++) {
            const d = Math.abs(raw[k].y) - Math.abs(raw[k - 1].y)
            if (d > 0) dec = false
            if (d < 0) inc = false
          }
          if (inc || dec) for (let k = i; k <= j; k++) exempt[k] = true
        }
        i = j + 1
      }
    }
    const pts = []
    for (let i2 = 0; i2 < raw.length; i2++) {
      const pt = raw[i2]
      if (overCap[i2] && !exempt[i2]) continue
      pts.push(pt)
      if (pt.y < ymin) ymin = pt.y
      if (pt.y > ymax) ymax = pt.y
    }
    if (pts.length < 2) return false
    const spanY0 = ymax - ymin
    if (ymin > 0 && ymin <= spanY0 * 4) ymin = 0
    if (ymax < 0 && -ymax <= spanY0 * 4) ymax = 0
    for (const kp of (cfg.keyPts || [])) {
      if (kp.x >= cfg.x0 && kp.x <= cfg.x1 && isFinite(kp.y)) {
        if (kp.y < ymin) ymin = kp.y
        if (kp.y > ymax) ymax = kp.y
      }
    }
    const padY = (ymax - ymin) * 0.08 + 0.001
    ymin -= padY; ymax += padY
    const W = 312, H = 296
    const x0 = cfg.x0, x1 = cfg.x1
    const px = function (x) { return Math.round(10 + (x - x0) / (x1 - x0) * (W - 20)) }
    const py = function (y) { return Math.round(8 + (ymax - y) / (ymax - ymin) * (H - 16)) }
    this.plotPts = pts.map(function (pt) { return { l: px(pt.x) - 2, t: py(pt.y) - 2 } })
    this.plotKeyPts = (cfg.keyPts || []).filter(function (pt) {
      return pt.x >= x0 && pt.x <= x1 && pt.y >= ymin && pt.y <= ymax
    }).map(function (pt) { return { l: px(pt.x) - 4, t: py(pt.y) - 4 } })
    this.plotAxisL = (0 >= x0 && 0 <= x1) ? px(0) : -10
    this.plotAxisT = (0 >= ymin && 0 <= ymax) ? py(0) : -10
    const baseT = this.plotAxisT >= 0 ? this.plotAxisT : H - 10
    const baseL = this.plotAxisL >= 0 ? this.plotAxisL : 10
    const labDup = function (labs) {
      for (let i2 = 1; i2 < labs.length; i2++) if (labs[i2].lab === labs[i2 - 1].lab) return true
      return false
    }
    const labW = function (lab, base) { return lab.length <= 4 ? base : lab.length * 6 + 8 }
    let stepX = niceStep(x1 - x0, 8)
    let stepY = niceStep(ymax - ymin, 8)
    let tX = [], tY = [], lX = [], lY = []
    for (let iter = 0; iter < 60; iter++) {
      tX = []; lX = []
      let prevKX = null, guardX = 0
      for (let k = Math.ceil(x0 / stepX); k <= Math.floor(x1 / stepX); k++) {
        if (k === prevKX || ++guardX > 1000) break
        prevKX = k
        const v = Math.round(k * stepX * 1e10) / 1e10
        if (v === 0) continue
        const cx = px(v)
        tX.push({ ml: cx, mt: baseT - 3 })
        if (cx >= 14 && cx <= 298) {
          const labX = fmtTick(v, stepX), lwX = labW(labX, 24)
          let llX = cx - lwX / 2
          if (llX < 0) llX = 0
          if (llX > W - lwX) llX = W - lwX
          lX.push({ lab: labX, ll: llX, lt: baseT <= H - 24 ? baseT + 4 : baseT - 15, ta: 'center', lw: lwX })
        }
      }
      if (!labDup(lX) || lX.length <= 2) break
      stepX *= 2
    }
    if (labDup(lX)) lX = [lX[Math.floor(lX.length / 2)]]
    for (let iter = 0; iter < 60; iter++) {
      tY = []; lY = []
      let prevKY = null, guardY = 0
      for (let k = Math.ceil(ymin / stepY); k <= Math.floor(ymax / stepY); k++) {
        if (k === prevKY || ++guardY > 1000) break
        prevKY = k
        const v = Math.round(k * stepY * 1e10) / 1e10
        if (v === 0) continue
        const cy = py(v)
        tY.push({ ml: baseL - 3, mt: cy })
        if (cy >= 6 && cy <= 282) {
          const labY = fmtTick(v, stepY), lwY = labW(labY, 26)
          if (baseL >= 36) {
            let llY = baseL - 5 - lwY, wY = lwY
            if (llY < 0) { llY = 0; wY = baseL - 5 }
            lY.push({ lab: labY, ll: llY, lt: cy - 6, ta: 'right', lw: wY })
          } else lY.push({ lab: labY, ll: baseL + 5, lt: cy - 6, ta: 'left', lw: lwY })
        }
      }
      if (!labDup(lY) || lY.length <= 2) break
      stepY *= 2
    }
    if (labDup(lY)) lY = [lY[Math.floor(lY.length / 2)]] // 同 X 轴兜底（1.5.19）
    if (this.plotAxisL >= 0 && this.plotAxisT >= 0) lX.push({ lab: '0', ll: this.plotAxisL + 4, lt: this.plotAxisT + 4, ta: 'left', lw: labW('0', 24) })
    const labOccX = function (t) {
      const tw = Math.min(t.lw, t.lab.length * 6)
      if (t.ta === 'left') return [t.ll, t.ll + tw]
      if (t.ta === 'right') return [t.ll + t.lw - tw, t.ll + t.lw]
      return [t.ll + (t.lw - tw) / 2, t.ll + (t.lw + tw) / 2]
    }
    const sweepLabs = function (labs, occ) {
      const order = labs.map(function (t, i) { return i }).sort(function (p, q) {
        const d = occ(labs[p])[0] - occ(labs[q])[0]
        return d !== 0 ? d : p - q
      })
      const kept = {}
      let lastEnd = -Infinity
      for (const i of order) {
        const o = occ(labs[i])
        if (o[0] < lastEnd + 2) continue
        kept[i] = true
        lastEnd = o[1]
      }
      return labs.filter(function (t, i) { return kept[i] })
    }
    const labOccY = function (t) { return [t.lt, t.lt + 12] }
    lX = sweepLabs(lX, labOccX)
    lY = sweepLabs(lY, labOccY)
    this.plotTickX = tX
    this.plotTickY = tY
    this.plotLabX = lX
    this.plotLabY = lY
    this.plotTitle = cfg.title
    this.plotLines = cfg.lines
    this.plotBack = cfg.back
    this.view = 'plot'
    return true
  },

  plotTypeDef() {
    for (const t of PLOT_TYPES) if (t.id === this.plotType) return t
    return PLOT_TYPES[0]
  },
  syncPlotFields() {
    this.pFvPx = fvPxOf([this.plotVals.k, this.plotVals.b, this.plotVals.a, this.plotVals.c, this.plotVals.A], true)
    const def = this.plotTypeDef()
    this.plotFormula = def.formula
    const vals = this.plotVals
    this.plotFieldDefs = def.fields.map(function (f) {
      return { key: f.key, label: f.label, val: vals[f.key] }
    })
    let has = false
    for (const f of def.fields) if (f.key === this.plotField) has = true
    if (!has) this.plotField = def.fields[0].key
  },
  setPlotType(id) {
    this.buzz()
    this.plotType = id
    if ((id === 'exp' || id === 'log') && parseCoeff(this.plotVals.a) === 1) this.plotVals.a = '2'
    this.plotCfgLines = ['填好系数，点「画图象」']
    this.syncPlotFields()
  },
  setPlotField(k) { this.buzz(); this.plotField = k },
  plotPad(v) {
    this.buzz()
    const r = editCoeff(this.plotVals[this.plotField], v)
    if (r === 'NEXT') {
      const defs = this.plotTypeDef().fields
      let idx = 0
      for (let i = 0; i < defs.length; i++) if (defs[i].key === this.plotField) idx = i
      this.plotField = defs[(idx + 1) % defs.length].key
      return
    }
    this.plotVals[this.plotField] = r
    this.syncPlotFields()
  },
  drawPlot() {
    this.buzz()
    if (this.gatePaid('plotcfg')) return
    const V = {}
    const def = this.plotTypeDef()
    for (const f of def.fields) {
      const v = parseCoeff0(this.plotVals[f.key])
      if (isNaN(v)) { this.plotCfgLines = ['先把系数填完整']; return }
      V[f.key] = v
    }
    const R = autoRange(this.plotType, V)
    const bad = function (msg) { this.plotCfgLines = [msg] }
    let cfg = null
    if (this.plotType === 'quad2') {
      if (V.a === 0) { bad.call(this, 'a = 0 就不是二次函数了'); return }
      const a = V.a, b = V.b, c = V.c
      const xv = -b / (2 * a), yv = a * xv * xv + b * xv + c
      const disc = b * b - 4 * a * c
      const keyPts = [{ x: xv, y: yv }, { x: 0, y: c }]
      if (disc >= 0) {
        const sq = Math.sqrt(disc)
        keyPts.push({ x: (-b + sq) / (2 * a), y: 0 })
        if (disc > 0) keyPts.push({ x: (-b - sq) / (2 * a), y: 0 })
      }
      const lines = [vertexLine(xv, yv), a > 0 ? '开口向上' : '开口向下', '与 y 轴交点 (0, ' + pvStr(c, 13) + ')']
      cfg = { f: function (x) { return a * x * x + b * x + c }, x0: xv - R, x1: xv + R, title: 'y = ' + TERM(a, 'x²', true) + TERM(b, 'x', false) + TERM(c, '', false), keyPts: keyPts, lines: lines, back: 'plotcfg' }
    } else if (this.plotType === 'lin2') {
      const k = V.k, b = V.b
      const keyPts = [{ x: 0, y: b }]
      const lines = ['与 y 轴交点 (0, ' + pvStr(b, 13) + ')']
      if (k !== 0) {
        keyPts.push({ x: -b / k, y: 0 })
        lines.push('与 x 轴交点 (' + pvStr(-b / k, 14) + ', 0)')
        lines.push(k > 0 ? '从左到右上升' : '从左到右下降')
      } else lines.push('k = 0：水平线')
      cfg = { f: function (x) { return k * x + b }, x0: -R, x1: R, title: 'y = ' + TERM(k, 'x', true) + TERM(b, '', false), keyPts: keyPts, lines: lines, back: 'plotcfg' }
    } else if (this.plotType === 'inv') {
      const k = V.k
      if (k === 0) { bad.call(this, 'k 不能为 0'); return }
      cfg = {
        f: function (x) { return Math.abs(x) < R / 45 ? NaN : k / x },
        x0: -R, x1: R, title: 'y = ' + DP(k) + ' / x',
        keyPts: [],
        lines: ['双曲线，关于原点对称', k > 0 ? '图象在一、三象限' : '图象在二、四象限', '永远不碰到两条坐标轴'],
        back: 'plotcfg'
      }
    } else if (this.plotType === 'sin' || this.plotType === 'cos') {
      const A = V.A
      const isSin = this.plotType === 'sin'
      const f = isSin
        ? function (x) { return A * Math.sin(x * Math.PI / 180) }
        : function (x) { return A * Math.cos(x * Math.PI / 180) }
      const keyPts = isSin
        ? [{ x: 90, y: A }, { x: 270, y: -A }, { x: 0, y: 0 }]
        : [{ x: 0, y: A }, { x: 180, y: -A }, { x: 360, y: A }]
      cfg = {
        f: f, x0: -360, x1: 360,
        title: 'y = ' + TERM(A, '', true) + (isSin ? '·sin x' : '·cos x'),
        keyPts: keyPts,
        lines: trigInfoLines(A),
        back: 'plotcfg'
      }
    } else if (this.plotType === 'exp') {
      const a = V.a
      if (a <= 0 || a === 1) { bad.call(this, '底数要大于 0 且不等于 1'); return }
      cfg = {
        f: function (x) { return Math.pow(a, x) },
        x0: -R, x1: R, title: 'y = ' + DP(a) + 'ˣ',
        keyPts: [{ x: 0, y: 1 }],
        lines: ['恒过点 (0, 1)', a > 1 ? '越往右涨得越快' : '越往右越贴近 x 轴', '图象全在 x 轴上方'],
        back: 'plotcfg'
      }
    } else if (this.plotType === 'log') {
      const a = V.a
      if (a <= 0 || a === 1) { bad.call(this, '底数要大于 0 且不等于 1'); return }
      const keyPts = [{ x: 1, y: 0 }]
      if (a <= 10) keyPts.push({ x: a, y: 1 })
      cfg = {
        f: function (x) { return Math.log(x) / Math.log(a) },
        x0: 0, x1: 10, title: 'y = log' + DP(a) + ' x',
        keyPts: keyPts,
        lines: ['恒过点 (1, 0)', '只画 x > 0 的部分', a > 1 ? '越往右涨得越慢' : '越往右降得越慢'],
        back: 'plotcfg'
      }
    } else if (this.plotType === 'abs') {
      const a = V.a
      if (a === 0) { bad.call(this, 'a = 0 时只剩一条平线，换个 a 试试'); return }
      cfg = {
        f: function (x) { return a * Math.abs(x) },
        x0: -R, x1: R, title: 'y = ' + TERM(a, '', true) + '·|x|',
        keyPts: [{ x: 0, y: 0 }],
        lines: ['顶点 (0, 0)', '关于 y 轴对称（左右镜像）', a >= 0 ? '开口向上（V 形）' : '开口向下（Λ 形）'],
        back: 'plotcfg'
      }
    }
    if (cfg && !this.buildPlot(cfg)) this.plotCfgLines = ['暂时画不出来，换个系数试试']
  }
}
</script>

<style>
.page { width: 336px; height: 480px; background-color: #EDF0F4; flex-direction: column; }
.view { width: 336px; height: 480px; flex-direction: column; }

/* 顶栏 */
.topbar { width: 336px; height: 46px; flex-direction: row; align-items: center; padding-left: 14px; padding-right: 10px; }
.top-title { font-size: 21px; font-weight: bold; color: #232A33; flex-grow: 1; }
.top-btn { height: 34px; border-radius: 17px; background-color: #FFFFFF; border: 1px solid #D8DEE7; padding-left: 12px; padding-right: 12px; margin-left: 8px; align-items: center; justify-content: center; }
.top-btn-t { font-size: 15px; color: #5F7E99; }
.bar { width: 336px; height: 52px; flex-direction: row; align-items: center; padding-left: 10px; padding-right: 10px; position: relative; }
.bbtn { height: 44px; border-radius: 22px; background-color: #FFFFFF; border: 1px solid #D8DEE7; padding-left: 16px; padding-right: 16px; align-items: center; justify-content: center; }
.bar-sp { flex-grow: 1; height: 1px; }
.bbtn-ghost { height: 44px; padding-left: 16px; padding-right: 16px; align-items: center; justify-content: center; }
.bar-btn { font-size: 17px; color: #5F7E99; }
.bar-btn-del { color: #C05B4D; }
.bar-title { position: absolute; left: 100px; top: 14px; width: 136px; font-size: 19px; font-weight: bold; color: #232A33; text-align: center; }

/* 计算器显示区 */
.disp { width: 336px; height: 126px; padding-left: 16px; padding-right: 16px; padding-top: 2px; flex-direction: column; position: relative; }
.expr { position: absolute; left: 16px; top: 4px; width: 304px; height: 48px; color: #232A33; text-align: right; lines: 1; }
.res-row { position: absolute; left: 16px; top: 54px; width: 304px; height: 72px; flex-direction: row; align-items: center; }
.res { flex-grow: 1; text-align: right; font-weight: bold; lines: 1; }
.frac-chip { height: 28px; border-radius: 14px; background-color: #E3E9F1; padding-left: 10px; padding-right: 10px; margin-left: 8px; align-items: center; justify-content: center; }
.frac-chip-t { font-size: 14px; color: #5F7E99; }

/* 键盘（1.2.3：按键等比缩小，空间让给显示区） */
.pad { width: 336px; flex-direction: row; flex-wrap: wrap; justify-content: center; padding-left: 5px; padding-top: 2px; }
.key { width: 56px; height: 52px; border-radius: 16px; margin: 3px; align-items: center; justify-content: center; background-color: #FFFFFF; border: 1px solid #D8DEE7; }
.key-num { background-color: #FFFFFF; }
.key-fn { background-color: #E9EEF4; }
.key-fnr { background-color: #F9ECE8; }
.key-op { background-color: #E3E9F1; }
.key-eq { background-color: #7A93AC; border-color: #7A93AC; }
.key-t { color: #232A33; font-weight: bold; }
.key-t-num { color: #232A33; }
.key-t-fn { color: #5A6B80; }
.key-t-fnr { color: #C05B4D; }
.key-t-op { color: #5F7E99; }
.key-t-eq { color: #FFFFFF; }
.pad-sm { padding-left: 6px; }
.key-sm { width: 74px; height: 42px; border-radius: 14px; }
.key-c5 { width: 58px; }
.key-c5w { width: 122px; }
.eqkey { width: 74px; height: 36px; border-radius: 12px; }
.eqkey-c5 { width: 58px; }
.eqkey-s { height: 28px; }
.eqgo { background-color: #7A93AC; border-color: #7A93AC; }
.eqgo-t { color: #FFFFFF; font-weight: bold; }
.eq-card { margin-top: 10px; }
.eq-card-s { height: 46px; margin-top: 4px; }
